<h2>Images</h2>

<#assign imageList = images?eval>

<table class="img-table" border="1">
    <tr>
    <#list imageList as result>

        <td>
            <#if result.values['file.url']?has_content>
                <img src="${result.values['file.url']}" 
                     alt="${result.values['file.name']}" />
            </#if>
        </td>

        <#-- Add new row every 3 images -->
        <#if (result?index + 1) % 3 == 0>
            </tr><tr>
        </#if>

    </#list>
    </tr>
</table>
