<tr style="height: 60px;">
  <!-- Task cell spans two rows -->
  <th rowspan="2" style="text-align: center; vertical-align: middle; font-weight: bold; border: 0.5px solid #000; font-size: 10px; padding: 10px;">
    Task
  </th>
  <th colspan="${sub_assets.data?size}" style="text-align: center; vertical-align: middle; font-weight: bold; border: 0.5px solid #000; font-size: 10px; padding: 10px;">
    Complete (Y / N)
  </th>
</tr>
<tr>
  <#list sub_assets.data as fixeddata>
    <th style="text-align: center; border: 0.5px solid #000; font-size: 10px;">
      <b>${fixeddata.name}</b>
    </th>
  </#list>
</tr>
