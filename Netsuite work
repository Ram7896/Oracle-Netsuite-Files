/**
 * @NApiVersion 2.1
 * @NScriptType UserEventScript
 */

define([], () => {

    const beforeSubmit = (context) => {

        try {

            // Execute only on EDIT
            if (context.type !== context.UserEventType.EDIT) {
                return;
            }

            const newRecord = context.newRecord;
            const oldRecord = context.oldRecord;

            // Approval checkbox field
            const APPROVED_FIELD = 'custrecord_bank_approved';

            // Old approved value
            const oldApproved = oldRecord.getValue({
                fieldId: APPROVED_FIELD
            });

            // If record was already approved
            if (oldApproved === true) {

                // Reset approval checkbox
                newRecord.setValue({
                    fieldId: APPROVED_FIELD,
                    value: false
                });

            }

        } catch (e) {

            log.error({
                title: 'Error resetting approval checkbox',
                details: e
            });

        }
    };

    return {
        beforeSubmit
    };

});
