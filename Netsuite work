/**
 * @NApiVersion 2.1
 * @NScriptType ScheduledScript
 */
define(['N/search', 'N/email', 'N/format'], function(search, email, format) {

    function execute(context) {
        const today = new Date();
        const todayStr = format.format({ value: today, type: format.Type.DATE });

        const employeeSearch = search.create({
            type: search.Type.EMPLOYEE,
            filters: [
                ['isinactive', 'is', 'F'],
                'AND',
                ['email', 'isnotempty', 'T']
            ],
            columns: [
                'entityid',
                'email',
                'custentity_license_expiry',
                'custentity_passport_expiry',
                'custentity_aadhaar_expiry'
            ]
        });

        employeeSearch.run().each(function(result) {
            const name = result.getValue('entityid');
            const emailAddress = result.getValue('email');

            const licenseExpiry = result.getValue('custentity_license_expiry');
            const passportExpiry = result.getValue('custentity_passport_expiry');
            const aadhaarExpiry = result.getValue('custentity_aadhaar_expiry');

            // Send separate emails for each document expiring today
            if (licenseExpiry === todayStr) {
                sendEmail(emailAddress, name, 'License');
            }

            if (passportExpiry === todayStr) {
                sendEmail(emailAddress, name, 'Passport');
            }

            if (aadhaarExpiry === todayStr) {
                sendEmail(emailAddress, name, 'Aadhaar');
            }

            return true;
        });

        // Helper function to send individual emails
        function sendEmail(emailAddress, name, documentName) {
            const subject = `Reminder: Your ${documentName} is Expiring Today`;
            const body = `Hi ${name},<br/><br/>This is a reminder that your <strong>${documentName}</strong> is expiring today.<br/>Please take immediate action to renew or update your ${documentName}.<br/><br/>Thanks,<br/>NetSuite Admin`;
            
            email.send({
                author: -5, // Default admin
                recipients: emailAddress,
                subject: subject,
                body: body
            });
        }
    }

    return { execute };
});
