/**
 * @NApiVersion 2.0
 * @NScriptType ClientScript
 * @NModuleScope SameAccount
 * 
 * Antonio Sepulveda
 * Description: Phase 3 enhancement Subsidiary Cost center combination validation. 
 *              Validates that the cost center used is valid for the subsidiary selected on the transaction.
 *              This will only valid Purchase Orders, Customer Invoices and all types of Journal Entries.
 *              
 */
define(['N/currentRecord', 'N/search'],
	/**
	 * @param {record} record
	 * @param {search} search
	 */
	function (currentRecord, search) {

		/**
		 * Validation function to be executed when sublist line is committed.
		 *
		 * @param {Object} context
		 * @param {Record} context.currentRecord - Current form record
		 * @param {string} context.sublistId - Sublist name
		 *
		 * @returns {boolean} Return true if sublist line is valid
		 *
		 * @since 2015.2
		 * 
		 */
		function validateLine(context) {
			//Declare Variables
			var nsRecord = context.currentRecord;
			var toSubsidiary;
			var lineCostCenter;
			var resultsSearch;
			var headerSearchResult;
			var nsSublist;
			var cnSublist = context.sublistId;
			debugger;
			//log.debug('sub',context.sublistId);

			/* commented out and replaced code block on 4/16/2020  because it is returning true even when the sublist is item 
			var nsSublist = context.sublistId;
			
			
			if(nsSublist != "item" ||  nsSublist != "line"){
				return true;
			}*/

			/*************New Code Start 4/16/2020************/
			if (nsRecord.type == 'purchaseorder' || nsRecord.type == 'invoice') {
				nsSublist = nsRecord.getSublist({
					sublistId: 'item'
				});
			}
			else {
				nsSublist = nsRecord.getSublist({
					sublistId: 'line'
				});
			}
			//if the sublist that was change is not the item or list do not run validation
			if (cnSublist !== nsSublist.id) {
				return true;
			}
			/******************New Code End AS****************************************/
			//Retrieve record type for proper parameters
			if (nsRecord.type == 'purchaseorder') {
				toSubsidiary = nsRecord.getCurrentSublistValue({
					sublistId: 'item',
					fieldId: 'custcol_to_subsidiary'
				});

			}


			var adaSubsidiary = nsRecord.getValue({ fieldId: 'subsidiary' });

			if (nsRecord.type == 'journalentry' || nsRecord.type == 'intercompanyjournalentry' || nsRecord.type == 'advintercompanyjournalentry') {
				//new code start 3/16/2020 AS
				var nsMemo = nsRecord.getValue({ fieldId: "memo" });
				var testRegex = /kickout/i;
				var findKickout = testRegex.test(nsMemo);
				if (findKickout) {
					//log.debug('kickout',findKickout);
					return true;
				}
				//new code end 3/16/2020 AS
				lineCostCenter = nsRecord.getCurrentSublistValue({
					sublistId: 'line',
					fieldId: 'department'
				});

			}
			else {
				lineCostCenter = nsRecord.getCurrentSublistValue({
					sublistId: 'item',
					fieldId: 'department'
				});
			}

			if (nsRecord.type == 'intercompanyjournalentry' || nsRecord.type == 'advintercompanyjournalentry') {
				adaSubsidiary = nsRecord.getCurrentSublistValue({
					sublistId: 'line',
					fieldId: 'linesubsidiary'
				});
			}
			var headerCostCenter = nsRecord.getValue({ fieldId: 'department' });

			//log.debug('headerCC',headerCostCenter);
			//log.debug('adaSubsidary',adaSubsidiary);
			//log.debug('toSubsidary',toSubsidiary);
			//log.debug('lineCostCenter',lineCostCenter);
			//New Code added 4/24/2020
			if (!lineCostCenter || !adaSubsidiary) {
				return true;
			}
			//New code end 4/24/2020 AS
			debugger;//<--used to debug client script on the browser console 
			if (toSubsidiary) {
				resultsSearch = runSubCombSearch(toSubsidiary, lineCostCenter);
				headerSearchResult = runSubCombSearch(adaSubsidiary, headerCostCenter);

			}
			else if (headerCostCenter) {

				resultsSearch = runSubCombSearch(adaSubsidiary, lineCostCenter);
				headerSearchResult = runSubCombSearch(adaSubsidiary, headerCostCenter);

			} else {
				// log.debug('lastelse','emptySuborcc')
				resultsSearch = runSubCombSearch(adaSubsidiary, lineCostCenter);
			}
			//Display pop-up error to user  

			if (headerSearchResult != undefined && headerSearchResult.length == 0) {
				alert('Invalid header level Cost Center for subsidiary');

				return false;

			} else if (resultsSearch.length == 0) {
				alert('Invalid line level Cost Center for subsidiary');
				return false;
			}
			else {
				return true;
			}
		}
		/**
		 * saveRecord - runs on save record
		 * @param {nlobjContext} context - runtime context object
		 * function prevents users from using the make a copy function from using invalid cost centers or inactivated cost centers
		 * for the subsidiary selected.
		 */
		function saveRecord(context) {
			var nsRecord = context.currentRecord;
			var lineCostCenter;
			var resultsSearch;
			var lineCount;
			var recType = nsRecord.type;
			var toSubsidiary;
			var headerSearchResult;
			var lineErrCount = 0;
			var headErrCount = 0;
			var linErrNum;

			/**** new code start 4/15/2020 AS *******
			log.debug('isAdj',nsRecord.getValue({fieldId: 'intercoadj'}));
			//If the Journal is an Intercompany Adjustment do not validate 
			if(nsRecord.getValue({fieldId: 'intercoadj'})==='T'){
				return true;
			}
			********* New code end******/

			//build the search and return into array  	
			var comboSearch = buildComboSearch();//New code added 4/3/2020 AS 

			switch (recType) {
				case 'purchaseorder':
				case 'invoice':
					lineCount = nsRecord.getLineCount({
						sublistId: 'item'
					});
					break;
				case 'journalentry':
				case 'intercompanyjournalentry':
				case 'advintercompanyjournalentry':
					lineCount = nsRecord.getLineCount({
						sublistId: 'line'
					});
					break;
			}
			for (var i = 0; i < lineCount; i++) {
				if (nsRecord.type == 'purchaseorder') {
					toSubsidiary = nsRecord.getSublistValue({
						sublistId: 'item',
						fieldId: 'custcol_to_subsidiary',
						line: i
					});

				}


				var adaSubsidiary = nsRecord.getValue({ fieldId: 'subsidiary' });

				if (nsRecord.type == 'journalentry' || nsRecord.type == 'intercompanyjournalentry' || nsRecord.type == 'advintercompanyjournalentry') {
					//new code start 3/16/2020 AS
					var nsMemo = nsRecord.getValue({ fieldId: "memo" });
					var testRegex = /kickout/i;
					var findKickout = testRegex.test(nsMemo);
					if (findKickout) {
						log.debug('kickout', findKickout);
						break;
					}
					//new code end 3/16/2020 AS
					lineCostCenter = nsRecord.getSublistValue({
						sublistId: 'line',
						fieldId: 'department',
						line: i
					});

				}
				else {
					lineCostCenter = nsRecord.getSublistValue({
						sublistId: 'item',
						fieldId: 'department',
						line: i
					});
				}
				if (nsRecord.type == 'intercompanyjournalentry' || nsRecord.type == 'advintercompanyjournalentry') {
					adaSubsidiary = nsRecord.getSublistValue({
						sublistId: 'line',
						fieldId: 'linesubsidiary',
						line: i
					});
				}
				var headerCostCenter = nsRecord.getValue({ fieldId: 'department' });


				debugger;
				if (toSubsidiary) {
					resultsSearch = runSaveSubCombSearch(comboSearch, toSubsidiary, lineCostCenter);
					headerSearchResult = runSaveSubCombSearch(comboSearch, adaSubsidiary, headerCostCenter);

				}
				else if (headerCostCenter) {

					resultsSearch = runSaveSubCombSearch(comboSearch, adaSubsidiary, lineCostCenter);
					headerSearchResult = runSaveSubCombSearch(comboSearch, adaSubsidiary, headerCostCenter);

				} else {
					resultsSearch = runSaveSubCombSearch(comboSearch, adaSubsidiary, lineCostCenter);
				}
				//Display error to user 
				//log.debug('hearderResult',headerSearchResult.length);
				// log.debug('resultsSearch',resultsSearch);
				if (headerSearchResult < 0) {


					headErrCount++;

				} else if (resultsSearch < 0) {
					var jeName = nsRecord.getValue({ fieldId: 'memo' });
					alert("JE Name:" + jeName);
					var checkNumber = nsRecord.getValue({ fieldId: 'createdfrom' });
					var checkDetails = search.lookupFields({
						type: search.Type.CHECK,
						id: checkNumber,
						columns: ['memo']
					});
					var checkMemo = checkDetails.memo;
					alert("checkMemo:" + checkMemo);
					if (jeName === checkMemo) {
						alert("if entred"+lineErrCount);
						lineErrCount;

					}
					else {
						lineErrCount++;
						linErrNum = i;
						break;
					}
				}

			}

			if (headErrCount > 0) {
				alert('Invalid header level Cost Center for subsidiary');

				return false;
			} else if (lineErrCount > 0) {
				alert('Invalid line level Cost Center for subsidiary on line ' + linErrNum);

				return false;
			}
			else {
				return true;
			}

		}
		return {

			validateLine: validateLine,
			saveRecord: saveRecord
		};


		//function that searches the line level cost center with the subsidiary 
		function runSubCombSearch(adaSubsidiary, costCenter) {
			var subs = adaSubsidiary;
			var adaCC = costCenter;
			var subComboSearch = search.create({
				type: 'customrecord_ada_sub_costcenter_combos',
				columns: [{ name: 'custrecord_ada_subsidiary_combo' },
				{ name: 'custrecord_ada_costcenter_combo' }],
				filters: [['custrecord_ada_subsidiary_combo', 'is', subs], 'and', ['custrecord_ada_costcenter_combo', 'is', adaCC],
					'and', ['isinactive', 'is', 'F']]
			}).run().getRange(0, 1000);
			//log.debug('subComboSearch',subComboSearch);
			return subComboSearch;
		};
		/**
		 * Function definition to run the combo search
		 * 
		 * @param {string} adaSubsidiary - the subsidiary
		 * @param {string} costCenter - cost center to compare against 
		 * 
		 * added 4/2/2020 AS case 1206
		 * 
		 */
		function runSaveSubCombSearch(searchArray, adaSub, adaCC) {
			var adaArray = searchArray;
			var subCombo = adaSub + '-' + adaCC;
			//log.debug('subcombo',subCombo);
			var searchResult = adaArray.indexOf(subCombo);
			//log.debug('searchresult', searchResult);
			//returns a -1 if no valid combo is found 
			return searchResult;
		};

		/***
		 * 
		 * Function builds the array from the custom record 
		 * subsidiary cost center combo for quicker searching 
		 * of valid combos
		 * 
		 * 
		 * Added 4/3/2020 AS case 1206
		 */
		function buildComboSearch() {
			var subComboList = [];
			var pageSize = 1000;
			var start = 0;
			var results = [];

			var subComboSearch = search.create({
				type: 'customrecord_ada_sub_costcenter_combos',
				columns: [
					{ name: 'custrecord_ada_subsidiary_combo' },
					{ name: 'custrecord_ada_costcenter_combo' }
				],
				filters: [
					['isinactive', 'is', 'F']
				]
			});

			do {
				results = subComboSearch.run().getRange({ start: start, end: start + pageSize });

				for (var i = 0; i < results.length; i++) {
					var combo = results[i].getValue({ name: 'custrecord_ada_subsidiary_combo' }) + '-' +
						results[i].getValue({ name: 'custrecord_ada_costcenter_combo' });
					subComboList.push(combo);
				}

				start += pageSize;
			} while (results.length === pageSize);

			log.debug('Total combos retrieved:', subComboList.length);
			return subComboList;
		}

	});Notice (SuiteScript)
