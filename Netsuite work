/**
 * @NApiVersion 2.1
 * @NScriptType ClientScript
 */
define(['N/currentRecord', 'N/ui/dialog'], function (currentRecord, dialog) {

    const VENDOR_ID = 87625;
    const JOHNSTONE_FORM_ID = 166;

    const VALID_LOCATIONS = [2, 7];
    const VALID_SHIPMETHODS = [26920, 26921];

    function pageInit(context) {
        var rec = currentRecord.get();
        var vendor = rec.getValue('entity');

        if (parseInt(vendor) === VENDOR_ID) {
            disableCustomForm();
        }
    }

    function fieldChanged(context) {
        var rec = currentRecord.get();

        if (context.fieldId === 'entity') {

            var vendor = rec.getValue('entity');

            if (parseInt(vendor) === VENDOR_ID) {

                rec.setValue({
                    fieldId: 'customform',
                    value: JOHNSTONE_FORM_ID,
                    ignoreFieldChange: true
                });

                setTimeout(function () {
                    disableCustomForm();
                }, 1000);
            }
        }
    }

    function disableCustomForm() {

        setTimeout(function () {

            var field =
                document.getElementById('inpt_customform') ||
                document.getElementById('customform_fs_inp');

            if (field) {
                field.disabled = true;
                field.readOnly = true;
                field.style.pointerEvents = 'none';
                field.style.backgroundColor = '#f0f0f0';
            }

        }, 500);
    }

    function saveRecord(context) {

        var rec = currentRecord.get();

        var vendor = rec.getValue('entity');
        var location = rec.getValue('location');
        var shipmethod = rec.getValue('shipmethod');

        if (parseInt(vendor) === VENDOR_ID) {

            if (VALID_LOCATIONS.indexOf(parseInt(location)) === -1) {
                dialog.alert({
                    title: 'Invalid Location',
                    message: 'Location for JohnStone should be either 111 - RWD Mississauga or 107 - Ottawa Warehouse'
                });
                return false;
            }

            if (VALID_SHIPMETHODS.indexOf(parseInt(shipmethod)) === -1) {
                dialog.alert({
                    title: 'Invalid Shipping Method',
                    message: 'Shipping Method for JohnStone should be either 11 Corp Order or 18 EARLY Corp Order'
                });
                return false;
            }
        }

        return true;
    }

    return {
        pageInit: pageInit,
        fieldChanged: fieldChanged,
        saveRecord: saveRecord
    };
});
