/**
 * @NApiVersion 2.1
 * @NScriptType Suitelet
 */

define(['N/ui/serverWidget', 'N/https', 'N/runtime', 'N/log'], 
(serverWidget, https, runtime, log) => {

    const onRequest = (context) => {

        if (context.request.method === 'GET') {

            var form = serverWidget.createForm({
                title: 'SuiteScript 1.0 → 2.1 Converter'
            });

            var inputField = form.addField({
                id: 'custpage_ss10',
                type: serverWidget.FieldType.LONGTEXT,
                label: 'SuiteScript 1.0 Code'
            });
            log.debug("inputField",inputField)
            inputField.updateDisplaySize({
                height: 30,
                width: 60
            });

            var outputField = form.addField({
                id: 'custpage_ss21',
                type: serverWidget.FieldType.LONGTEXT,
                label: 'Converted SuiteScript 2.1'
            });
            log.debug("outputField",outputField)
            outputField.updateDisplaySize({
                height: 30,
                width: 60
            });

            form.addSubmitButton({
                label: 'Convert Script'
            });

            context.response.writePage(form);
        }


        if (context.request.method === 'POST') {

            var script10 = context.request.parameters.custpage_ss10 || '';
            log.debug("script10",script10)
            var convertedScript = convertScript(script10);
            log.debug("convertedScript",convertedScript)
            var form = serverWidget.createForm({
                title: 'SuiteScript 1.0 → 2.1 Converter'
            });

            var inputField = form.addField({
                id: 'custpage_ss10',
                type: serverWidget.FieldType.LONGTEXT,
                label: 'SuiteScript 1.0 Code'
            });
            log.debug("inputField".inputField)
            inputField.defaultValue = script10;

            inputField.updateDisplaySize({
                height: 30,
                width: 60
            });

            var outputField = form.addField({
                id: 'custpage_ss21',
                type: serverWidget.FieldType.LONGTEXT,
                label: 'Converted SuiteScript 2.1'
            });
            log.debug("outputField",outputField)
            outputField.defaultValue = convertedScript;

            outputField.updateDisplaySize({
                height: 30,
                width: 60
            });

            form.addSubmitButton({
                label: 'Convert Again'
            });

            context.response.writePage(form);
        }
    };


    function convertScript(script10) {

        try {

            var apiKey = runtime.getCurrentScript().getParameter({
                name: 'custscript_openai_key'
            });
            log.debug("apiKey",apiKey)
            if (!apiKey) {
                return "API Key missing. Please configure Script Parameter.";
            }

            var prompt = "Convert the following NetSuite SuiteScript 1.0 code to SuiteScript 2.1 with proper module mapping (N/record, N/search, N/log, etc). Only return the converted code.\n\n" + script10;

            var payload = {
                model: "gpt-4.1-mini",
                messages: [
                    {
                        role: "user",
                        content: prompt
                    }
                ]
            };

            var response = https.post({
                url: "https://api.openai.com/v1/chat/completions",
                headers: {
                    "Content-Type": "application/json",
                    "Authorization": "Bearer " + apiKey
                },
                body: JSON.stringify(payload)
            });

            log.debug("API RESPONSE", response.body);

            var result = JSON.parse(response.body);

            if (result.error) {
                return "OpenAI Error: " + result.error.message;
            }

            if (result.choices && result.choices.length > 0) {
                return result.choices[0].message.content;
            }

            return "Unexpected API Response: " + response.body;

        } catch (e) {

            log.error("Conversion Error", e);

            return "Conversion Failed: " + e.message;
        }
    }


    return { onRequest };

});
