		<#macro yearlySched due>
		
		  <#assign period=1>
		  <#assign proj_type=project.custentity_nx_project_type>
		  <#if proj_type?contains("2 Monthly")><#assign period=2></#if>
		  <#if proj_type?contains("3 Monthly")><#assign period=3></#if>
		  <#if proj_type?contains("4 Monthly")><#assign period=4></#if>
		  <#if proj_type?contains("6 Monthly")><#assign period=6></#if>
		  <#if proj_type?contains("- Monthly")><#assign period=1></#if>
		  <#if proj_type?contains("Annual")><#assign period=12></#if>
		  <#assign dueMonth=due?string.MM>
		  <#assign dueMonth=dueMonth?number>
		  <#assign MONTHS=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]>
		
		  <div style="font-size: 10pt;"><b>${due?string.YYYY} Program:</b>
		      <#list 1..12 as curr>
		        <#if ((curr-dueMonth)%period) == 0>
		          &nbsp;<#if curr==dueMonth><b style="text-decoration: underline;"></#if>${MONTHS[curr-1]}<#if curr==dueMonth></b></#if>
		        </#if>
		      </#list>
		  </div>
		
		</#macro>

