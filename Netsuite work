<?xml version="1.0"?><!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
	<link name="NotoSans" type="font" subtype="truetype" src="${nsfont.NotoSans_Regular}" src-bold="${nsfont.NotoSans_Bold}" src-italic="${nsfont.NotoSans_Italic}" src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />
	<#if .locale == "zh_CN">
		<link name="NotoSansCJKsc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKsc_Regular}" src-bold="${nsfont.NotoSansCJKsc_Bold}" bytes="2" />
	<#elseif .locale == "zh_TW">
		<link name="NotoSansCJKtc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKtc_Regular}" src-bold="${nsfont.NotoSansCJKtc_Bold}" bytes="2" />
	<#elseif .locale == "ja_JP">
		<link name="NotoSansCJKjp" type="font" subtype="opentype" src="${nsfont.NotoSansCJKjp_Regular}" src-bold="${nsfont.NotoSansCJKjp_Bold}" bytes="2" />
	<#elseif .locale == "ko_KR">
		<link name="NotoSansCJKkr" type="font" subtype="opentype" src="${nsfont.NotoSansCJKkr_Regular}" src-bold="${nsfont.NotoSansCJKkr_Bold}" bytes="2" />
	<#elseif .locale == "th_TH">
		<link name="NotoSansThai" type="font" subtype="opentype" src="${nsfont.NotoSansThai_Regular}" src-bold="${nsfont.NotoSansThai_Bold}" bytes="2" />
	</#if>
    <macrolist>
        <macro id="nlheader">
            
<table class="header" style="width: 100%;"><tr>
<td style="width: 60%;" align="left"><span style="font-size: 24pt;"><strong> Invoice</strong></span></td>
<td align="center"><#if companyInformation.logoUrl?length != 0> <@filecabinet nstype="image" style="float: left; margin: 7px;" src="${companyInformation.logoUrl}" /> </#if></td>
</tr></table>
<table class="header" style="width: 100%;"><tr><!-- Left Column for Company Information -->
<td style="width: 55.122%; vertical-align: top;">
<p><strong>${companyInformation.companyName}</strong><br />${companyInformation.mainaddress_text}</p>
</td>
<!-- Right Column for Account Info, Date, and Transaction ID -->
<td style="width: 44.9189%; vertical-align: top; text-align: right; padding-right: 30px;">
<table style="width: 106.791%; text-align: right;"><tr>
<td style="width: 100%;"><strong>${record.accountnumber@label?upper_case}:</strong> &nbsp;${record.accountnumber}</td>
</tr>
<tr>
<td class="label" style="width: 100%;"><strong>${record.trandate@label?upper_case}:</strong> &nbsp;${record.trandate}</td>
</tr>
<tr>
<td class="label" style="width: 100%;"><strong>${record.tranid@label?upper_case}:</strong> &nbsp;${record.tranid}</td>
</tr></table>
</td>
</tr></table>

        </macro>
        <macro id="nlfooter">
            
<table class="footer" style="width: 100%;"><tr>
<td align="right"><pagenumber/> of <totalpages/></td>
</tr></table>

        </macro>
    </macrolist>
    <style type="text/css">* {
		<#if .locale == "zh_CN">
			font-family: NotoSans, NotoSansCJKsc, sans-serif;
		<#elseif .locale == "zh_TW">
			font-family: NotoSans, NotoSansCJKtc, sans-serif;
		<#elseif .locale == "ja_JP">
			font-family: NotoSans, NotoSansCJKjp, sans-serif;
		<#elseif .locale == "ko_KR">
			font-family: NotoSans, NotoSansCJKkr, sans-serif;
		<#elseif .locale == "th_TH">
			font-family: NotoSans, NotoSansThai, sans-serif;
		<#else>
			font-family: Arial, NotoSans, sans-serif;
		</#if>
		}
		table {
			font-size: 9pt;
			table-layout: fixed;
		}
        th {
            font-weight: bold;
            font-size: 8pt;
            vertical-align: middle;
            padding: 5px 6px 3px;
            background-color: #657796;
            color: #ffffff;
        }
        td {
            padding: 4px 6px;
        }
		td p { align:left }
        b {
            font-weight: bold;
            color: #333333;
        }
        table.header td {
            padding: 4px 6px;
            font-size: 10pt;
        }
     	table.header td.label {
            padding: 4px 6px;
            font-size: 10pt;
          	font-weight: bold;
        }
      	table.header td.value {
            padding: 4px 6px;
            font-size: 9pt;
        }
        table.footer td {
            padding: 0;
            font-size: 8pt;
        }
        table.itemtable th {
            font-size: 9pt;
          	padding-bottom: 10px;
            padding-top: 10px;
        }
      	table.itemtable td {
            font-size: 9pt;
          	padding-bottom: 10px;
            padding-top: 10px;
        }
      	table.addresstable {
            border: 0px;
          	padding-top: 0px;
            padding-bottom: 0px;
          	margin-top: 0px;
          	margin-bottom: 0px;
        }
      	table.body {
        	padding-top: 0px;
            padding-bottom: 0px;
          	margin-top: 0px;
          	margin-bottom: 0px;
      	}
      	table.body tr {
            border: 0px;
          	border-collapse: collapse;
        }
        table.body th {
            font-size: 9pt;
          	padding: 8px;
          	align: center;
        }
      	table.body td {
          	font-size: 9pt;  
          	padding: 5px;
          	align: center;
          	vertical-align: middle;
          	border: .5px;
            border-color: #657796;
          	border-collapse: collapse;
        }
        table.total {
            page-break-inside: avoid;
        }
        tr.totalrow {
            background-color: #ffffff;
            line-height: 150%;
        }
        td.totalboxtop {
            font-size: 12pt;
            background-color: #e3e3e3;
        }
        td.addressheader {
            font-size: 10pt;
            padding-top: 0px;
            padding-bottom: 0px;
          	margin-top: 0px;
          	margin-bottom: 0px;
          	vertical-align: bottom;
        }
        td.address {
            font-size: 9pt;
          	padding-top: 0px;
          	padding-bottom: 0px;
          	margin-top: 0px;
          	margin-bottom: 0px;
          	line-height: 150%;
        }
        td.totalboxmid {
            font-size: 28pt;
            padding-top: 20px;
            background-color: #e3e3e3;
        }
        td.totalboxbot {
            background-color: #e3e3e3;
            font-weight: bold;
        }
      	table.remarks {
            font-size: 9pt;
        }
        span.title {
            font-size: 24pt;
        }
        span.number {
            font-size: 16pt;
        }
        span.itemname {
            font-weight: bold;
            line-height: 150%;
        }
        hr {
            width: 100%;
            color: #d3d3d3;
            background-color: #d3d3d3;
            height: 1px;
        }
</style>
</head>
<body header="nlheader" header-height="15%" footer="nlfooter" footer-height="20pt" padding="0.8in" size="Letter">
    <table class="addresstable" style="width: 100%;"><tr>
<td class="addressheader" colspan="5"><strong>${record.billaddress@label?upper_case}</strong></td>
<td class="addressheader" colspan="5"><strong>${record.shipaddress@label?upper_case}</strong></td>
</tr>
<tr style="border: 0px currentColor;">
<td class="addressheader" colspan="5"><hr style="padding-top: 0px; padding-bottom: 0px; margin-top: 0px; margin-bottom: 0px; vertical-align: middle;" /></td>
<td class="addressheader" colspan="5"><hr style="padding-top: 0px; padding-bottom: 0px; margin-top: 0px; margin-bottom: 0px; vertical-align: top;" /></td>
</tr>
<tr>
<td class="address" colspan="5">${record.billaddress}</td>
<td class="address" colspan="5">${record.shipaddress}</td>
</tr></table>
&nbsp;
<table class="body" style="width: 100%;"><tr>
<th>${record.salesrep@label?upper_case}</th>
<th>${record.otherrefnum@label?upper_case}</th>
<th>${record.shipmethod@label?upper_case}</th>
<th>${record.duedate@label?upper_case}</th>
<th>${record.terms@label?upper_case}</th>
</tr>
<tr>
<td>${record.salesrep}</td>
<td>${record.otherrefnum}</td>
<td>${record.shipmethod}</td>
<td>${record.duedate}</td>
<td>${record.terms}</td>
</tr></table>
<br /><#if record.item?has_content> <!-- check if record has tax amount/rate first --> <#assign tax_amt = false> <#assign tax_rate = false> <!-- "_st" fields added for SuiteTax compatibility / different field ids are checked--> <#assign tax_amt_st = false> <#assign tax_rate_st = false> <#list record.item as item> <#if (item.tax1amt?length != 0) ><#assign tax_amt = true></#if> <#if (item.taxamount?length != 0) ><#assign tax_amt_st = true></#if> <#if (item.taxrate1?length != 0) ><#assign tax_rate = true></#if> <#if (item.taxrate?length != 0) ><#assign tax_rate_st = true></#if> </#list> <!-- end check -->
<table class="itemtable" style="width: 100%;"><!-- start items --><#list record.item as item><#if item_index==0>
<thead>
<tr>
<th colspan="8">${item.item@label?upper_case}</th>
<th colspan="7">${item.description@label?upper_case}</th>
<#if tax_amt>
<th colspan="4">${item.tax1amt@label?upper_case}</th>
<#elseif tax_amt_st>
<th colspan="4">TAX AMT</th>
</#if> <#if tax_rate> <!-- <th colspan="2">${item.taxrate1@label?upper_case}</th> -->
<th colspan="3" align="center">&nbsp;TAX<br />RATE</th>
<#elseif tax_rate_st>
<th colspan="3" align="center">&nbsp;TAX<br />RATE</th>
</#if> <!-- <th align="center" colspan="3">${item.quantity@label?upper_case}</th> -->
<th colspan="2" align="center">QTY</th>
<th colspan="5" align="center">${item.rate@label?upper_case}</th>
<th colspan="5" align="center">${item.amount@label?upper_case}</th>
</tr>
</thead>
</#if><tr style="background-color: &lt;!--mce:protected %3c%23if%20%28item_index%20%25%202%29%20%3d%3d%200%3e--&gt;#ffffff&lt;!--mce:protected %3c%23else%3e--&gt;#e1e6ee&lt;!--mce:protected %3c/%23if%3e--&gt;;">
<td colspan="8">${item.item}</td>
<td colspan="7">${item.description}</td>
<#if tax_amt>
<td colspan="4">${item.tax1amt}</td>
<#elseif tax_amt_st>
<td colspan="4">${item.taxamount}</td>
</#if> <#if tax_rate>
<td colspan="3" align="center">${item.taxrate1}</td>
<#elseif tax_rate_st>
<td colspan="3" align="center">${item.taxrate}</td>
</#if>
<td colspan="2" align="center">${item.quantity}</td>
<#assign rateval = item.rate?string(",##0.00") /> <#assign amtval = item.amount?string(",##0.00") />
<td colspan="5" align="right">${record.custbody_currency_symbol}${rateval}</td>
<td colspan="5" align="right">${record.custbody_currency_symbol}${amtval}</td>
</tr>
</#list><!-- end items --></table>
</#if><hr style="border: 2px solid; color: #657796;" />
<table class="total" style="width: 100%;"><tr class="totalrow">
<td colspan="4">&nbsp;</td>
<td align="right"><strong>${record.subtotal@label?upper_case}</strong></td>
<td align="right">${record.subtotal}</td>
</tr>
<tr class="totalrow">
<td colspan="4">&nbsp;</td>
<td align="right"><strong>${record.taxtotal@label?upper_case}</strong></td>
<td align="right">${record.taxtotal}</td>
</tr>
<tr class="totalrow">
<td colspan="4">&nbsp;</td>
<td align="right"><strong>${record.shippingcost@label?upper_case}</strong></td>
<td align="right">${record.shippingcost}</td>
</tr>
<tr class="totalrow">
<td colspan="4">&nbsp;</td>
<td align="right"><strong>${record.total@label?upper_case}</strong></td>
<td align="right">${record.total}</td>
</tr>
<tr class="totalrow">
<td colspan="4">&nbsp;</td>
<td align="right"><strong>${record.amountpaid@label?upper_case}</strong></td>
<td align="right">${record.amountpaid}</td>
</tr>
<tr class="totalrow">
<td colspan="4">&nbsp;</td>
<td align="right"><strong>${record.amountremaining@label?upper_case}</strong></td>
<td align="right">${record.amountremaining}</td>
</tr></table>
<table class="comments" style="width: 100%; margin-bottom: 30%; page-break-inside: avoid;">
    <tr>
        <td style="font-size: 12pt; font-weight: bold; color: rgb(51, 51, 51); width: 50.0613%;">Comments</td>
        
    </tr>
    <tr>
        <td style="font-size: 10pt; width: 50.0613%;">
            <ol>
                <li>Payment: Cash in advance with PO</li>
                <li>Terms of Pricing: USA</li>
                <li>The effective period of this quotation: 30 days</li>
                <li>The unit price in this quotation doesn't include tax</li>
                <li>Please include quote number on all correspondence including Purchase Order</li>
                <li>Units quoted are evaluation units, and do not qualify for warranty</li>
            </ol>
        </td>
        <td style="font-size: 10pt; width: 50.0613%;">
            <strong>Electronic Payment Instructions:</strong><br />
            Silicon Valley Bank A Division of First Citizens Bank<br />
            3003 Tasman Drive, Santa Clara, CA 95054<br />
            Account of: Auradine, Inc.<br />
            Account#: 3303561738<br />
            ABA Routing #: 121140399<br />
            SWIFT Code: SVBKUS6S
        </td>
    </tr>
</table>
</body>
</pdf>
