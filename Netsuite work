/**
 * @NApiVersion 2.x
 * @NScriptType suitelet
 * @Author SIRUSOLLA NAGARJUNA
 * @Description: This script prints the check record related fields on pdf
 * @clickup_id: DEL-6470
 */
define(['N/render', 'N/record', 'N/config', 'N/search'], function (render, record, config, search) {
    /**
     * The main function to handle HTTP GET and POST requests.
     *
     * @param {Object} context - Object containing information about the current script execution
     * @param {ServerRequest} context.request - Request object
     * @param {ServerResponse} context.response - Response object
     */
    function onRequest(context) {
        try {
            var request = context.request;
            var response = context.response;

            if (request.method == "GET") {
                var renderer = render.create();
                renderer.setTemplateByScriptId({
                    scriptId: "CUSTTMPL_ITEMFULFILLMENT_PDF_"
                });
                var rec = record.load({
                    type: "itemreceipt",
                    id: context.request.parameters.custom_ifid
                });
                log.debug("rec", rec)
                var companyInfo = config.load({
                    type: config.Type.COMPANY_INFORMATION
                });

                var value = rec.getValue({
                    fieldId: 'createdfrom'
                });
                log.debug("value", value);
                var porec = record.load({
                    type: "purchaseorder",
                    id: value
                });
                log.debug("po record", porec)

                var ocrec = record.load({
                    type: "customrecord_abj_oc_order",
                    id: 1501
                });
                log.debug("ocrec", ocrec)

                var value1 = ocrec.getValue({
                    fieldId: 'custrecord_abj_oc_order_id'
                });
                log.debug("value1", value1)

                renderer.addRecord({
                    templateName: 'companyInformation',
                    record: companyInfo
                });
                renderer.addRecord({
                    templateName: 'record',
                    record: rec
                });
                renderer.addRecord({
                    templateName: 'purchaseorder',
                    record: porec
                });


                log.debug("companyInfo", companyInfo);
                var pdf = renderer.renderAsPdf();
                response.writeFile(pdf, true);
            }
        } catch (ex) {
            log.error(ex.name, ex);
        }
    }
    return {
        onRequest: onRequest
    }
});
