<table class="header" style="width: 100%;">
  <tr>
    <td align="left" style="width: 60%;">
      <span class="title">${record@title?upper_case}</span>
    </td>

    <td>
      <#-- Convert transaction date to string (safe comparison) -->
      <#assign trandate = record.trandate?string("yyyy-MM-dd")>

      <#if trandate <= "2026-04-01">

        <!-- BEFORE OR ON April 1, 2026 -->
        <#if subsidiary.logo?has_content>
          <img src="${subsidiary.logo@url}" style="margin: 7px; float: left;" />
        <#elseif companyInformation.logoUrl?has_content>
          <img src="${companyInformation.logoUrl}" style="margin: 7px; float: left;" />
        </#if>

      <#else>

        <!-- AFTER April 1, 2026 -->
        <#if subsidiary.custrecord_subsidiary_update_logo?has_content>
          <img src="${subsidiary.custrecord_subsidiary_update_logo@url}" style="margin: 7px; float: left;" />
        <#elseif subsidiary.logo?has_content>
          <img src="${subsidiary.logo@url}" style="margin: 7px; float: left;" />
        </#if>

      </#if>
    </td>

  </tr>
</table>
