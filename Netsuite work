for (let i = 0; i < vendorBillResponse.length; i++) {
    let currentVB = vendorBillResponse[i];
    let skipVB = false;

    for (let j = 0; j < itemReceiptResponse.length; j++) {
        let currentIR = itemReceiptResponse[j];

        if (currentVB.poDoc == currentIR.poDoc) {
            if (currentIR.datecreated < currentVB.datecreated) {
                log.debug("IR created first for PO " + currentVB.poDoc + ". Skipping processing for this Vendor Bill.");
                skipVB = true;
                break; // Exit early since VB should be skipped
            }
        }
    }

    if (!skipVB) {
        itemComparsion([currentVB], itemReceiptResponse);
    }
}
