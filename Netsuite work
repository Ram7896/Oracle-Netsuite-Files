function getLinkedIRQuantity(vbId) {
    try {
        var totalQty = 0;

        var irSearch = search.create({
            type: search.Type.ITEM_RECEIPT,
            filters: [
                ["custbody_ada_created_from", "anyof", vbId]
            ],
            columns: [
                search.createColumn({ name: "quantity" })
            ]
        });

        irSearch.run().each(function (result) {
            totalQty += parseFloat(result.getValue("quantity") || 0);
            return true;
        });

        return totalQty;

    } catch (error) {
        log.debug("Error in getLinkedIRQuantity:", error.message);
        return 0;
    }
}
