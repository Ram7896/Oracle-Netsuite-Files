var files_search = search.create({
    type: search.Type.TASK,
    filters: [
        ['case.internalid', 'anyof', parseInt(case_rec.id)],
        'AND',
        ['status', 'anyof', 'COMPLETE']
    ],
    columns: [
        search.createColumn({
            name: 'url',
            join: 'file'
        }),
        search.createColumn({
            name: 'description',
            join: 'file'
        })
    ]
}).run().getRange({
    start: 0,
    end: 1000
});

if (files_search && files_search.length > 0) {

    var images = files_search.map(function (r) {

        var url = r.getValue({
            name: 'url',
            join: 'file'
        });

        var description = r.getValue({
            name: 'description',
            join: 'file'
        }) || '';

        // Remove JSON date part
        description = description.replace(/\{.*?\}/g, '').trim();

        // Add domain if needed
        if (url && url.indexOf('http') === -1) {
            url = 'https://5238530-sb2.app.netsuite.com' + url;
        }

        return {
            url: url,
            description: description
        };

    }).filter(function (img) {

        return img.url && img.description;

    });

    log.debug({
        title: 'Images',
        details: images
    });

    renderer.addCustomDataSource({
        format: render.DataSource.OBJECT,
        alias: 'images',
        data: {
            imageList: images
        }
    });

} else {

    log.debug({
        title: 'INFO',
        details: 'Task is not started'
    });

}


<#list images.imageList as img>
    <table style="width: 100%;">
        <tr>
            <td align="center">
                <img src="${img.url}" width="220px" height="180px"/>
            </td>
        </tr>
        <tr>
            <td align="center">
                ${img.description}
            </td>
        </tr>
    </table>
</#list>

