/**
 * @NApiVersion 2.1
 * @NScriptType ScheduledScript
 */
define(['N/record', 'N/search', 'N/log'], (record, search, log) => {

    const EXP_SEARCH_ID = 'customsearch_expense_report_pending'; // Expense reports (checkbox = false)
    const PROG_MAP_SEARCH_ID = 'customsearch_program_department_map'; // Program → Department mapping

    const execute = () => {
        try {

            // 🔹 1. Load Program Mapping ONCE
            let programMap = {};

            let progSearch = search.load({
                id: PROG_MAP_SEARCH_ID
            });

            progSearch.run().each(res => {
                let programId = res.getValue({ name: 'custrecord_program' });
                let deptId = res.getValue({ name: 'custrecord_department' });

                if (programId && deptId) {
                    programMap[programId] = deptId;
                }
                return true;
            });

            log.debug('Program Map', programMap);

            // 🔹 2. Load Expense Reports
            let expSearch = search.load({
                id: EXP_SEARCH_ID
            });

            expSearch.run().each(result => {

                let expId = result.id;

                try {

                    let expRec = record.load({
                        type: record.Type.EXPENSE_REPORT,
                        id: expId,
                        isDynamic: true
                    });

                    let lineCount = expRec.getLineCount({
                        sublistId: 'expense'
                    });

                    let updatedCount = 0;

                    // 🔹 3. Loop Lines
                    for (let i = 0; i < lineCount; i++) {

                        expRec.selectLine({
                            sublistId: 'expense',
                            line: i
                        });

                        let program = expRec.getCurrentSublistValue({
                            sublistId: 'expense',
                            fieldId: 'custcol_program'
                        });

                        let currentDept = expRec.getCurrentSublistValue({
                            sublistId: 'expense',
                            fieldId: 'department'
                        });

                        // 🔹 4. Match Program → Department
                        if (program && programMap[program]) {

                            let newDept = programMap[program];

                            // Avoid unnecessary update
                            if (currentDept != newDept) {

                                expRec.setCurrentSublistValue({
                                    sublistId: 'expense',
                                    fieldId: 'department',
                                    value: newDept
                                });

                                expRec.commitLine({
                                    sublistId: 'expense'
                                });

                                updatedCount++;
                            } else {
                                expRec.cancelLine({
                                    sublistId: 'expense'
                                });
                            }

                        } else {
                            expRec.cancelLine({
                                sublistId: 'expense'
                            });
                        }
                    }

                    // 🔹 5. Update Checkbox ONLY if changes happened
                    if (updatedCount > 0) {

                        expRec.setValue({
                            fieldId: 'custbody_program_updated',
                            value: true
                        });

                        expRec.save({
                            enableSourcing: true,
                            ignoreMandatoryFields: true
                        });

                        log.audit('Updated Expense Report', expId + ' | Lines Updated: ' + updatedCount);

                    } else {
                        log.debug('Skipped (No Updates)', expId);
                    }

                } catch (innerErr) {
                    log.error('Error Processing Expense Report ID: ' + expId, innerErr);
                }

                return true;
            });

        } catch (e) {
            log.error('Script Error', e);
        }
    };

    return { execute };
});
