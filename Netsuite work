<!DOCTYPE html>
<html>
<head>
  <title>Student Registration Form</title>
</head>
<body>
  <form>
    <table border="1" cellpadding="5" cellspacing="0">
      <tr>
        <td>FullName</td>
        <td><input type="text"> (max 20 char a-z and A-Z)</td>
      </tr>
      <tr>
        <td>LastName</td>
        <td><input type="text"> (max 20 char a-z and A-Z)</td>
      </tr>
      <tr>
        <td>Date of Birth</td>
        <td><input type="date"></td>
      </tr>
      <tr>
        <td>GENDER</td>
        <td>
          <input type="radio" name="gender"> male
          <input type="radio" name="gender"> female
        </td>
      </tr>
      <tr>
        <td>EMAIL ID</td>
        <td><input type="email"></td>
      </tr>
      <tr>
        <td>Mobile No</td>
        <td><input type="text"></td>
      </tr>
      <tr>
        <td>ADDRESS</td>
        <td><textarea rows="5" cols="30"></textarea></td>
      </tr>
      <tr>
        <td>CITY</td>
        <td><input type="text"> (max 20 char a-z and A-Z)</td>
      </tr>
      <tr>
        <td>PIN CODE</td>
        <td><input type="text"> (6 digit number)</td>
      </tr>
      <tr>
        <td>STATE</td>
        <td><input type="text"></td>
      </tr>
      <tr>
        <td>COUNTRY</td>
        <td><input type="text"></td>
      </tr>
      <tr>
        <td>HOBBIES</td>
        <td>
          <input type="checkbox">Drawing
          <input type="checkbox">Singing
          <input type="checkbox">Dancing<br>
          <input type="checkbox">Others
          <input type="text">
        </td>
      </tr>

      <tr>
        <td rowspan="5">Qualification</td>
        <td>
          <table border="1" cellpadding="5" cellspacing="0">
            <tr>
              <th>Sl.No</th>
              <th>Examination</th>
              <th>Board</th>
              <th>Percentage</th>
              <th>Year of passing</th>
            </tr>
            <tr>
              <td>01</td>
              <td>Class X</td>
              <td><input type="text"></td>
              <td><input type="text"></td>
              <td><input type="text"></td>
            </tr>
            <tr>
              <td>02</td>
              <td>Class XII</td>
              <td><input type="text"></td>
              <td><input type="text"></td>
              <td><input type="text"></td>
            </tr>
            <tr>
              <td>03</td>
              <td>Graduation</td>
              <td><input type="text"></td>
              <td><input type="text"></td>
              <td><input type="text"></td>
            </tr>
            <tr>
              <td>04</td>
              <td>Master</td>
              <td><input type="text"></td>
              <td><input type="text"></td>
              <td><input type="text"></td>
            </tr>
          </table>
        </td>
      </tr>

      <tr>
        <td>COURSES APPLIED FOR
          <input type="checkbox">BSC
          <input type="checkbox">B.Com
          <input type="checkbox">B.Sc
          <input type="checkbox">B.A
        </td>
      </tr>

      <tr>
        <td colspan="2" style="text-align: center;">
          <input type="submit" value="Submit">
          <input type="reset" value="Reset">
        </td>
      </tr>
    </table>
  </form>
</body>
</html>

