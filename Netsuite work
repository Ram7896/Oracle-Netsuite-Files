function itemComparsion(vendorBillarr, itemReceiptarr) {
    try {
        log.debug("Function Item Comparison triggered");
        var irsumQuantity = 0;
        let usedIRs = new Set(); // Track used IRs

        for (var i = 0; i < vendorBillarr.length; i++) {
            var vbId = vendorBillarr[i].vbinternalid;
            var vbquantity = vendorBillarr[i].quantity;
            var item = vendorBillarr[i].item;

            if (isAlreadyLinked(vbId, record.Type.VENDOR_BILL)) {
                irsumQuantity = getQuantity(vbId, record.Type.VENDOR_BILL, item, record.Type.ITEM_RECEIPT);
                if (vbquantity <= irsumQuantity) {
                    continue;
                }
            } else {
                var remainingQty = vbquantity - irsumQuantity;

                for (var j = 0; j < itemReceiptarr.length && remainingQty > 0; j++) {
                    var irId = itemReceiptarr[j].internalid;

                    if (usedIRs.has(irId)) {
                        continue; // Skip if IR already used
                    }

                    var irItem = itemReceiptarr[j].item;
                    var irQty = itemReceiptarr[j].quantity;

                    if (item == irItem && vbquantity == irQty) {
                        record.submitFields({
                            type: record.Type.VENDOR_BILL,
                            id: vbId,
                            values: {
                                custbody_ada_created_from: irId
                            },
                            options: {
                                enableSourcing: false,
                                ignoreMandatoryFields: true
                            }
                        });

                        record.submitFields({
                            type: record.Type.ITEM_RECEIPT,
                            id: irId,
                            values: {
                                custbody_ada_created_from: vbId
                            },
                            options: {
                                enableSourcing: false,
                                ignoreMandatoryFields: true
                            }
                        });

                        usedIRs.add(irId); // Mark IR as used
                        enableCheck(vbId);
                        remainingQty -= irQty;
                        break; // Break since we linked successfully
                    }
                }
            }
        }
    } catch (error) {
        log.debug("Error in itemComparsion:", error.message);
    }
}
