/**
 * @NApiVersion 2.1
 * @NScriptType Suitelet
 */
define(['N/render', 'N/log'], function (render, log) {

    function onRequest(context) {
        try {
            const request = context.request;
            const invoiceId = parseInt(request.parameters.invoiceId);
            const docNumber = request.parameters.docNumber || 'Invoice';

            if (!invoiceId) {
                context.response.write('Missing invoiceId parameter');
                return;
            }

            const pdfFile = render.transaction({
                entityId: invoiceId,
                printMode: render.PrintMode.PDF
            });

            context.response.setHeader({
                name: 'Content-Type',
                value: 'application/pdf'
            });
            context.response.setHeader({
                name: 'Content-Disposition',
                value: `attachment; filename="${docNumber}.pdf"`
            });

            context.response.writeFile(pdfFile, false); // false = not inline, triggers download
        } catch (e) {
            log.debug("Error in Suitlet:", e.message);
        }
    }

    return { onRequest };
});
//To download invoice directly with this button


/**
 * @NApiVersion 2.1
 * @NScriptType UserEventScript
 */
define(['N/url'], function (url) {

    function beforeLoad(context) {
        try {
            if (context.type !== context.UserEventType.VIEW) return;

            const form = context.form;
            const invoiceRecord = context.newRecord;
            const invoiceId = invoiceRecord.id;
            const docNumber = invoiceRecord.getValue({ fieldId: 'tranid' });

            const suiteletUrl = url.resolveScript({
                scriptId: 'customscript874',
                deploymentId: 'customdeploy1',
                params: {
                    invoiceId: invoiceId,
                    docNumber: docNumber
                }
            });

            form.addButton({
                id: 'custpage_download_invoice_pdf',
                label: 'Download PDF',
                functionName: `function downloadPDF() { window.location.href = '${suiteletUrl}'; } downloadPDF();`
            });
        }
        catch (e) {
            log.debug("Error in UserEventScript:", e.message);
        }
    }

    return {
        beforeLoad: beforeLoad
    };
});
