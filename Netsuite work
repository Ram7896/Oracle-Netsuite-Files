/**
*@NApiVersion 2.1
*@NScriptType  ScheduledScript
*/
define(['N/search', 'N/record', 'N/runtime', 'N/email'],
  function (search, record, runtime, email) {
    function execute(context) {
      var runtimesample = runtime.getCurrentScript().deploymentId;
      log.debug("runtimesample:", runtimesample);
      //log.debug("context type",context.type);
      if (runtimesample == 'customdeploy_scheduled_task') {
        try {

          var employeeSearch = search.create({
            type: "employee",
            filters:
              [
                ["isinactive", "is", "F"]
              ],
            columns:
              [
                search.createColumn({ name: "entityid", label: "Name" }),
                search.createColumn({ name: "email", label: "Email" }),
                search.createColumn({ name: "phone", label: "Phone" }),
                search.createColumn({ name: "supervisor", label: "Supervisor" }),
                search.createColumn({ name: "title", label: "Job Title" })
              ]
          });
          var searchResultSet = employeeSearch.run().getRange({
            start: 0,
            end: 1000
          });
          log.debug('search created successfully');
          for (var index = 0; index < searchResultSet.length; index++) {
            var Name = searchResultSet[index].getValue('entityid');
            log.debug('Name:', Name);
            var Job_tit = searchResultSet[index].getValue('title');
            log.debug('Job_title:', Job_tit);
            var Email_add = searchResultSet[index].getValue('email');
            log.debug('Email_add:', Email_add);
            var FSupervisors = searchResultSet[index].getValue('supervisor');
            log.debug('Supervisiors:', FSupervisors);
            var customRecord = record.create({
              type: 'customrecord_track_employee'
            });
            var SetName = customRecord.setValue({
              fieldId: 'name',
              value: Name
            });
            var SetJob_tit = customRecord.setValue({
              fieldId: 'custrecord11',
              value: Job_tit
            });
            customRecord.setValue({
              fieldId: 'custrecord12',
              value: Email_add
            });
            var SetSupervisior = customRecord.setValue({
              fieldId: 'custrecord13',
              value: FSupervisors
            });
            var custRecord = customRecord.save({
              enablesourcing: true,
              ignoreMandatoryFields: true
            });
            var currentUser = runtime.getCurrentUser();
            log.debug('currentUser', currentUser);
            //if (context.type === context.UserEventType.CREATE) {
            log.debug('context.type entered');
            var senderId = currentUser.id;
            log.debug('sender id:', senderId);
            //var recipientId = currentUser.id;
            email.send({
              author: '-5',
              recipients: '757',
              subject: 'Testing Email Module',
              body: 'Name:' + SetName + 'Job_tit:' + SetJob_tit + 'Supervisior:' + SetSupervisior
            });
            // }
          }
        } catch (error) {
          log.error('Error in scheduled script assignment ', error);
        }
      }

      try {
        if (runtimesample == 'customdeploy_del_scheduled_task') {
          var recordType = 'customrecord_track_employee';
          var customrecord_track_employeeSearchObj = search.create({
            type: "customrecord_track_employee",

          });
          var searchResultCount = customrecord_track_employeeSearchObj.runPaged().count;
          log.debug("searchresultcount:",searchResultCount);
          var searchResultSet = customrecord_track_employeeSearchObj.run().getRange({
            start: 0,
            end: 1000
          });
          log.debug("Del search result:", searchResultSet);
          while (searchResultSet.length > 0) {
            for (var i = 0; i < searchResultSet.length; i++) {
              var recordId = searchResultSet[i].id;
              log.debug("del record id:", recordId);
              record.delete({
                type: recordType,
                id: recordId
              });

            }

          }
        }
      }
      catch (error) {
        log.error('Error in deletion', error);
      }
    }
    return {
      execute: execute
    };
  }
);


