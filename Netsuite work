// Rough polyfill of the Array.find method.
if ( !Array.prototype.find) {
  Object.defineProperty(Array.prototype, 'find', {
    value: function(callback) {
      return this.reduce( function(acu, el) {
        return acu || callback(el) ? el : undefined;
      }, undefined);
    },
    configurable: true,
    writable: true,
  });
} // end Array.find polyfill

