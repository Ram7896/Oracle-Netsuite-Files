/**
 * @NApiVersion 2.1
 * @NScriptType ClientScript
 */

define([], () => {

    const FIELDS = {
        INSURANCE: 'custentity5',
        EMAIL: 'custentity6',
        PUBLIC: 'custentity7',
        WC: [
            'custentity8', // QLD
            'custentity9', // NSW
            'custentity10', // VIC
            'custentity11', // SA
            'custentity12'  // WA
        ]
    };

    function fieldChanged(context) {

        try {

            let rec = context.currentRecord;
            let fieldId = context.fieldId;

            // RULE 1
            if (fieldId === FIELDS.INSURANCE) {

                let insurance =
                    rec.getValue({
                        fieldId: FIELDS.INSURANCE
                    });

                applyInsuranceRules(
                    rec,
                    insurance
                );
            }

            // RULE 2
            if (FIELDS.WC.includes(fieldId)) {

                if (isAnyWCSelected(rec)) {

                    rec.setValue({
                        fieldId: FIELDS.INSURANCE,
                        value: true
                    });

                    applyInsuranceRules(
                        rec,
                        true
                    );

                } else {

                    let insurance =
                        rec.getValue({
                            fieldId: FIELDS.INSURANCE
                        });

                    applyInsuranceRules(
                        rec,
                        insurance
                    );
                }
            }

        } catch (e) {

            console.log(
                'ERROR',
                e
            );
        }
    }

    function applyInsuranceRules(rec, enabled) {

        if (enabled) {

            rec.setValue({
                fieldId: FIELDS.PUBLIC,
                value: true,
                ignoreFieldChange: true
            });

            setMandatory(true);

        } else {

            rec.setValue({
                fieldId: FIELDS.PUBLIC,
                value: false,
                ignoreFieldChange: true
            });

            setMandatory(false);
        }
    }

    function isAnyWCSelected(rec) {

        return FIELDS.WC.some(f =>
            rec.getValue({
                fieldId: f
            }) === true
        );
    }

    function setMandatory(required) {

        let field =
            document.getElementById(
                'custentity6_fs_lbl'
            );

        if (!field) return;

        if (required) {

            field.classList.add(
                'uir-required-icon'
            );

        } else {

            field.classList.remove(
                'uir-required-icon'
            );
        }
    }

    function saveRecord(context) {

        let rec =
            context.currentRecord;

        let insurance =
            rec.getValue({
                fieldId: FIELDS.INSURANCE
            });

        let email =
            rec.getValue({
                fieldId: FIELDS.EMAIL
            });

        if (insurance && !email) {

            alert(
                'Email Insurance To is mandatory'
            );

            return false;
        }

        return true;
    }

    return {
        fieldChanged,
        saveRecord
    };

});
