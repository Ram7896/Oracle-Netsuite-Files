define(['N/search', 'N/record'], function (search, record) {

    function getInputData() {
        // Fetch only records in range 0–50000
        return search.create({
            type: "customrecord_nx_error",
            filters: [
                ["custrecord_nx_error_recovered", "is", "F"]
            ],
            columns: ["internalid"]
        })
        .run()
        .getRange({
            start: 0,
            end: 50000
        });
    }

    function map(context) {
        const searchResult = JSON.parse(context.value);
        const recId = searchResult.id;

        try {
            // Update field without loading the record
            record.submitFields({
                type: "customrecord_nx_error",
                id: recId,
                values: {
                    custrecord_nx_error_recovered: true
                }
            });

            log.audit("Updated Record", "Record ID: " + recId);

        } catch (e) {
            log.error("FAILED Updating Record ID: " + recId, e);
        }
    }

    function summarize(summary) {
        log.audit("FINISHED", "All records processed.");

        summary.mapSummary.errors.iterator().each(function (key, error) {
            log.error("Map Error for key: " + key, error);
            return true;
        });
    }

    return {
        getInputData: getInputData,
        map: map,
        summarize: summarize
    };
