/**
 * @NApiVersion 2.1
 * @NScriptType ScheduledScript
 */
define(['N/record', 'N/search', 'N/log', 'N/runtime'],
    (record, search, log, runtime) => {

        const execute = () => {
            log.audit('SCRIPT START', 'Expense Report Department Update Script Started');

            try {

                const script = runtime.getCurrentScript();

                const EXP_SEARCH_ID = script.getParameter({
                    name: 'custscript_expense_report_ss'
                });

                const PROG_MAP_SEARCH_ID = script.getParameter({
                    name: 'custscript_igs_department_saved_search'
                });

                log.debug('Script Parameters', {
                    EXP_SEARCH_ID,
                    PROG_MAP_SEARCH_ID
                });

                if (!EXP_SEARCH_ID || !PROG_MAP_SEARCH_ID) {
                    throw 'Missing required script parameters';
                }

                /* ============================================================
                   1️⃣ LOAD SEARCHES
                ============================================================ */
                log.audit('STEP 1', 'Loading Searches');

                const expPaged = search.load({ id: EXP_SEARCH_ID }).runPaged({ pageSize: 1000 });
                const progPaged = search.load({ id: PROG_MAP_SEARCH_ID }).runPaged({ pageSize: 1000 });

                log.audit('Search Counts', {
                    expenseReports: expPaged.count,
                    programMappings: progPaged.count
                });

                if (expPaged.count === 0) {
                    log.audit('EXIT', 'No Expense Reports Found');
                    return;
                }

                /* ============================================================
                   2️⃣ BUILD PROGRAM MAP
                ============================================================ */
                log.audit('STEP 2', 'Building Program Map');

                let programMap = {};

                progPaged.pageRanges.forEach(pageRange => {
                    log.debug('Processing Program Page', pageRange);

                    const page = progPaged.fetch({ index: pageRange.index });

                    page.data.forEach((res, idx) => {

                        const programName = res.getValue('name');
                        const deptId = res.getValue('custrecord_linked_department');

                        log.debug('Mapping Row', {
                            index: idx,
                            programName,
                            deptId
                        });

                        if (programName && deptId) {
                            programMap[programName.trim()] = deptId;
                        } else {
                            log.debug('Skipped Mapping Row', {
                                reason: 'Missing Program or Department',
                                programName,
                                deptId
                            });
                        }
                    });
                });

                log.audit('Program Map Built', {
                    totalMappings: Object.keys(programMap).length,
                    sample: JSON.stringify(programMap).substring(0, 500)
                });

                /* ============================================================
                   3️⃣ PROCESS EXPENSE REPORTS
                ============================================================ */
                log.audit('STEP 3', 'Processing Expense Reports');

                let processed = 0;
                let updatedReports = 0;

                expPaged.pageRanges.forEach(pageRange => {

                    log.debug('Processing Expense Page', pageRange);

                    const page = expPaged.fetch({ index: pageRange.index });

                    page.data.forEach(result => {

                        processed++;
                        const expId = result.id;

                        log.audit('Processing Expense Report', {
                            expId,
                            processedCount: processed
                        });

                        try {

                            const expRec = record.load({
                                type: record.Type.EXPENSE_REPORT,
                                id: expId,
                                isDynamic: true
                            });

                            const subsidiary = expRec.getValue('subsidiary');

                            log.debug('Loaded Expense Report', {
                                expId,
                                subsidiary
                            });

                            const lineCount = expRec.getLineCount({
                                sublistId: 'expense'
                            });

                            log.debug('Line Count', {
                                expId,
                                lineCount
                            });

                            let updatedLines = 0;

                            for (let i = 0; i < lineCount; i++) {

                                log.debug('--- LINE START ---', { line: i });

                                expRec.selectLine({
                                    sublistId: 'expense',
                                    line: i
                                });

                                const programText = expRec.getCurrentSublistText({
                                    sublistId: 'expense',
                                    fieldId: 'class'
                                });

                                const programName = programText ? programText.trim() : null;

                                const currentDept = expRec.getCurrentSublistValue({
                                    sublistId: 'expense',
                                    fieldId: 'department'
                                });

                                log.debug('Line Values', {
                                    line: i,
                                    programText,
                                    programName,
                                    currentDept,
                                    mappedDept: programMap[programName]
                                });

                                if (programName && programMap[programName]) {

                                    const newDept = programMap[programName];

                                    log.debug('Match Found', {
                                        line: i,
                                        programName,
                                        newDept
                                    });

                                    if (currentDept != newDept) {

                                        log.debug('Department Mismatch', {
                                            line: i,
                                            currentDept,
                                            newDept
                                        });

                                        try {

                                            expRec.setCurrentSublistValue({
                                                sublistId: 'expense',
                                                fieldId: 'department',
                                                value: newDept,
                                                ignoreFieldChange: true
                                            });

                                            log.debug('Department Set Success', {
                                                line: i,
                                                newDept
                                            });

                                            expRec.commitLine({
                                                sublistId: 'expense'
                                            });

                                            log.debug('Line Committed', { line: i });

                                            updatedLines++;

                                        } catch (e) {

                                            log.error('❌ Department Set FAILED', {
                                                expId,
                                                line: i,
                                                programName,
                                                attemptedDept: newDept,
                                                errorName: e.name,
                                                errorMsg: e.message,
                                                stack: e.stack
                                            });

                                            expRec.cancelLine({
                                                sublistId: 'expense'
                                            });

                                            log.debug('Line Cancelled After Failure', { line: i });
                                        }

                                    } else {

                                        log.debug('No Change Needed', {
                                            line: i,
                                            currentDept
                                        });

                                        expRec.cancelLine({
                                            sublistId: 'expense'
                                        });
                                    }

                                } else {

                                    log.debug('No Mapping Found', {
                                        line: i,
                                        programName
                                    });

                                    expRec.cancelLine({
                                        sublistId: 'expense'
                                    });
                                }

                                log.debug('--- LINE END ---', { line: i });
                            }

                            /* SAVE */
                            if (updatedLines > 0) {

                                log.audit('Saving Record', {
                                    expId,
                                    updatedLines
                                });

                                expRec.setValue({
                                    fieldId: 'custbody_igs_department_update',
                                    value: true
                                });

                                const recId = expRec.save({
                                    enableSourcing: true,
                                    ignoreMandatoryFields: true
                                });

                                log.audit('Record Saved', {
                                    expId: recId,
                                    updatedLines
                                });

                                updatedReports++;

                            } else {
                                log.audit('No Updates for Expense', { expId });
                            }

                        } catch (err) {

                            log.error('❌ Expense Processing Error', {
                                expId,
                                errorName: err.name,
                                errorMsg: err.message,
                                stack: err.stack
                            });
                        }
                    });
                });

                /* ============================================================
                   4️⃣ FINAL SUMMARY
                ============================================================ */
                log.audit('SCRIPT END SUMMARY', {
                    totalProcessed: processed,
                    reportsUpdated: updatedReports
                });

            } catch (e) {

                log.error('❌ FATAL SCRIPT ERROR', {
                    name: e.name,
                    message: e.message,
                    stack: e.stack
                });
            }

            log.audit('SCRIPT END', 'Execution Completed');
        };

        return { execute };
    });
