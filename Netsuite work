/**
 * @NApiVersion 2.1
 * @NScriptType UserEventScript
 */
define(['N/url', 'N/record'], function (url, record) {

    function afterLoad(context) {
        if (context.type !== context.UserEventType.VIEW) return;

        const newRecord = context.newRecord;
        const invoiceId = newRecord.id;

        // Generate URL for system-generated PDF (this is NetSuite's native print URL)
        const pdfUrl = `/app/accounting/transactions/transaction.nl?id=${invoiceId}&trantype=custinvc&whence=&printtype=transaction`;

        context.form.addButton({
            id: 'custpage_download_invoice_pdf',
            label: 'Download PDF',
            functionName: `window.open('${pdfUrl}', '_blank')`
        });
    }

    return {
        afterLoad: afterLoad
    };
});
