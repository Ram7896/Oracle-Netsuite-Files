/**
 * @NApiVersion 2.1
 * @NScriptType ClientScript
 */
define(['N/runtime'], function (runtime) {

    function pageInit(context) {

        var currentRole = runtime.getCurrentUser().role;
        var rec = context.currentRecord;
        var selectField = rec.getField({ fieldId: 'custrecord_select_field' });

        if (!selectField) return;

        // Clear all options first
        selectField.removeSelectOption({ value: null });

        // Example Role IDs (replace with actual)
        var RAM_ROLE_ID = 123;   // Ram role internal ID
        var RAJ_ROLE_ID = 456;   // Raj role internal ID

        if (currentRole === RAM_ROLE_ID) {
            selectField.insertSelectOption({ value: 'a', text: 'A' });
            selectField.insertSelectOption({ value: 'b', text: 'B' });
        }

        if (currentRole === RAJ_ROLE_ID) {
            selectField.insertSelectOption({ value: 'c', text: 'C' });
            selectField.insertSelectOption({ value: 'd', text: 'D' });
        }
    }

    return {
        pageInit: pageInit
    };
});
