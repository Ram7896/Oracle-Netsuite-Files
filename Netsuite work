/**
 * @NApiVersion 2.1
 * @NScriptType ClientScript
 */

define([], () => {

    const INSURANCE = 'custentity5';
    const EMAIL = 'custentity6';
    const PUBLIC = 'custentity7';

    const WC = [
        'custentity8',
        'custentity9',
        'custentity10',
        'custentity11',
        'custentity12'
    ];

    function pageInit(context) {
        applyRules(context.currentRecord);
    }

    function fieldChanged(context) {

        let rec = context.currentRecord;
        let field = context.fieldId;

        if (
            field === INSURANCE ||
            WC.includes(field)
        ) {
            applyRules(rec);
        }
    }

    function applyRules(rec) {

        let insurance =
            rec.getValue({
                fieldId: INSURANCE
            });

        let wcSelected =
            WC.some(f =>
                rec.getValue({
                    fieldId: f
                })
            );

        // RULE 2
        if (wcSelected) {

            insurance = true;

            rec.setValue({
                fieldId: INSURANCE,
                value: true,
                ignoreFieldChange: true
            });
        }

        // RULE 1
        if (insurance) {

            rec.setValue({
                fieldId: PUBLIC,
                value: true,
                ignoreFieldChange: true
            });

        } else {

            rec.setValue({
                fieldId: PUBLIC,
                value: false,
                ignoreFieldChange: true
            });
        }
    }

    function saveRecord(context) {

        let rec =
            context.currentRecord;

        let insurance =
            rec.getValue({
                fieldId: INSURANCE
            });

        let wcSelected =
            WC.some(f =>
                rec.getValue({
                    fieldId: f
                })
            );

        let email =
            rec.getValue({
                fieldId: EMAIL
            });

        if (
            (insurance || wcSelected)
            && !email
        ) {

            alert(
                'Email Insurance To is mandatory'
            );

            return false;
        }

        return true;
    }

    return {
        pageInit,
        fieldChanged,
        saveRecord
    };

});
