/**
 * @NApiVersion 2.1
 * @NScriptType ScheduledScript
 */
define(
    ['N/record', 'N/search', 'N/log', 'N/runtime'],
    (record, search, log, runtime) => {

        const execute = () => {
            try {
                const script = runtime.getCurrentScript();

                // Script parameters
                const EXP_SEARCH_ID = script.getParameter({
                    name: 'custscript_expense_report_ss'
                });

                const PROG_MAP_SEARCH_ID = script.getParameter({
                    name: 'custscript_igs_department_saved_search'
                });

                if (!EXP_SEARCH_ID || !PROG_MAP_SEARCH_ID) {
                    throw 'Missing required script parameters';
                }

                /* ============================================================
                   1️⃣ GET SEARCH COUNTS FIRST
                ============================================================ */
                const expPaged = search.load({ id: EXP_SEARCH_ID })
                    .runPaged({ pageSize: 1000 });

                const progPaged = search.load({ id: PROG_MAP_SEARCH_ID })
                    .runPaged({ pageSize: 1000 });

                log.audit('Search Counts', {
                    expenseReports: expPaged.count,
                    programMappings: progPaged.count
                });

                if (expPaged.count === 0) {
                    log.audit('No Expense Reports Found', 'Exiting script');
                    return;
                }

                /* ============================================================
                   2️⃣ BUILD PROGRAM NAME → DEPARTMENT MAP
                ============================================================ */
                let programMap = {};

                progPaged.pageRanges.forEach(pageRange => {
                    const page = progPaged.fetch({ index: pageRange.index });

                    page.data.forEach(res => {
                        // Program NAME from mapping search
                        const programName = res.getValue('name');
                        log.debug("ProgramName:", programName);
                        // Department internal ID
                        const deptId = res.getValue('custrecord_linked_department');
                        log.debug("Department Id:", deptId);
                        if (programName && deptId) {
                            programMap[programName] = deptId;
                        }
                    });
                });

                log.audit('Program Map Loaded', {
                    mappings: Object.keys(programMap).length
                });

                /* ============================================================
                   3️⃣ PROCESS EXPENSE REPORTS
                ============================================================ */
                let processed = 0;
                let updatedReports = 0;

                expPaged.pageRanges.forEach(pageRange => {
                    const page = expPaged.fetch({ index: pageRange.index });

                    page.data.forEach(result => {
                        processed++;
                        const expId = result.id;

                        try {
                            const expRec = record.load({
                                type: record.Type.EXPENSE_REPORT,
                                id: expId,
                                isDynamic: true
                            });

                            const lineCount = expRec.getLineCount({
                                sublistId: 'expense'
                            });
                            log.debug("LineCount:", lineCount);
                            let updatedLines = 0;

                            for (let i = 0; i < lineCount; i++) {

                                expRec.selectLine({
                                    sublistId: 'expense',
                                    line: i
                                });

                                // Use TEXT so it matches program NAME from progPaged
                                const programName = expRec.getCurrentSublistText({
                                    sublistId: 'expense',
                                    fieldId: 'class'
                                });
                                log.debug("ProgName:", programName);

                                const currentDept = expRec.getCurrentSublistText({
                                    sublistId: 'expense',
                                    fieldId: 'department'
                                });
                                log.debug("CurrentDept:", currentDept);
                                log.debug("ProgramMap:", programMap[programName]);

                                if (programName && programMap[programName]) {
                                    const newDept = programMap[programName];
                                    log.debug("newDept:", newDept);
                                    if (currentDept != newDept) {
                                        log.debug("current department doesn't match if entred");
                                        expRec.setCurrentSublistValue({
                                            sublistId: 'expense',
                                            fieldId: 'department',
                                            value: newDept
                                        });
                                        expRec.commitLine({ sublistId: 'expense' });
                                        updatedLines++;
                                    } else {
                                        expRec.cancelLine({ sublistId: 'expense' });
                                    }
                                } else {
                                    expRec.cancelLine({ sublistId: 'expense' });
                                }
                            }

                            /* ====================================================
                               SAVE ONLY IF UPDATES OCCURRED
                            ==================================================== */
                            if (updatedLines > 0) {
                                expRec.setValue({
                                    fieldId: 'custbody_igs_department_update',
                                    value: true
                                });

                                expRec.save({
                                    enableSourcing: true,
                                    ignoreMandatoryFields: true
                                });

                                updatedReports++;

                                log.debug('Expense Updated', {
                                    expId,
                                    updatedLines
                                });
                            }

                        } catch (err) {
                            log.error('Expense Processing Error', {
                                expId,
                                error: err
                            });
                        }
                    });
                });

                /* ============================================================
                   4️⃣ FINAL SUMMARY
                ============================================================ */
                log.audit('Scheduled Script Summary', {
                    totalProcessed: processed,
                    reportsUpdated: updatedReports
                });

            } catch (e) {
                log.error('Fatal Script Error', e);
            }
        };

        return { execute };
    }
);
