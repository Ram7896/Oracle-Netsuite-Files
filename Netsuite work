define(['N/format'], function(format) {

    function formatDateToDDMMYY(inputDate) {
        if (!inputDate) return '';

        // Convert to NetSuite date object if it's a string
        var dateObj = (typeof inputDate === 'string') ? new Date(inputDate) : inputDate;

        // Extract day, month, year
        var day = ('0' + dateObj.getDate()).slice(-2);
        var month = ('0' + (dateObj.getMonth() + 1)).slice(-2);
        var year = dateObj.getFullYear().toString().slice(-2); // only last 2 digits

        return `${day}/${month}/${year}`;
    }

    function execute() {
        var myDate = new Date(); // or record.getValue({ fieldId: 'trandate' });
        var formatted = formatDateToDDMMYY(myDate);
        log.debug('Formatted Date', formatted);
    }

    return { execute };
});
