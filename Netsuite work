/**
 * @NApiVersion 2.1
 * @NScriptType ScheduledScript
 */
define(['N/search', 'N/email', 'N/format', 'N/runtime', 'N/log'], function (search, email, format, runtime, log) {

    function execute(context) {
        try {
            const today = new Date();
            const todayStr = format.format({ value: today, type: format.Type.DATE });

            //Script Parameters getting Values
            const script = runtime.getCurrentScript();
            const expiredpreviousmonths = script.getParameter({ name: "custscript3" });
            const expiredtoday = script.getParameter({ name: "custscripttoday" });

            log.debug("Expired Previous Months (bool):", expiredpreviousmonths);
            log.debug("Expired Today (bool):", expiredtoday);

            //Based on the Action giving modes
            let mode;
            if (expiredpreviousmonths) {
                mode = 'expired_or_today';
            } else if (expiredtoday) {
                mode = 'only_today';
            }

            //Employees Search to getting Expiring Employees Details(10 units)
            const employeeSearch = search.create({
                type: search.Type.EMPLOYEE,
                filters: [
                    ['isinactive', 'is', 'F'],
                    'AND',
                    ['email', 'isnotempty', 'T']
                ],
                columns: [
                    'entityid',
                    'email',
                    'custentity2',
                    'custentity_driver_declaration',
                    'custentity_driver_license',
                    'custentity_first_aid',
                    'custentity_aid_11'
                ]
            });

            employeeSearch.run().each(result => {
                try {
                    const name = result.getValue('entityid');
                    const emailAddress = result.getValue('email');

                    if (mode === 'expired_or_today') {
                        handleExpiredOrToday(result, today, emailAddress, name);
                    } else if (mode === 'only_today') {
                        handleOnlyToday(result, todayStr, emailAddress, name);
                    }

                    return true;
                } catch (innerErr) {
                    log.error("Error processing employee", innerErr);
                    return true;
                }
            });

        } catch (err) {
            log.error("Script Execution Error", err);
        }
    }

    function handleExpiredOrToday(result, today, emailAddress, name) {
        try {
            const documents = getDocumentFields();
            const matchedDocs = [];

            documents.forEach(doc => {
                const dateStr = result.getValue(doc.field);
                if (!dateStr) return;

                const docDate = new Date(dateStr);
                if (docDate <= today) {
                    const formattedDate = format.format({ value: docDate, type: format.Type.DATE });
                    matchedDocs.push({ label: doc.label, date: formattedDate });
                }
            });

            if (matchedDocs.length > 0) {
                sendSummaryEmail(emailAddress, name, matchedDocs);
            }
        } catch (err) {
            log.error("Error in handleExpiredOrToday", err);
        }
    }

    function handleOnlyToday(result, todayStr, emailAddress, name) {
        try {
            const documents = getDocumentFields();
            const matchedDocs = [];

            documents.forEach(doc => {
                const dateStr = result.getValue(doc.field);
                if (dateStr === todayStr) {
                    matchedDocs.push({ label: doc.label, date: dateStr });
                }
            });

            if (matchedDocs.length > 0) {
                sendSummaryEmail(emailAddress, name, matchedDocs);
            }
        } catch (err) {
            log.error("Error in handleOnlyToday", err);
        }
    }

    //To Send email to the Users(20 Units Consumed)
    function sendSummaryEmail(emailAddress, name, documents) {
        try {

            const docList = documents.map(doc =>
                `${doc.label} - <strong>${doc.date}</strong>`
            ).join('<br/>'); // Add line breaks between items

            const body = `
            Hi ${name},<br/><br/>
            
            This is a reminder that the following documents are expired or expiring:<br/><br/>
            
            ${docList} <br/><br/>
            
            Please take immediate action to renew or update them.<br/><br/>
            
            Thanks,<br/>NetSuite Admin
        `;

            email.send({
                author: -5,
                recipients: emailAddress,
                subject: `Reminder: Document Expiry Notification`,
                body: body
            });

        } catch (err) {
            log.error("Error sending email", err);
        }
    }

    function getDocumentFields() {
        return [
            { field: 'custentity2', label: 'AI Induction' },
            { field: 'custentity_driver_declaration', label: 'Driver Declaration' },
            { field: 'custentity_driver_license', label: 'Driving License' },
            { field: 'custentity_first_aid', label: 'First Aid #009' },
            { field: 'custentity_aid_11', label: 'First Aid #011' }
        ];
    }

    return { execute };
});
