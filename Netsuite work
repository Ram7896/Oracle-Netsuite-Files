/**
 * aiGenerateCaseReport.js
 * @NApiVersion 2.1
 * @NModuleScope Public
 */
define(['N/render', 'N/record', 'N/file', 'N/search', 'N/file'],
  function (render, record, file, search, file) {

    /**
     * The internal id of a record within Netsuite.
     * @typedef {string|number} InternalId
     */

    /**
     * A suitescript file object as defined in the N/file module.
     * @typedef {Object} File
     */

    /**
     * Generates a pdf of the customer-safe case report for the given case.
     *     The report varies based on the type of the case.
     *
     * @param {InternalId} case_id - The case who's report needs to be created.
     * @param {InternalId} [template] - Optionally the template file to be used
     *     when generating the report.
     * @returns {File} - The generated pdf file.
     */
    function generateReport(case_id, template_id) {
      var renderer = render.create();
      var case_rec = record.load({
        type: record.Type.SUPPORT_CASE,
        id: case_id
      });

      // Add data for renderer
      renderer.addRecord({
        templateName: 'case',
        record: case_rec,
      });
      renderer.addRecord({
        templateName: 'site',
        record: record.load({
          type: 'customrecord_nx_asset',
          id: case_rec.getValue({ fieldId: 'custevent_nx_case_asset' }),
        })
      });
      var tasks = search.create({
        type: search.Type.TASK,
        filters: [
          ['case.internalid', search.Operator.IS, case_rec.id],
          'AND',
          ['custevent_nx_task_type', search.Operator.IS, '1'], // '1'Visit
          'AND',
          ['status', search.Operator.IS, 'COMPLETE'],
        ],
        columns: [
          { name: 'internalid' },
          { name: 'title' },
          { name: 'startdate', sort: search.Sort.ASC },
          { name: 'custevent_nxc_arrival_time', sort: search.Sort.ASC },
          { name: 'assigned' },
          { name: 'custevent_nxc_departure_time' },
          { name: 'custevent_nx_actions_taken' },
          { name: 'custevent_nxc_customer_name' },
          { name: 'custevent_nxc_customer_signature' },
          { name: 'custevent_nxc_technician_signature' },
          { name: 'message' },
        ],
      }).run().getRange(0, 1000);
      renderer.addSearchResults({
        templateName: 'visits',
        searchResult: tasks
      });
      var testings = search.create({
        type: 'customrecord_nxc_asset_testing',
        filters: [
          ['custrecord_at_nxc_case', search.Operator.IS, case_rec.id],
        ],
        columns: [
          { name: 'custrecord_at_nxc_task' },
          { name: 'custrecord_at_nxc_case' },
          { name: 'custrecord_at_nxc_outcome' },
          { name: 'custrecord_at_nxc_rating' },
          { name: 'custrecord_at_nxc_details' },
          { name: 'custrecord_at_nxc_asset' },
          { name: 'custrecord_at_nxc_doors_intact' },
          { name: 'custrecord_at_nxc_locks_failsafe' },
          { name: 'custrecord_at_nxc_inspected_for_traps' },
          { name: 'custrecord_at_nxc_inspected_for_conform' },
          { name: 'custrecord_at_nxc_opening_force' },
          { name: 'custrecord_at_nxc_door_alignment' },
          { name: 'custrecord_at_nxc_motor_drive_checked' },
          { name: 'custrecord_at_nxc_fixings_secure' },
          { name: 'custrecord_at_nxc_comp_wir_clean_sec' },
          { name: 'custrecord_at_nxc_failsafe_ok' },
          { name: 'custrecord_at_nxc_secure_locking' },
          { name: 'custrecord_at_nxc_battery_functioning' },
          { name: 'custrecord_at_nxc_egress_devices_ok' },
          { name: 'custrecord_at_nxc_programmed_for_cust' },
          { name: 'custrecord_at_nxc_clean_stickers_fixed' },
        ],
      }).run().getRange(0, 1000);
      renderer.addSearchResults({
        templateName: 'testings',
        searchResult: testings
      });
      var imageList = [];
      var files_search = search.create({
        type: search.Type.TASK,
        filters: [
          ['case.internalid', 'anyof', parseInt(case_rec.id)],
          "AND",
          ["status", "anyof", "COMPLETE"]
        ],
        columns: [
          search.createColumn({ name: 'custevent_nx_task_number', sort: search.Sort.ASC }),
          search.createColumn({ name: "status" }),
          search.createColumn({ name: 'name', join: 'file' }),
          search.createColumn({ name: 'filetype', join: 'file' }),
          search.createColumn({ name: 'url', join: 'file' }),
          search.createColumn({ name: 'description', join: 'file' })
        ]
      }).run().getRange({ start: 0, end: 1000 });
      log.debug("File Search:",files_search);
      // Convert to plain objects
      if (files_search.length > 0) {
        var images = files_search.map(function (r) {
          return {
            values: {
              'custevent_nx_task_number': r.getValue({ name: 'custevent_nx_task_number' }),
              'status': r.getValue({ name: 'status' }),
              'file.name': r.getValue({ name: 'name', join: 'file' }),
              'file.filetype': r.getValue({ name: 'filetype', join: 'file' }),
              'file.url': r.getValue({ name: 'url', join: 'file' }),
              'file.description': r.getValue({ name: 'description', join: 'file' })
            }
          };
        });

        images.forEach(function (img) {
          log.debug("name:", img.values['file.name']);
          var fileSearchObj = search.create({
            type: "file",
            filters:
              [
                ["name", "haskeywords", img.values['file.name']]
              ],
            columns:
              [
                search.createColumn({ name: "internalid", label: "Internal ID" })
              ]
          });
          var searchResultCount = fileSearchObj.runPaged().count;
          log.debug("fileSearchObj result count", searchResultCount);
          fileSearchObj.run().each(function (result) {
            var fileId = result.getValue({ name: 'internalid' });
            log.debug("File Id:", fileId);
            var fileObj = file.load({
              id: fileId
            });
            log.debug("FileObj:", fileObj);
            fileObj.isOnline = true;
            var saved = fileObj.save();
            log.debug("File Saved Successfully:", saved);
          });
        });
        renderer.addCustomDataSource({
          format: render.DataSource.OBJECT,
          alias: 'images',
          data: { imageList: images }
        });
        // log.debug("Image List:", imageList);
      } else {
        log.debug("Task is not started");
      }
      var parts = search.create({
        type: search.Type.TRANSACTION,
        filters: [
          ['type', search.Operator.IS, 'SalesOrd'],
          'AND',
          ['custbody_nx_case', search.Operator.IS, case_rec.id],
          'AND',
          ['item.itemid', search.Operator.DOESNOTCONTAIN, 'Labour'],
          'AND',
          ['item.itemid', search.Operator.DOESNOTCONTAIN, 'Callout'],
          'AND',
          ['item.itemid', search.Operator.DOESNOTCONTAIN, 'Service'],
          'AND',
          ['item.itemid', search.Operator.DOESNOTCONTAIN, 'SP '],
        ],
        columns: [
          { name: 'item' },
          { name: 'memo' },
          { name: 'custcol_nx_task' },
          { name: 'quantity' },
        ],
      }).run().getRange(0, 1000);
      renderer.addSearchResults({
        templateName: 'parts',
        searchResult: parts,
      });

      // Set Template and Render
      var template_file_id = '714151';
      var case_type = case_rec.getValue({ fieldId: 'custevent_nx_case_type' });
      if (case_type == '1' || case_type == '6') { // Major/Minor Maintenance
        template_file_id = '714152';
      }
      // If a specific template has been passed in, use it
      if (template_id) template_file_id = template_id;
      var template_content = file.load({ id: template_file_id }).getContents();
      renderer.templateContent = template_content;
      try {
        var report = renderer.renderAsPdf();
      } catch (e) {
        log.error({ title: 'TEMPLATE ERROR', details: JSON.stringify(e) });
        throw e;
      }
      var today = new Date();
      report.name = 'Case Report ' + case_rec.getValue({ fieldId: 'casenumber' }) + ' '
        + today.getDate() + '-' + (today.getMonth() + 1) + '-' + today.getFullYear() + '.pdf';

      return report;

    } // end function generateReport

    return {
      generateReport: generateReport
    }
  });

