/**
 * @NApiVersion 2.1
 * @NScriptType ClientScript
 */
define(['N/currentRecord'], function (currentRecord) {

  function fieldChanged(context) {
    try {
      var rec = context.currentRecord;
      var checkbox = rec.getValue({ fieldId: 'custbody12' });

      // Show or hide the date field
      var dateField = rec.getField({ fieldId: 'custbody13' });
      if (dateField) {
        dateField.isDisplay = checkbox;
      }
    } catch (error) {
      alert("Error in Field Change:" + error.message);
    }
  }

  return {
    fieldChanged: fieldChanged
  };
});
