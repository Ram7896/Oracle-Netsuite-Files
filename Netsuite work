/**
 * @NApiVersion 2.1
 * @NScriptType MapReduceScript
 * @NModuleScope SameAccount
 *
 * Purpose:
 * - Connect to WMS via token auth (client_credentials)
 * - Retrieve closed/fulfilled orders
 * - Transform SO -> Item Fulfillment (linking FFT req) and handle quantities/serials
 * - Mark IFR as processed
 */
define(['N/record', 'N/search', 'N/https', 'N/runtime', 'N/log', 'N/encode', 'N/error', 'N/cache'],
    (record, search, https, runtime, log, encode, error, cache) => {

        // ---------- CONFIG ----------
        const IFR_RECORD_TYPE = 'fulfillmentrequest';
        const WMS_REF_FIELD = 'custbody_wms_order_id';
        const IFR_PROCESSED_FLAG = 'custbody_if_processed';
        const IFR_WMS_TRACKING = 'custbody_wms_tracking';

        const CRED_REC_TYPE = 'customrecord_wms_integration_credentials';
        const CLIENT_ID_FIELD = 'custrecord_wms_client_id';
        const CLIENT_SECRET_FIELD = 'custrecord_wms_client_secret';
        const TOKEN_URL_FIELD = 'custrecord_wms_token_url';


        //const WMS_STATIC_RQL = 'ReadOnly.CustomerIdentifier.id==706;ReadOnly.FacilityIdentifier.id==9;ReadOnly.isClosed==true';
        const PAGE_SIZE = 100;

        let cachedToken = null;
        let tokenExpiry = 0;


        // ---------- HELPERS ----------


        function getCredentials() {
            log.debug('getCredentials', 'Starting credential lookup.');
            const results = search.create({
                type: CRED_REC_TYPE,
                filters: [['isinactive', 'is', 'F']],
                columns: [CLIENT_ID_FIELD, CLIENT_SECRET_FIELD, TOKEN_URL_FIELD]
            }).run().getRange({ start: 0, end: 1 });

            if (!results || results.length === 0) {
                log.error('getCredentials', 'WMS credentials not found.');
                throw new Error('WMS credentials not found.');
            }

            const row = results[0];
            log.debug('getCredentials', 'Credentials retrieved successfully.');
            return {
                clientId: row.getValue(CLIENT_ID_FIELD),
                clientSecret: row.getValue(CLIENT_SECRET_FIELD),
                tokenUrl: row.getValue(TOKEN_URL_FIELD),
                apiBase: 'https://secure-wms.com'
            };
        }

        function getAccessToken(creds) {
            log.debug('getAccessToken', 'Attempting to fetch/use cached token.');
            const now = Date.now();
            if (cachedToken && tokenExpiry && now < tokenExpiry - 1000) {
                log.debug('Token', 'Using cached token.');
                return cachedToken;
            }

            const basicAuth = `${creds.clientId}:${creds.clientSecret}`;
            const authHeader = 'Basic ' + encode.convert({
                string: basicAuth,
                inputEncoding: encode.Encoding.UTF_8,
                outputEncoding: encode.Encoding.BASE_64
            });

            const bodyStr = 'grant_type=client_credentials';
            log.debug('getAccessToken', `Requesting new token from ${creds.tokenUrl}`);
            const resp = https.post({
                url: creds.tokenUrl,
                headers: {
                    'Authorization': authHeader,
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'Accept': 'application/json'
                },
                body: bodyStr
            });
            log.debug("Response:", resp);
            if (resp.code !== 200) {
                log.error('TokenError', `Token request failed: ${resp.code} ${resp.body}`);
                throw new Error(`Failed to get access token: ${resp.code}`);
            }

            const json = JSON.parse(resp.body);
            const token = json.access_token || json.accessToken || json.token;
            const expiresIn = parseInt(json.expires_in || json.expiresIn || 300, 10);
            if (!token) {
                log.error('TokenError', 'Access token missing in response body.');
                throw new Error('Token missing access_token');
            }

            tokenExpiry = Date.now() + (isNaN(expiresIn) ? 300 : expiresIn) * 1000 - 60 * 1000;
            log.debug('TokenAcquired', `Token successfully acquired. Expires at ${new Date(tokenExpiry).toISOString()}`);
            cachedToken = token;
            return token;
        }


        function buildClosedOrderCache(creds, token) {

            const rql = 'ReadOnly.CustomerIdentifier.id==706;ReadOnly.FacilityIdentifier.id==9;ReadOnly.isClosed==true';
            const base = creds.apiBase.replace(/\/$/, '');

            let page = 1;
            const pageSize = 200;
            let more = true;

            const map = {};

            while (more) {

                const url =
                    `${base}/orders` +
                    `?pgnum=1&rql=${encodeURIComponent(rql)}` +
                    `&detail=All&itemdetail=All`;
                log.debug("URL:", url);
                const resp = https.get({
                    url,
                    headers: {
                        Authorization: `Bearer ${token}`,
                        Accept: 'application/json'
                    }
                });

                if (resp.code !== 200) {
                    throw Error(`WMS page fetch failed page=${page}`);
                }

                const body = JSON.parse(resp.body);
                log.debug("JSON Parse:", body);
                const list = body.ResourceList || [];

                list.forEach(o => {

                    const id =
                        o.ReadOnly?.OrderId ||
                        o.readOnly?.orderId ||
                        o.OrderId;

                    if (id) map[String(id)] = o;
                });

                more = list.length === pageSize;
                page++;

                if (runtime.getCurrentScript().getRemainingUsage() < 500) {
                    log.audit('Pagination Yield',
                        'Stopping early to protect governance');
                    break;
                }
            }

            const c = cache.getCache({
                name: 'WMS_CLOSED_ORDERS',
                scope: cache.Scope.PRIVATE
            });

            Object.keys(map).forEach(orderId => {
                c.put({
                    key: orderId,
                    value: JSON.stringify(map[orderId]),
                    ttl: 14400
                });
            });


            log.audit('Cache Built',
                `Closed orders cached: ${Object.keys(map).length}`);
        }

        function buildNsItemMapForSkus(skuList) {

            const map = {};
            const uniq = Array.from(new Set(skuList.filter(Boolean)));

            if (!uniq.length) return map;

            const filters = [];
            uniq.forEach((sku, i) => {
                if (i > 0) filters.push('OR');
                filters.push(['itemid', 'is', sku]);
            });


            const s = search.create({
                type: search.Type.ITEM,
                filters: filters,
                columns: ['internalid', 'itemid']
            });

            s.run().each(r => {
                const sku = r.getValue('itemid');
                map[sku] = {
                    itemId: r.getValue('internalid'),
                    itemName: sku
                };
                return true;
            });

            return map;
        }



        function sanitizeSerial(serial) {
            if (!serial && serial !== 0) return null;
            return String(serial).replace(/[\r\n]+/g, '').trim();
        }

        function extractSkuFromWmsLine(line) {
            if (!line) return null;
            if (line.ItemIdentifier && line.ItemIdentifier.Sku) return line.ItemIdentifier.Sku;
            if (line.itemIdentifier && line.itemIdentifier.sku) return line.itemIdentifier.sku;
            return line.sku || line.Sku || null;
        }

        // ---------- ENTRY POINTS ----------
        function getInputData() {

            const ifrSearch = search.create({
                type: 'fulfillmentrequest',
                filters: [
                    ['custbody_wms_order_id', 'isnotempty', ''],
                    'AND',
                    [IFR_PROCESSED_FLAG, 'is', 'F']

                ],
                columns: [
                    'internalid',
                    'createdfrom',
                    'custbody_wms_order_id'
                ]
            });

            // -------- Build WMS cache ONCE --------
            const creds = getCredentials();
            const token = getAccessToken(creds);
            buildClosedOrderCache(creds, token);

            return ifrSearch;
        }


        function map(context) {

            const r = JSON.parse(context.value);

            context.write({
                key: r.id,
                value: JSON.stringify({
                    ifrId: r.id,
                    soId: r.values.createdfrom.value,
                    wmsOrderId: r.values.custbody_wms_order_id
                })
            });
        }



        function getItemInternalId(sku) {

            var s = search.create({
                type: search.Type.ITEM,
                filters: [
                    ['name', 'is', sku], 'AND',
                    ['isinactive', 'is', 'F']
                ],
                columns: ['internalid']
            });

            var results = s.run().getRange({ start: 0, end: 1 });

            if (results && results.length > 0) {
                return parseInt(results[0].getValue('internalid'), 10);
            } else {
                log.debug("Item Search", "No item found for SKU: " + sku);
                return null;
            }
        }



        function buildInventoryNumberMap(serialList, itemId) {
            const map = {};
            const uniq = Array.from(new Set((serialList || []).filter(Boolean)));
            if (uniq.length === 0) return map;

            // Build OR group for text field `inventorynumber`
            const serialOrGroup = [];
            uniq.forEach((sn, idx) => {
                if (idx > 0) serialOrGroup.push('OR');
                serialOrGroup.push(['inventorynumber', 'is', sn]);
            });

            // filters: (serial in uniq) AND (item == itemId)
            const filters = [
                serialOrGroup,
                'AND',
                ['item', 'anyof', itemId]
            ];

            const s = search.create({
                type: 'inventorynumber',
                filters,
                columns: ['internalid', 'inventorynumber']
            });

            s.run().each(r => {
                map[r.getValue('inventorynumber')] = r.getValue('internalid');
                return true;
            });

            //log.debug("buildInventoryNumberMap inv number map", map);
            return map;
        }


        function reduce(context) {

            const payload = JSON.parse(context.values[0]);
            log.debug("Payload:", payload);
            const { ifrId, soId, wmsOrderId } = payload;
            if (!soId) {
                log.error('Skip', `IFR ${ifrId} has no Sales Order`);
                return;
            }

            try {

                // -------- Read Cache --------
                const c = cache.getCache({
                    name: 'WMS_CLOSED_ORDERS',
                    scope: cache.Scope.PRIVATE
                });

                const raw = c.get({ key: String(wmsOrderId) });

                if (!raw) {
                    log.audit('Skip', `No cached WMS order ${wmsOrderId}`);
                    return;
                }

                const wmsOrder = JSON.parse(raw);
                log.debug("WMS Order:", wmsOrder);

                if (!wmsOrder) {
                    log.audit('Skip', `No closed WMS order for ${wmsOrderId}`);
                    return;
                }
                const rawLines = wmsOrder.OrderItems || [];
                log.debug("Raw Lines:", rawLines);
                const packages = (wmsOrder.ReadOnly && wmsOrder.ReadOnly.Packages) || [];
                log.debug("Packages", packages);

                const serialMap = [];

                packages.forEach(pkg => {
                    const contents = pkg.PackageContents || [];
                    contents.forEach(pc => {
                        // --- Correction: flatten serials safely (avoid array-of-arrays) ---
                        if (Array.isArray(pc.SerialNumbers)) {
                            serialMap.push(...pc.SerialNumbers);
                        } else if (pc.SerialNumbers) {
                            serialMap.push(pc.SerialNumbers);
                        }
                    });
                });

                log.debug("Serial Map", serialMap);

                const wmsLine = rawLines
                    .map(l => ({
                        sku: extractSkuFromWmsLine(l),
                        qty: Number(l.Qty) || 0,
                        serialNumbers: serialMap
                    }))
                    .filter(l => l.qty > 0 && l.sku);
                //log.debug("WMS Lines", wmsLine);
                //log.debug("Sales Order Id", soId);
                //log.debug("IFR Id", ifrId);
                //log.debug("WMS Order Id", wmsOrderId);
                /*const wmsLines = rawLines.map(l => ({
                    sku: extractSkuFromWmsLine(l),
                    qty: Number(l.Qty) || 0,
                    serialNumbers: l.SerialNumbers || []
                })).filter(l => l.qty > 0 && l.sku);*/
                //log.debug("WMS Lines:", wmsLine);
                //log.debug("Sales Order Id:", soId);
                //log.debug("IfR Id:", ifrId);
                //log.debug("WMS Order Id:", wmsOrderId);
                const existing = search.create({
                    type: 'itemfulfillment',
                    filters: [
                        ['createdfrom', 'anyof', soId],
                        'AND',
                        ['custbody_wms_order_id', 'is', wmsOrderId]
                    ],
                    columns: ['internalid']
                }).run().getRange({ start: 0, end: 1 });
                log.debug("Existing if search:", existing);
                if (existing.length > 0) {
                    log.audit('Skip', 'IF already exists');
                    // return;
                }
                else {
                    const ifRec = record.transform({
                        fromType: record.Type.SALES_ORDER,
                        fromId: soId,
                        toType: record.Type.ITEM_FULFILLMENT,
                        isDynamic: true,
                        defaultValues: { fftreqid: ifrId }
                        //defaultValues: { inventorylocation: soLoc }
                    });
                    //log.debug("If transform triggered");
                    const skuMap = buildNsItemMapForSkus(
                        wmsLine.map(l => l.sku)
                    );
                    log.debug("SKU Map:", skuMap);
                    const idToLine = {};
                    wmsLine.forEach(l => {
                        const m = skuMap[l.sku];
                        if (m) idToLine[m.itemId] = l;
                    });

                    const lc = ifRec.getLineCount({ sublistId: 'item' });
                    log.debug("IF Line COunt:", lc);
                    for (let i = 0; i < lc; i++) {

                        ifRec.selectLine({ sublistId: 'item', line: i });

                        const itemId = ifRec.getCurrentSublistValue({
                            sublistId: 'item',
                            fieldId: 'item'
                        });

                        const wmsLines = idToLine[itemId];
                        //log.debug("WMS Lines after Item Id:", wmsLines);
                        if (!wmsLines) {
                            ifRec.setCurrentSublistValue({
                                sublistId: 'item',
                                fieldId: 'itemreceive',
                                value: false
                            });
                            ifRec.commitLine({ sublistId: 'item' });
                            continue;
                        }
                        log.debug("Item receive completed");
                        var itemInternalId = getItemInternalId(wmsLines.sku);
                        //log.debug("Item Internal Id:", itemInternalId);

                        log.debug("Item set successfully:", wmsLines.qty);
                        var qtyset = ifRec.setCurrentSublistValue({
                            sublistId: 'item',
                            fieldId: 'quantity',
                            value: wmsLines.qty
                        });
                        //log.debug("Quantity Set Successfully", qtyset);
                        /*ifRec.setCurrentSublistValue({
                            sublistId: 'item',
                            fieldId: 'itemreceive',
                            value: true
                        });*/
                        //log.debug("Wms Serial Numbers:", wmsLine.serialNumbers);
                        /* -------- SERIAL ASSIGNMENT ADD START -------- */

                        // --- Correction: use wmsLines (current line), not wmsLine (array) ---
                        if (wmsLines.serialNumbers && wmsLines.serialNumbers.length > 0) {
                            log.debug("If Wms Serial Numbers:", wmsLines.serialNumbers);
                            const cleanSerials = wmsLines.serialNumbers
                                .map(sanitizeSerial)
                                .filter(Boolean);
                            log.debug("WMS quantity:", wmsLines.qty);
                            log.debug("Clean Serials:", cleanSerials);
                            if (cleanSerials.length !== wmsLines.qty) {
                                log.error('SerialQtyMismatch',
                                    `Item ${itemId} qty=${wmsLines.qty} serials=${cleanSerials.length}`);
                            }

                            // Build map { serialNumber : internalId }
                            const invMap = buildInventoryNumberMap(cleanSerials, itemId);
                            log.debug("INV Map Details:", invMap);
                            // Now inventorydetail subrecord will exist
                            const invDetail = ifRec.getCurrentSublistSubrecord({
                                sublistId: "item",
                                fieldId: "inventorydetail"
                            });
                            log.debug("INv Details:", invDetail);
                            cleanSerials.forEach(sn => {
                                log.debug("Clean Serials Forr Loop entred");
                                const invId = invMap[sn];
                                log.debug("Inv Id:", invId);
                                if (!invId) {
                                    log.error("Serial Missing", `Serial ${sn} was not found in inventory`);
                                    return;
                                }

                                invDetail.selectNewLine({
                                    sublistId: "inventoryassignment"
                                });

                                // MUST USE internal ID for serialized numbers
                                invDetail.setCurrentSublistValue({
                                    sublistId: "inventoryassignment",
                                    fieldId: "issueinventorynumber",
                                    value: invId
                                });

                                invDetail.setCurrentSublistValue({
                                    sublistId: "inventoryassignment",
                                    fieldId: "quantity",
                                    value: 1
                                });

                                invDetail.commitLine({
                                    sublistId: "inventoryassignment"
                                });
                            });
                        }

                        /* -------- SERIAL ASSIGNMENT ADD END -------- */

                        ifRec.commitLine({ sublistId: "item" });
                    }
                    log.debug("If Saved Successfully");
                    const ifId = ifRec.save();
                    log.debug("If Saved Successfully", ifId);
                    if (ifId) {

                        var ifrrecord = record.load({
                            type: 'fulfillmentrequest',
                            id: ifrId,
                            isDynamic: true
                        });
                        ifrrecord.setValue({
                            fieldId: 'custbody_if_processed',
                            value: true
                        });
                        var ifrsave = ifrrecord.save({
                            enableSourcing: false,
                            ignoreMandatoryFields: true
                        });

                        log.debug("Ifr saved sucessfully:", ifrsave);
                    }
                    log.audit('SUCCESS', ifId);
                }

            } catch (e) {
                log.error('ReduceError', e);
            }
        }


        function summarize(summary) {
            const usage = summary.usage ? JSON.stringify(summary.usage) : 'n/a';
            log.audit('Summary', `Map/Reduce finished. Usage: ${usage}`);
            if (summary.mapSummary && summary.mapSummary.errors) log.error('MapErrors', `Map phase errors: ${JSON.stringify(summary.mapSummary.errors)}`);
            if (summary.reduceSummary && summary.reduceSummary.errors) log.error('ReduceErrors', `Reduce phase errors: ${JSON.stringify(summary.reduceSummary.errors)}`);
        }

        return {
            getInputData,
            map,
            reduce,
            summarize
        };
