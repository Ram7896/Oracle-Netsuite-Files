<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
  <head>
    <style>
      body {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 10pt;
      }
      h1 {
        font-size: 12pt;
        text-transform: uppercase;
        text-decoration: underline;
        margin-bottom: 10px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 8px;
      }
      th, td {
        border: 0.5px solid #999;
        padding: 5px;
        font-size: 9pt;
      }
      th {
        background-color: #EEE;
        text-align: center;
        font-weight: bold;
      }
      td.label {
        width: 25%;
        font-weight: bold;
        background-color: #f5f5f5;
      }
      .headerTable td {
        border: none;
        font-size: 10pt;
        padding: 4px;
      }
      .logoCell {
        text-align: center;
        vertical-align: middle;
        height: 50px;
      }
      .checklistTable th {
        background-color: #d3d3d3;
      }
      .signatureTable td {
        height: 35px;
      }
    </style>
  </head>

  <body size="A4" margin="0.5in">

    <!-- Title -->
    <h1>Automatic Entry Door - Service Checklist</h1>

    <!-- Header Info with Logo -->
    <table class="headerTable">
      <tr>
        <td class="label">Company</td>
        <td><img src="${subsidiary.pagelogo@url}" width="120" height="40"/></td>
        <td class="label">Technician Name</td>
        <td>${technician.name}</td>
      </tr>
      <tr>
        <td class="label">Store Name</td>
        <td>${store.name}</td>
        <td class="label">Date of Service</td>
        <td>${case.startdate?string("dd-MMM-yyyy")}</td>
      </tr>
    </table>

    <!-- General Instructions -->
    <p><b>General Items:</b><br/>
    When arriving to/departing from site the technician must sign into Rapid Global or equivalent ALDI Contractor Management System (CMS). 
    The technician must check into ServiceChannel and then checkout upon completion. 
    Enquire with staff as to performance of system and any specific issues that need attention. 
    Record and notify store staff of any issues that need to be addressed.
    </p>

    <!-- Checklist -->
    <table class="checklistTable">
      <tr>
        <th>Task</th>
        <th>Door 1<br/>Outer Entry/Exit</th>
        <th>Door 2<br/>Inner Entry</th>
        <th>Door 3<br/>Inner Exit</th>
        <th>Door 4<br/>Outer Exit</th>
      </tr>
      <tr>
        <td>Check condition of brush/rubber seals</td>
        <td></td><td></td><td></td><td></td>
      </tr>
      <tr>
        <td>Check and adjust door guides</td>
        <td></td><td></td><td></td><td></td>
      </tr>
      <tr>
        <td>Check brake distance open/close</td>
        <td></td><td></td><td></td><td></td>
      </tr>
      <tr>
        <td>Check door alignment</td>
        <td></td><td></td><td></td><td></td>
      </tr>
      <tr>
        <td>Check door clearances</td>
        <td></td><td></td><td></td><td></td>
      </tr>
      <!-- Repeat rows as needed -->
    </table>

    <!-- Additional Comments -->
    <h3>Additional Comments</h3>
    <table>
      <tr><td style="height:80px;"></td></tr>
    </table>

    <!-- Signatures -->
    <table class="signatureTable">
      <tr>
        <td class="label">Store Manager Signature</td>
        <td></td>
      </tr>
      <tr>
        <td class="label">Technician Signature</td>
        <td></td>
      </tr>
    </table>

    <!-- Store Stamp & Next Service -->
    <table>
      <tr>
        <td class="label">Store Stamp</td>
        <td style="height:60px;"></td>
      </tr>
      <tr>
        <td class="label">Next Service Due</td>
        <td></td>
      </tr>
    </table>

  </body>
</pdf>

