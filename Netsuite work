    /**
     * Key details about a service case record.
     * @typedef {Object} CaseDetails
     * @property {InternalId} type - Case Type set on the case.
     * @property {InternalId} project - Parent project of the case.
     * @property {InternalId} customer - Customer for the case.
     * @property {InternalId} priority - Callout Priority of the case.
     * @property {InternalId} asset - Site set on the case.
     * @property {InternalId} asset_dept - Department record corresponding to 
     *     the case's location.
     * @property {string} po - Purchase Order string set on the case.
     * @property {InternalId} id - Internal Id of the case.
     * @property {NSDateString} incident_date - The case's incident date.
     * @property {string} number - The case's SC number.
     * @property {boolean} labour_warranty - Wether the tech has flagged the
     *     case as under labour warranty.
     * @property {boolean} parts_warranty - Whether the tech has flagged the
     *     case as under parts warranty.
     * @property {boolean} manual_review - Whether the tech has requested the
     *     order be reviewed manually before being sent by the system.
     * @property {InternalId} warranty_type - Record representing whether the
     *     situation calls for a 'No-Charge' discount or a 'Warranty' discount.
     */

    /** 
     * Given the internal id of a case, returns an object containing various 
     *     details from that case.
     * @memberof aiCostTools
     *
     * @param {InternalId} case_id - The service case record of interest.
     * @returns {CaseDetails} - Key details about the service case.
     */
    function gatherCaseDetails( case_id ) {
      var case_search = search.lookupFields({
        type: search.Type.SUPPORT_CASE,
        id: case_id,
        columns: [
          'custevent_nx_case_type',
          'company',
          'custevent_nxc_call_out_priority',
          'custevent_nx_customer',
          'custevent_nx_case_asset',
          'custevent_nx_case_purchaseorder',
          'startdate',
          'number',
          'custevent_ai_tech_labour_warranty',
          'custevent_ai_tech_parts_warranty',
          'custevent_ai_tech_manual_review',
          'custevent_ai_pre_warranty_reason',
        ],
      });
      var case_type = case_search.custevent_nx_case_type;
      if ( case_type ) case_type = case_type[0].value;
      var project_id = case_search.company;
      if ( project_id ) project_id = project_id[0].value;
      var customer_id = case_search.custevent_nx_customer;
      if ( customer_id ) customer_id = customer_id[0].value;
      var case_priority = case_search.custevent_nxc_call_out_priority;
      if ( case_priority && case_priority != 0 ) {
        case_priority = case_priority[0].value;
      } else {
        case_priority = undefined;
      }
      var case_asset = case_search.custevent_nx_case_asset;
      if ( case_asset ) case_asset = case_asset[0].value;
      var case_po = case_search.custevent_nx_case_purchaseorder;
      var warranty_type = case_search.custevent_ai_pre_warranty_reason;
      if ( warranty_type && warranty_type[0] ) {
        warranty_type = warranty_type[0].value;
      }

      var tests = gatherAssetTestings(case_id, /* remove duplicates */ true);

      return {
        type: case_type,
        project: project_id,
        customer: customer_id,
        priority: case_priority,
        asset: case_asset,
        asset_dept: dcl.getAssetDepartment( case_asset ),
        po: case_po,
        id: case_id,
        tests: tests,
        date: case_search.startdate,
        number: case_search.number,
        labour_warranty: case_search.custevent_ai_tech_labour_warranty,
        parts_warranty: case_search.custevent_ai_tech_parts_warranty,
        manual_review: case_search.custevent_ai_tech_manual_review,
        warranty_type: warranty_type,
      };
    } // end gatherCaseDetails

    /**
     * Closes the provided order if the provided case is a maintenance case and
     *     the customer is a 'one-invoice' type customer.
     * @memberof aiCostTools
     *
     * @param {CaseDetails} case_details - Key details about the case.
     * @param {InternalId} order_id - The order to close.
     * @returns {boolean} - True if the order was closed, false otherwise.
     */
    function actionOneInvoiceCustomers(case_details, order_id) {
      // Check if case is maintenance case, if so check if the customer is a 
      // one-invoice customer. If customer is a one-invoice customer, close out
      // this order.
      // '1' Major, '6' Minor Maintenance
      if ( case_details.type == '1' || case_details.type == '6' ) { 
        var one_invoice = search.lookupFields({
          type: search.Type.CUSTOMER,
          id: case_details.customer,
          columns: ['custentity_ai_one_invoice'],
        }).custentity_ai_one_invoice;
        if ( one_invoice ) {
          var note = 'Customer is a one-invoice customer and does not need individual orders for each maintenance case.';
          closeOrder(order_id, note);
          return true;
        }
      }
      return false;
    }; // end actionOneInvoiceCustomers

    /**
     * A string representing a date in the format "DD/MM/YYYY".
     * @typedef {string} NSDateString
     */

    /**
     * Converts a Netsuite Date string into a Javascript Date object.
     * @memberof aiCostTools
     *
     * @param {NSDateString} nsDateString - The date to be converted.
     * @returns {Date} - A Javascript Date object matching the string originally
     *     passed into the function.
     */
    function toJsDate( nsDateString ) {
      var split = nsDateString.split('/');
      return new Date(split[2], split[1]-1, split[0]);
    } // end toJsDate( nsDateString )

    /**
     * Given a sales order, close out all lines and add a user note explaining 
     *     the reason for the closure.
     * @memberof aiCostTools
     *
     * @param {InternalId} order_id - The Sales Order record to be closed.
     * @param {string} reason - Used as the message portion of the user note
     *     created when the order is closed.
     **/
    function closeOrder( order_id, reason ) {
      var loaded_ord = record.load({
        type: record.Type.SALES_ORDER,
        id: order_id,
      });
      var num_items = loaded_ord.getLineCount({sublistId: 'item'});
      for ( var i = 0; i < num_items; i++ ) {
        loaded_ord.setSublistValue({
          sublistId: 'item',
          fieldId: 'isclosed',
          line: i, 
          value: true ,
        });
      }
      loaded_ord = loaded_ord.save();
      var user_note = record.create({type: record.Type.NOTE});
      user_note.setValue({fieldId: 'title', value: 'Closing Sales Order'});
      user_note.setValue({fieldId: 'note', value: reason});
      user_note.setValue({fieldId: 'transaction', value: loaded_ord});
      user_note = user_note.save();
    } // end closeOrder

    /**
     * An array of lines to be added to an order.
     * @typedef {Object} LineToAdd
     * @paramater {number} line - The line before which the new line should be
     *     inserted.
     * @property {InternalId} item - The item to be added on the line.
     * @property {string} desc - The description to be set on the line.
     */

    /**
     * Takes an order loaded by the N/record module in dynamic mode and checks 
     *     if the current line (not yet committed) needs to be zeroed out as 
     *     warranty or no-charge.
     * @memberof aiCostTools
     *
     * @param {DynamicRecord} order - The order to be checked.
     * @param {CaseDetails} case_details - Key details about the case relating
     *     to the order being checked.
     * @param {Array.<LineToAdd>|null} lines - The running record of lines to 
     *     have warranty shadow lines added OR null if the lines should be
     *     added immediately.
     */
    function checkLineForWarrantyAndCommit(order, case_details, lines) {
      log.debug({
        title: 'checkingLineForWarrantyAndCommit',
        details: JSON.stringify(case_details),
      });
      if ( case_details.labour_warranty || case_details.parts_warranty ) {
        log.debug({title: 'warranty detected'});
        var line = order.getCurrentSublistIndex({sublistId: 'item'});
        var num_lines = order.getLineCount({sublistId: 'item'});
        log.debug({title: 'current line to check for warranty', details: line});
        // Check that the next item isn't already a discount
        var next_rate = 0;
        if ( line + 1 < num_lines ) {
          next_rate = order.getSublistValue({
            sublistId: 'item',
            fieldId: 'rate',
            line: line+1,
          });
        }
        if ( next_rate >= 0 ) { 
          // Check which type of item you have
          var item_id = order.getCurrentSublistValue({
            sublistId: 'item',
            fieldId: 'item',
          });
          var item_type = search.lookupFields({
            type: search.Type.ITEM,
            id: item_id,
            columns: ['type'],
          }).type;
          log.debug({
            title: 'curr line to check for warranty details',
            details: 'item_id: ' + item_id + ', item_type: ' +
                JSON.stringify(item_type),
          });
          var is_part = false;
          if ( item_type ) {
            item_type = item_type[0].value;
            is_part = item_type == 'Assembly' || item_type == 'InvtPart';
          }
          log.debug({ title: 'current line is_part', details: is_part });
          // Gather description and part code
          var item_code = order.getCurrentSublistText({
            sublistId: 'item',
            fieldId: 'item',
          });
          var desc = order.getCurrentSublistValue({
            sublistId: 'item',
            fieldId: 'description',
          });
          log.debug({
            title: 'curr line adn details',
            details: 'item_code: ' + item_code + ', desc: ' + desc
          });
          desc = item_code + ' : ' + desc;
          // Commit the current line ready to add the shadow line
          order.commitLine({sublistId: 'item'});
          // Gather the correct
          // '3124'Warranty Discount '3125'No-Charge Discount warranty item
          var warranty_item = case_details.warranty_type == '2' ?
              '3124' : '3125'; 
          // Check warranty against the type
          var add_warranty = false;
          if ( is_part && case_details.parts_warranty ) add_warranty = true;
          if ( !is_part && case_details.labour_warranty ) add_warranty = true;
          if ( add_warranty ) {
            // If recording lines for the future do so, otherwise add the line
            // immediately
            if ( lines == undefined ) {
              insertShadowLine(order, warranty_item, line+1, desc);
            } else {
              lines.push({
                line: line+1,
                item: warranty_item,
                desc: desc,
              });
            }
          }
        }
      } else {
        log.debug({title: 'warranty not detected'});
        var line = order.getCurrentSublistIndex({sublistId: 'item'});
        log.debug({title: 'current line to check for warranty', details: line});
        order.commitLine({sublistId: 'item'});
      }
    } // end checkLineForWarrantyAndCommit

    /**
     * Takes an order loaded by the N/record module in dynamic mode and adds a 
     *     new line right under the existing one to make the current line
     *     no-charge. The new line also copies the item code and description 
     *     from the current line into it's description column.
     * @memberof aiCostTools
     *
     * @param {DynamicRecord} order - The order to be manipulated.
     * @param {InternalId} type - The internal id of the "$0 Invoice Category" 
     *     record corresponding with the proper type of the new line (Warranty 
     *     vs No-Charge).
     * @param {number} line - The line at which to insert the shadow line.
     * @param {string} desc - The description to set on the shadow line.
     */
    function insertShadowLine(order, type, line, desc) {
      var num_lines = order.getLineCount({sublistId: 'item'});
      // '2'No-Charge Type, '3101'No-Charge Discount, '3100'Warranty Discount
      log.debug({
        title: 'inserting shadow line',
        details: 'type: ' + type + ', line: ' + line + ', desc: ' + desc +
            ', num_lines: ' + num_lines});
      // Add new line
      if ( line == num_lines ) {
        log.debug({title: 'adding new line'});
        order.selectNewLine({sublistId: 'item'});
      } else {
        log.debug({title: 'inserting line'});
        order.insertLine({sublistId: 'item', line: line});
      }
      order.setCurrentSublistValue({
        sublistId: 'item',
        fieldId: 'item',
        value: type,
      });
      order.setCurrentSublistValue({
        sublistId: 'item',
        fieldId: 'description',
        value: desc,
      });
      order.commitLine({sublistId: 'item'});
    } // end insertShadowLine

    /**
     * Given an order loaded in dynamic mode with the N/record module, insert a
     *     series of lines into the item sublist.
     * @memberof aiCostTools
     *
     * @param {DynamicRecord} order - The order to be modified.
     * @param {Array.<LineToAdd>} lines - The lines to be inserted.
     */
    function insertLines(order, lines) {
      // Offset required to maintain accurate line insertion points despite
      // modifying the sublist as we go along (by moving items down the list)
      var offset = 0;
      lines.forEach( function(line) {
        insertShadowLine(order, line.item, line.line + offset, line.desc);
        offset++;
      });
    } // end insertLines

    /**
     * Checks through the given order and generates a message for the accounts
     *     team to help them handle the order manually.
     * @memberof aiCostTools
     *
     * @param {DynamicRecord} order - The order to be checked.
     * @param {string|null} - A message to be used as a user note indicating the
     *     issues that have been identified or null if no problems were found.
     */
    function runOrderChecks(order) {
      // Run Checks
      var results = sti.runServerChecks(/* so_id */ null, order);
      // Strip HTML from messages.
      var message = '';
      results.forEach( function(res) {
        if ( res.failed ) {
          message += ' ' + res.string.replace(/<\/?[^>]*?>/g, '');
        }
      });
      // Return final message.
      return message != '' ? message : null;
    } // end runOrderChecks

    /**
     * Checks the current line for missing department/class values and fills
     *     them in if required.
     * @memberof deptClassLoc
     *
     * @param {DynamicRecord} order - The order being processed.
     * @param {?string} order_mode - The current mode of the order as gathered by
     *     the deptClassLoc custom module. If null, the mode is re-calculated
     *     for each and every line.
     * @param {boolean} force_update - Wether or not to override any existing
     *     values for department and class.
     * @returns {boolean} - Whether or not the department or class has been
     *     applied to this line.
     */
    function checkLineSettings(order, order_mode, force_update) {
      var applied_setting = false;
      log.debug({title: 'checkLineSettings order_mode', details: order_mode});
      log.debug({title: 'checkLineSettings force_update', details: force_update});
      // Check & set the department/class if it's missing
      var dept = order.getCurrentSublistValue({
        sublistId: 'item',
        fieldId: 'department',
      });
      var cl = order.getCurrentSublistValue({
        sublistId: 'item',
        fieldId: 'class',
      });
      var line = order.getCurrentSublistIndex({sublistId: 'item'});
      // If dept or class is not currently set (or if forcing an update)
      if ( !dept || !cl || force_update ) {
        // Gather proper settings
        if ( order_mode ) {
          var line_settings = dcl.processLineFromMode(
              order, line, order_mode);
        } else {
          var line_settings = dcl.processLine(order, line);
        }
        // Make changes but do not edit the location column
        if ( !dept || force_update ) {
          order.setCurrentSublistValue({
            sublistId: 'item',
            fieldId: 'department',
            value: line_settings.department,
          });
          applied_setting = true;
        }
        if ( !cl || force_update ) {
          order.setCurrentSublistValue({
            sublistId: 'item',
            fieldId: 'class',
            value: line_settings.class,
          });
          applied_setting = true;
        }
      }
      return applied_setting;
    } // end checkLineSettings

    /** 
     * Given a Support Case, generates a matching sales order from scratch 
     *     based on the case type and any information that can be gleaned from 
     *     the related records (visit tasks & parent project). Also links the 
     *     sales order appropriately to the case.
     * @memberof aiCostTools
     *
     * @param {InternalId} case_id - The Support Case in question.
     * @returns {FinalOrder|null} - The new Sales Order or null if generation 
     *     failed.
     **/
    function generateCaseSalesOrder(case_id) {
      // Gather case details
      var case_details = gatherCaseDetails(case_id);
      var customer_rates = gatherServiceRates(
          case_details.customer, case_details.priority);

      var mergeable_cases = case_details.type == '2' ?
          checkForMaintenanceCasesToMerge(case_details) : null;

      var hold_order_for_accounts = false;
      var hold_message = '';

      var rates = gatherRates(case_details, customer_rates, mergeable_cases);
      log.debug("Rates:",rates);
      // add extra rates to std rates and flag order to be held for accounts
      var keys = Object.keys(rates.extra);
      if ( keys.length > 0 ) {
        hold_order_for_accounts = true;
        hold_message += 'Additional charges added to the order that are not within the maintenance agreement.';
        log.debug({
          title: 'Holding order for accounts.',
          details: 'Extra doors were serviced.',
        });
      }
      for ( var key in rates.extra ) {
        if ( rates.std[key] == undefined ) {
          rates.std[key] = rates.extra[key];
        } else {
          rates.std[key].qty += rates.extra[key].qty;
        }
      }

      // If labour set by field technician exceeds 2 hours, mark for accounts
      // to review.
      if ( rates.std[customer_rates.labour] &&
          rates.std[customer_rates.labour].qty > 2 ) {
        hold_order_for_accounts = true;
        hold_message += 'Labour exceeds 2 hours, please review tech report.';
      }

      // If case was a breakdown that has had qtly's merged into it, flag the
      // order for accounts and change the template of the jobcard.
      var template_id = undefined;
      if ( rates.qtly_merge ) {
        hold_order_for_accounts = true;
        hold_message += 'Qtly cases were merged into this breakdown.';
        template_id = '714152';
      }

      // If any required maintenance rates could not be found, flag for accounts
      // to action.
      if ( rates.missing_qtly_rates ) {
        hold_order_for_accounts = true;
        hold_message += 'Some required maintenance rates could not be located.';
      }

      // Hold order for accounts if warranty detected
      // TODO Fix so that order is only flagged if lines are actually added
      if ( case_details.parts_warranty || case_details.labour_warranty ) {
        hold_order_for_accounts = true;
        hold_message += ' Warranty lines have been added to the order.';
      }
      // Hold order for accounts if the tech has requested it
      if ( case_details.manual_review ) {
        hold_order_for_accounts = true;
        hold_message += ' A field tech has requested this order be manually reviewed.';
      }

      // Generate sales order and add rates gathered above
      var so_id = record.create({
        type: record.Type.SALES_ORDER,
        isDynamic: true,
      });
      // Body Fields
      // '174' AI NXC Sales Order
      so_id.setValue({fieldId: 'customform', value: '174'}); 
      so_id.setValue({fieldId: 'entity', value: case_details.project});
      so_id.setValue({
        fieldId: 'custbody_nx_customer', 
        value: case_details.customer,
      });
      so_id.setValue({
        fieldId: 'custbody_nx_asset', 
        value: case_details.asset,
      });
      so_id.setValue({fieldId: 'custbody_nx_case', value: case_id});
      // Set po by considering any mergeable cases
      var po = case_details.po;
      if ( mergeable_cases ) {
        mergeable_cases.forEach( function(c) { 
          if ( c.po && c.po != '' ) {
            po += ( po == '' ? '' : ' / ' ) + c.po; 
          }
        });
      }
      so_id.setValue({fieldId: 'otherrefnum', value: po});
      // Add the required rates
      var added_items = addRequiredRates(so_id, rates.std, case_details);
      if ( added_items == null ) {
        hold_order_for_accounts = true;
        hold_message += ' Error line has been added to this order.';
      }

      // Check dept/class and force correct values
      num_items = so_id.getLineCount({sublistId: 'item'});
      var order_mode = dcl.calcTransactionMode(so_id);
      log.debug({title: 'order_mode', details: order_mode});
      for ( var i = 0; i < num_items; i++ ) {
        so_id.selectLine({sublistId: 'item', line: i});
        var item_id = so_id.getCurrentSublistValue({
          sublistId: 'item',
          fieldId: 'item',
        });
        // If not description or discount item
        if ( item_id != -3 ) { 
          // Check & set the department/class if it's missing
          var applied_setting = checkLineSettings(
              so_id, order_mode, /* force_update */ true);
          if ( applied_setting ) {
            so_id.commitLine({sublistId: 'item'});
            modified_order = true;
          }
        }
      }

      // Run checks while order is loaded
      var check_result = runOrderChecks(so_id);
      if ( check_result && check_result != '' ) {
        hold_order_for_accounts = true;
        hold_message += check_result;
      }

      // Hold order for accounts to process (if needed)
      so_id.setValue({
        fieldId: 'custbody_ai_accounts_to_process',
        value: hold_order_for_accounts,
      });
      so_id = so_id.save();

      // Notes for accounts about order on hold
      if ( hold_order_for_accounts ) {
        addUserNoteTran(so_id, 'Holding For Manual Processing', hold_message);
      }

      // Attach job card to sales order
      attachJobcard(case_id, so_id, template_id);

      actionOneInvoiceCustomers(case_details, so_id);

      // Generate order for extra charges
      //generateExtraChargesOrder(case_details, rates.extra);

      // Return internal id of the new order
      return so_id == null ?
          null : {order_id: so_id, held: hold_order_for_accounts};
    } // end generateCaseSalesOrder

    /** 
     * Given a list of Sales Orders, attempts to merge them all into a single 
     *     order. Closes all other orders and returns the merged order.
     * @memberof aiCostTools
     *
     * @param {Array.<InternalId>} order_ids -  Sales Orders that need to be 
     *     merged together.
     * @returns {FinalOrder|null} - The merged Sales Order record or null if the
     *     merge was not possible.
     **/
    function mergeSalesOrders(order_ids) {
      // Identify which orders have item fulfillments related and mark as 
      // the primary order
      var fulfilled = [];
      search.create({
        type: search.Type.TRANSACTION,
        filters: [
          ['mainline', search.Operator.IS, 'T'],
          'AND',
          ['type', search.Operator.IS, 'ItemShip'],
          'AND',
          ['createdfrom', search.Operator.ANYOF, order_ids]
        ],
        columns: ['createdfrom'],
      }).run().each( function(result) {
        var ord_id = result.getValue({name: 'createdfrom'});
        if ( fulfilled.indexOf(ord_id) == -1 ) fulfilled.push(ord_id);
        return true;
      });
      var secondary = [];
      order_ids.forEach( function(ord) {
        if ( fulfilled.indexOf(ord) == -1 ) secondary.push(ord);
      });

      // If more than 1 order has item fulfillments related, mark each order for
      // manual handling and return NULL as merge has failed
      if ( fulfilled.length > 1 ) {
        order_ids.forEach( function(ord_id) {
          var hold_message = 'This sales order relates to a service case with additional sales orders attached all of which have item fulfillments. Unable to merge these orders together.';
          addUserNoteTran(ord_id,'Holding For Manual Processing', hold_message);
          record.submitFields({
            type: record.Type.SALES_ORDER,
            id: ord_id,
            values: {'custbody_ai_accounts_to_process': 'T'},
          });
        });
        return null;
      }

      // Gather all non-fulfillable items from the secondary orders
      // also keep track of which order is oldest
      var secondary_parts = {};
      var oldest_date = null;
      var oldest_id = null;
      secondary.forEach( function(ord_id) {
        var loaded_order = record.load({
          type: record.Type.SALES_ORDER,
          id: ord_id,
        });
        var order_date = loaded_order.getValue({fieldId: 'createddate'});
        if ( oldest_date == null || oldest_date > order_date ) {
          oldest_date = order_date;
          oldest_id = ord_id;
        }
        var num_items = loaded_order.getLineCount({sublistId: 'item'});
        for ( var i = 0; i < num_items; i++ ) {
          var item_id = loaded_order.getSublistValue({
            sublistId: 'item',
            fieldId: 'item',
            line: i,
          });
          var item_qty = loaded_order.getSublistValue({
            sublistId: 'item',
            fieldId: 'quantity',
            line: i,
          });
          var item_type = search.lookupFields({
            type: search.Type.ITEM,
            id: item_id,
            columns: ['type'],
          }).type;
          if ( item_type ) item_type = item_type[0].value;
          if ( item_type == 'Service' || item_type == 'OthCharge' ||
              item_type == 'NonInvtPart' ) {
            secondary_parts[item_id] = {qty: item_qty, present: false};
          }
        }
      });

      // Load the primary order (or the oldest order if there have not been 
      // any fulfillments).
      var primary_ord_id = null;
      if ( fulfilled.length == 0 ) {
        primary_ord_id = oldest_id;
        var rm_index = secondary.indexOf(oldest_id);
        if ( rm_index != -1 ) secondary.splice(rm_index,1);
      } else {
        primary_ord_id = fulfilled[0];
      }
      var primary_ord = record.load({
        type: record.Type.SALES_ORDER,
        id: primary_ord_id,
        isDynamic: true,
      });
      var primary_order_num = primary_ord.getValue({fieldId: 'tranid'});
      // Gather required case details
      var case_details = gatherCaseDetails(
        primary_ord.getValue({fieldId: 'custbody_nx_case'})
      );

      // Check the primary order for the presence of these non-fulfillable items
      var num_items = primary_ord.getLineCount({sublistId: 'item'});
      for ( var i = 0; i < num_items; i++ ) {
        var item_id = primary_ord.getSublistValue({
          sublistId: 'item',
          fieldId: 'item',
          line: i,
        });
        if ( secondary_parts[item_id] != null ) {
          secondary_parts[item_id].present = true;
        }
      }
      // Add any missing non-fulfillable items to the sales order
      for ( var item_id in secondary_parts ) {
        if ( !secondary_parts[item_id].present ) {
          primary_ord.selectNewLine({sublistId: 'item'});
          primary_ord.setCurrentSublistValue({
            sublistId: 'item',
            fieldId: 'item',
            value: item_id,
          });
          primary_ord.setCurrentSublistValue({
            sublistId: 'item',
            fieldId: 'quantity',
            value: secondary_parts[item_id].qty,
          });
          primary_ord.setCurrentSublistValue({
            sublistId:'item',
            fieldId:'department',
            value:case_details.asset_dept,
          });
          // '1' Major or '6' Minor Maintenance
          if ( case_details.type == '1' || case_details.type == '6' ) { 
            primary_ord.setCurrentSublistValue({
              sublistId: 'item',
              fieldId: 'class',
              value: idlib.CLASS.MAINTENANCE,
            });
          } else if ( case_details.type == '2' ) { // '2' Repair Breakdown
            primary_ord.setCurrentSublistValue({
              sublistId: 'item',
              fieldId: 'class',
              value: idlib.CLASS.REPAIR,
            });
          }
          primary_ord.commitLine({sublistId: 'item'});
        }
      };

      // Save any changes to the primary
      primary_ord = primary_ord.save();

      // Close all secondary orders
      secondary.forEach( function(ord_id) {
        var note = 'Identified as duplicate and merged with '+primary_order_num;
        closeOrder(ord_id, note);
      });

      // Verify that the merged order contains all required service items
      var result = verifyServiceItems(primary_ord);

      // Return the merged sales orders internal id
      return primary_ord == null ?
          null : {order_id: result.order_id, held: result.held};
    }; // end mergeSalesOrders

    /**
     * Given a Sales Order check that all required service items have been 
     *     added and that any items already added match the customer's special 
     *     rates settings as well as the priority of the related support case. 
     *     Items are adjusted to match the settings and the priority.
     * @memberof aiCostTools
     *
     * @param {InternalId} - Sales Order record to be checked.
     * @returns {FinalOrder} - The sales order after verification.
     **/
    function verifyServiceItems( order_id ) {
      var modified_order = false;
      var hold_order_for_accounts = false;
      var hold_message = '';

      var order = record.load({
        type: record.Type.SALES_ORDER,
        id: order_id, 
        isDynamic: true,
      });

      var case_id = order.getValue({fieldId: 'custbody_nx_case'});

      // Gather case details
      var case_details = gatherCaseDetails(case_id);
      var customer_rates = gatherServiceRates(
          case_details.customer, case_details.priority);
      var mergeable_cases = case_details.type == '2' ?
          checkForMaintenanceCasesToMerge(case_details) : null;

      // Gather rates
      var rates = gatherRates(case_details, customer_rates, mergeable_cases);

      // Check for parent estimate and remove labour/callout from required rates
      // if the price should be locked by the estimate. Instead of deleting
      // these rates, just record them as being already present.
      var parent_est = order.getValue({fieldId: 'custbody_ai_parent_estimate'});
      log.debug({title: 'parent_est', details: parent_est});
      log.debug({title: 'rates', details: JSON.stringify(rates)});
      if ( parent_est && parent_est != '' ) {
        for ( var key in rates.std ) {
          if ( rates.std[key].name.indexOf('Labour') != -1 ||
              rates.std[key].name.indexOf('Callout Fee') != -1 ) {
            rates.std[key].present = true;
          }
        }
      } else {
        // If no estimate found, make sure labour rates set by system don't
        // exceed 2 hours
        if ( rates.std[customer_rates.labour] &&
            rates.std[customer_rates.labour].qty > 2 ) {
          hold_order_for_accounts = true;
          hold_message += 'Labour exceeds 2 hours, please review tech report.';
        }
      }
      log.debug({title: 'rates', details: JSON.stringify(rates)});

      // If any required maintenance rates could not be found, flag for accounts
      // to action.
      if ( rates.missing_qtly_rates ) {
        hold_order_for_accounts = true;
        hold_message += 'Some required maintenance rates could not be located.';
      }

      // add extra rates to std rates and flag order for accounts to process
      var keys = Object.keys(rates.extra);
      if ( keys.length > 0 ) {
        hold_order_for_accounts = true;
        hold_message += 'Extra charges were added to the order that were not included in the maintenance agreement.';
        log.debug({
          title: 'Holding order for accounts.',
          details: 'Extra doors were serviced.',
        });
      }
      for ( var key in rates.extra ) {
        if ( rates.std[key] == undefined ) {
          rates.std[key] = rates.extra[key];
        } else {
          rates.std[key].qty += rates.extra[key].qty;
        }
      }

      // If case was a breakdown that has had qtly's merged into it, flag the
      // order for accounts and change the template of the jobcard.
      var template_id = undefined;
      if ( rates.qtly_merge ) {
        hold_order_for_accounts = true;
        hold_message += 'Qtly cases were merged into this breakdown.';
        template_id = '714152';
      }

      // Check each item on the order and adjust to match customer service 
      // rates if needed. Keep track of all required items and record if they 
      // have not been added yet
      var warranty_lines = [];
      /* warranty_lines is an array of objects of the form:
       * { line: [number], item: [internalid], desc: [string] }
       * These designate a series of items to be inserted at particular lines 
       * with a given description.
       */
      //var order_mode = dcl.calcTransactionMode(order);
      var num_items = order.getLineCount({sublistId: 'item'});
      for ( var i = 0; i < num_items; i++ ) {
        order.selectLine({sublistId: 'item', line: i});
        var item_id = order.getCurrentSublistValue({
          sublistId: 'item',
          fieldId: 'item',
        });
        var item_rate = order.getCurrentSublistValue({
          sublistId: 'item',
          fieldId: 'rate',
        });
        log.debug({
          title: 'verifying',
          details: 'line: ' + i + ', item_id: ' + item_id,
        });
        // If not description or discount item
        if ( item_id != -3 && item_rate >= 0 ) { 
          var item_name = search.lookupFields({
            type: search.Type.ITEM,
            id: item_id,
            columns: ['itemid'],
          }).itemid;
          // If item matches a required item which has not already been marked
          // as present
          if ( rates.std[item_id] && !rates.std[item_id].present ) {
            // Mark the required item as present
            rates.std[item_id].present = true;
            // Modify the qty to match the required qty
            var qty = order.getCurrentSublistValue({
              sublistId: 'item',
              fieldId: 'quantity',
            });
            log.debug({title: 'qty', details: qty});
            if ( qty != rates.std[item_id].qty ) {
              log.debug({title: 'overriding qty of required rate'});
              log.debug({title: 'new qty', details: rates.std[item_id].qty});
              var rounded_qty = Number(rates.std[item_id].qty).toFixed(4);
              log.debug({title: 'new qty rounded', details: rounded_qty});
              order.setCurrentSublistValue({
                sublistId: 'item',
                fieldId: 'quantity',
                value: rounded_qty
              });
              modified_order = true;
            }
          } else {
            // If the item doesn't match a required item, but is a callout-fee 
            // or labour item update it to match the customer settings.
            if ( item_name.indexOf('Callout Fee') != -1 ) {
              // Gather existing dept/class
              var dept = order.getCurrentSublistValue({
                sublistId: 'item',
                fieldId: 'department',
              });
              var cl = order.getCurrentSublistValue({
                sublistId: 'item',
                fieldId: 'class',
              });
              // Update item
              order.setCurrentSublistValue({
                sublistId: 'item',
                fieldId: 'item',
                value: customer_rates.callout,
              });
              // Set existing dept/class back again
              order.setCurrentSublistValue({
                sublistId: 'item',
                fieldId: 'department',
                value: dept,
              });
              order.setCurrentSublistValue({
                sublistId: 'item',
                fieldId: 'class',
                value: cl,
              });
              if ( rates.std[customer_rates.callout] ) {
                rates.std[customer_rates.callout].present = true;
              }
              modified_order = true;
            } else if ( item_name.indexOf('Labour') != -1 ) {
              // Gather existing dept/class
              var dept = order.getCurrentSublistValue({
                sublistId: 'item',
                fieldId: 'department',
              });
              var cl = order.getCurrentSublistValue({
                sublistId: 'item',
                fieldId: 'class',
              });
              // Update item
              order.setCurrentSublistValue({
                sublistId: 'item',
                fieldId: 'item',
                value: customer_rates.labour,
              });
              // Set existing dept/class back again
              order.setCurrentSublistValue({
                sublistId: 'item',
                fieldId: 'department',
                value: dept,
              });
              order.setCurrentSublistValue({
                sublistId: 'item',
                fieldId: 'class',
                value: cl,
              });
              if ( rates.std[customer_rates.labour] ) {
                rates.std[customer_rates.labour].present = true;
              }
              modified_order = true;
            }
          }
          // Check and commit the current line
          checkLineForWarrantyAndCommit(order, case_details, warranty_lines);
        }
      }

      // Add shadow warranty lines as required
      if ( warranty_lines.length > 0 ) {
        insertLines(order, warranty_lines);
        hold_order_for_accounts = true;
        hold_message += ' Warranty lines have been added to the order.';
      }

      var added_items = addRequiredRates(order, rates.std, case_details);
      if ( added_items == true ) modified_order = true;
      if ( added_items == null ) {
        hold_order_for_accounts = true;
        hold_message += ' Error line has been added to this order.';
      }

      // Check dept/class and adjust if needed
      num_items = order.getLineCount({sublistId: 'item'});
      var order_mode = dcl.calcTransactionMode(order);
      log.debug({title: 'order_mode', details: order_mode});
      for ( var i = 0; i < num_items; i++ ) {
        order.selectLine({sublistId: 'item', line: i});
        var item_id = order.getCurrentSublistValue({
          sublistId: 'item',
          fieldId: 'item',
        });
        // If not description or discount item
        if ( item_id != -3 ) { 
          // Check & set the department/class if it's missing
          var applied_setting = checkLineSettings(
              order, order_mode, /* force_update */ false);
          if ( applied_setting ) {
            order.commitLine({sublistId: 'item'});
            modified_order = true;
          }
        }
      }

      // Check order PO number matches case, otherwise append case PO number
      // also check for POs on any mergeable cases
      var order_po = order.getValue({fieldId: 'otherrefnum'});
      var new_po = order_po;
      if ( order_po != case_details.po ) new_po += ' / ' + case_details.po;
      if ( mergeable_cases ) {
        mergeable_cases.forEach( function(c) { 
          if ( c.po && c.po != '' ) {
            new_po += ( new_po == '' ? '' : ' / ' ) + c.po; 
          }
        });
      }
      if ( order_po != new_po ) {
        order.setValue({fieldId: 'otherrefnum', value: new_po});
        modified_order = true;
      }

      // Run checks while order is loaded
      var check_result = runOrderChecks(order);
      if ( check_result && check_result != '' ) {
        hold_order_for_accounts = true;
        hold_message += check_result;
      }

      // Mark order for accounts to process
      if ( hold_order_for_accounts ) {
        order.setValue({
          fieldId: 'custbody_ai_accounts_to_process',
          value: true,
        });
        modified_order = true;
      }
           
      if ( modified_order ) {
        order = order.save();
      } else {
        order = order.id;
      }

      // Notes for accounts about order on hold
      if ( hold_order_for_accounts ) {
        addUserNoteTran(order, 'Holding For Manual Processing', hold_message);
      }

      // Attach job card to sales order
      attachJobcard(case_id, order_id, template_id);

      var actioned = actionOneInvoiceCustomers(case_details, order_id);
      if ( actioned ) modified_order = true;

      // Generate order for extra charges
      //generateExtraChargesOrder(case_details, rates.extra);

      return order == null ?
          null : {order_id: order, held: hold_order_for_accounts};
    }; // end verifyServiceItems

    return {
      gatherMaintenanceCosts: gatherMaintenanceCosts,
      gatherServiceRates: gatherServiceRates,
      generateCaseSalesOrder: generateCaseSalesOrder,
      mergeSalesOrders: mergeSalesOrders,
      verifyServiceItems: verifyServiceItems,
      closeOrder: closeOrder,
    };
});

