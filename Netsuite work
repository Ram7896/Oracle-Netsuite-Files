/**
 * @NApiVersion 2.1
 * @NScriptType UserEventScript
 */
define(['N/record'], function (record) {
    function beforeLoad_addButton(scriptContext) {
        try {
            if (scriptContext.type === 'view') {
                var form = scriptContext.form;
                var recordObj = scriptContext.newRecord;
                var status = recordObj.getValue({
                    fieldId: 'status'
                });
                log.debug("Status:", status);
                if (status === "Pending Fulfillment") {
                    form.addButton({
                        id: 'custpage_buttonid',
                        label: 'Plose',
                        functionName: 'clientButton()'
                    });

                    form.clientScriptModulePath = 'SuiteScripts/ClientScripttaskexample.js';
                }
            }
        } catch (error) {
            log.debug("Error in Before Load Function:", error.message);
        }
    }
    return {
        beforeLoad: beforeLoad_addButton
    }
});

/**
 * @NApiVersion 2.1
 * @NScriptType ClientScript
 */
define(['N/currentRecord', 'N/search', 'N/record'], function (currentRecord, search, record) {

    function pageInit(context) {
    }

    function clientButton() {
        try {
            alert('submit button triggered');

            var recordobj = currentRecord.get();
            var soId = recordobj.id;

            var fieldLookUp = search.lookupFields({
                type: search.Type.SALES_ORDER,
                id: soId,
                columns: ['memo']
            });

            var memoValue = fieldLookUp.memo;

            if (!memoValue || memoValue.trim() === '') {
                alert('Enter value for memo field');
            } else {
                alert("else triggered");

                var rec = record.load({
                    type: record.Type.SALES_ORDER,
                    id: soId,
                    isDynamic: false
                });

                var lineCount = rec.getLineCount({ sublistId: 'item' });

                for (var i = 0; i < lineCount; i++) {
                    rec.setSublistValue({
                        sublistId: 'item',
                        fieldId: 'isclosed',
                        line: i,
                        value: true
                    });
                }

                rec.save();
                location.reload();
            }
        } catch (error) {
            alert("Error in Client Button:" + error.message);
        }
    }
    return {
        pageInit: pageInit,
        clientButton: clientButton
    };
});
