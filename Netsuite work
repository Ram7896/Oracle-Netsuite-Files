/**
 * Build WMS lines with serial numbers from
 * ReadOnly -> Packages -> PackageContents -> SerialNumbers
 */

// -------------------------------
// STEP 0: Inputs already available
// -------------------------------
const rawLines = wmsOrder.OrderItems || [];
log.debug("Raw Lines", rawLines);

// -------------------------------
// STEP 1: Correct Packages path
// -------------------------------
const packages = (wmsOrder.ReadOnly && wmsOrder.ReadOnly.Packages) || [];
log.debug("Packages", packages);

// -------------------------------
// STEP 2: Build OrderItemId → SerialNumbers map
// -------------------------------
const serialMap = {};

packages.forEach(pkg => {
    const contents = pkg.PackageContents || [];
    contents.forEach(pc => {
        const orderItemId = pc.OrderItemId;

        if (!serialMap[orderItemId]) {
            serialMap[orderItemId] = [];
        }

        if (pc.SerialNumbers && pc.SerialNumbers.length) {
            serialMap[orderItemId].push(...pc.SerialNumbers);
        }
    });
});

log.debug("Serial Map", serialMap);

// -------------------------------
// STEP 3: Build WMS lines
// -------------------------------
const wmsLines = rawLines
    .map(l => ({
        sku: extractSkuFromWmsLine(l),
        qty: Number(l.Qty) || 0,
        serialNumbers: serialMap[l.ReadOnly.OrderItemId] || []
    }))
    .filter(l => l.qty > 0 && l.sku);

// -------------------------------
// STEP 4: Debug final output
// -------------------------------
log.debug("WMS Lines", wmsLines);
log.debug("Sales Order Id", soId);
log.debug("IFR Id", ifrId);
log.debug("WMS Order Id", wmsOrderId);
