function partialIRVbLink(vbIds, irIds) {
    try {
        log.debug('partialIRVbLink->>', 'partialIRVbLink->>>');
        log.debug('VB Ids:', vbIds);
        log.debug('IR Ids:', irIds);

        if (irIds.length > vbIds.length) {
            log.debug("Condition: IRs > VBs triggered");

            // Link each VB with all IRs
            for (let i = 0; i < vbIds.length; i++) {
                const vbId = vbIds[i];
                record.submitFields({
                    type: record.Type.VENDOR_BILL,
                    id: vbId,
                    values: {
                        custbody_ada_linked_record: irIds
                    },
                    options: {
                        enableSourcing: false,
                        ignoreMandatoryFields: true
                    }
                });
                enableCheck(vbId);
                log.debug("VB linked to IRs:", { vbId, irIds });
            }

            // Each IR is linked to all VBs
            for (let i = 0; i < irIds.length; i++) {
                const irId = irIds[i];
                record.submitFields({
                    type: record.Type.ITEM_RECEIPT,
                    id: irId,
                    values: {
                        custbody_ada_linked_record: vbIds
                    },
                    options: {
                        enableSourcing: false,
                        ignoreMandatoryFields: true
                    }
                });
                log.debug("IR linked to VBs:", { irId, vbIds });
            }

        } else {
            log.debug("Condition: VBs >= IRs triggered");

            // Link each VB to all IRs
            for (let i = 0; i < vbIds.length; i++) {
                const vbId = vbIds[i];
                record.submitFields({
                    type: record.Type.VENDOR_BILL,
                    id: vbId,
                    values: {
                        custbody_ada_linked_record: irIds
                    },
                    options: {
                        enableSourcing: false,
                        ignoreMandatoryFields: true
                    }
                });
                enableCheck(vbId);
                log.debug("VB linked to IRs:", { vbId, irIds });
            }

            // Each IR is linked to all VBs
            for (let i = 0; i < irIds.length; i++) {
                const irId = irIds[i];
                record.submitFields({
                    type: record.Type.ITEM_RECEIPT,
                    id: irId,
                    values: {
                        custbody_ada_linked_record: vbIds
                    },
                    options: {
                        enableSourcing: false,
                        ignoreMandatoryFields: true
                    }
                });
                log.debug("IR linked to VBs:", { irId, vbIds });
            }
        }

        log.debug("Linking complete");
    } catch (error) {
        log.debug("Error in PartialIrLink function:", error.message);
    }
}
