<table class="headerTable" style="width:100%; border-collapse:collapse;">   

<tr>
  <th rowspan="2"
      style="text-align: center; vertical-align: middle; font-weight: bold;
             border: 0.5px solid #000; font-size: 10px; padding: 10px;">
    Task
  </th>

  <!-- Total columns -->
  <th colspan="${sub_assets.data?size}"
      style="text-align: center; vertical-align: middle; font-weight: bold;
             border: 0.5px solid #000; font-size: 10px; padding: 10px;">
    Complete (Y / N)
  </th>
</tr>

<!-- HEADER Row 2 -->
<tr>
  <#list sub_assets.data as i>
    <th style="text-align: center; border: 0.5px solid #000; font-size: 10px;">
      <b>${i.name!''}</b>
      <!-- using !'' ensures no missing column -->
    </th>
  </#list>
</tr>
