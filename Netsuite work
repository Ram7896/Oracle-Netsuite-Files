/**
 * @NApiVersion 2.1
 * @NScriptType UserEventScript
 */
define(['N/record', 'N/log'], (record, log) => {

    const beforeLoad = (context) => {
        if (context.type !== context.UserEventType.VIEW) return;

        try {
            const salesOrder = context.newRecord;
            const fieldIds = salesOrder.getFields();

            let hiddenFields = [];

            fieldIds.forEach(fieldId => {
                const field = salesOrder.getField({ fieldId: fieldId });
                if (field && !field.isDisplay) {
                    hiddenFields.push(fieldId);
                }
            });

            log.debug('Hidden Fields on Sales Order', hiddenFields.join(', '));
        } catch (e) {
            log.error('Error finding hidden fields', e.message);
        }
    };

    return { beforeLoad };
});
