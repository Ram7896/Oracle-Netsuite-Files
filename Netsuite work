/**
 *@NApiVersion 2.1
 *@NScriptType ScheduledScript
 */

define(['N/search', 'N/record', 'N/runtime', 'N/log'], 
function (search, record, runtime, log) {

    const MAX_RECORDS = 50000;

    function execute(context) {
        try {
            const script = runtime.getCurrentScript();

            const mySearch = search.create({
                type: "customrecord_nx_error",
                filters: [
                    ["custrecord_nx_error_recovered", "is", "F"]
                ],
                columns: ["internalid"]
            });

            const resultSet = mySearch.run();

            let start = 0;
            let processedCount = 0;

            while (true) {

                // 🔴 Stop if reached 50K
                if (processedCount >= MAX_RECORDS) {
                    log.audit("Limit Reached", "Processed 50,000 records");
                    break;
                }

                // 🔴 Stop if low governance
                if (script.getRemainingUsage() < 200) {
                    log.audit("Stopping Early", "Low governance");
                    break;
                }

                // Fetch 1000 records at a time
                let results = resultSet.getRange({
                    start: start,
                    end: start + 1000
                });

                if (!results || results.length === 0) {
                    log.audit("No More Records", "Search completed");
                    break;
                }

                for (let i = 0; i < results.length; i++) {

                    if (processedCount >= MAX_RECORDS) break;

                    const recId = results[i].id;

                    try {
                        record.submitFields({
                            type: "customrecord_nx_error",
                            id: recId,
                            values: {
                                custrecord_nx_error_recovered: true
                            }
                        });

                        processedCount++;

                    } catch (e) {
                        log.error("Error updating ID: " + recId, e);
                    }
                }

                start += 1000;
            }

            log.audit("Execution Completed", "Total Processed: " + processedCount);

        } catch (e) {
            log.error("Script Error", e);
        }
    }

    return {
        execute: execute
    };
});
