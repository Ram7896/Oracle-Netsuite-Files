<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
  <head>
    <style>
      body {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 10pt;
      }
      h1 {
        font-size: 12pt;
        text-transform: uppercase;
        text-decoration: underline;
        margin-bottom: 10px;
      }
      table {
       width:130%; 
       border-collapse:collapse; 
       margin-bottom:10px;
      }
      th, td {
       width:25%; 
       font-weight:bold;
       padding:4px;
      }
      th {
        background-color: #EEE;
        text-align: center;
        font-weight: bold;
         border:0.5px; 
      }
      td{
        padding: 4px;
      }
      td.label {
        width: 25%;
        font-weight: bold; 
        background-color: #f5f5f5;
      }
      td.label1{
        width: 15%;
        font-weight: bold; 
        background-color: #f5f5f5;
      }
      .headerTable td {
        border: none;
        font-size: 10pt;
        padding: 4px;
        border:0.5px; 
      }
      .logoCell {
        text-align: center;
        vertical-align: middle;
        height: 50px;
      }
      .checklistTable th {
        background-color: #d3d3d3;
      }
      .signatureTable td {
        height: 35px;
      }
    </style>
  </head>

  <body font-size="8" font-family="Helvetica">

   <!-- Appendix A Section -->
    <h2>Appendix A – Preventative Maintenance – Scope of Works</h2>
    <p>
      Specified Preventative Maintenance scope of works should be completed to the contracted frequencies.
      The scope of works for each asset is contained within the appropriate Preventative Maintenance checklist below.
      Please ensure the below checklists are completed alongside each Preventative Maintenance service, signed,
      and provided with the invoice as per Special Condition Section 15.6.
    </p>
    <br/>

    <!-- Header Section -->
<h2 style="margin-bottom:15px;">1.&nbsp;&nbsp;&nbsp;AUTOMATIC ENTRY DOOR</h2>

    <!-- Header Info with Logo -->
    <table class="headerTable">
       <tr class="row">
        <td class="label">Company</td>
        <td class="label">Technician Name</td>
        <td>${technician.name}</td>
      </tr>
      <tr class = "row" style="vertical-align: middle;">
      <td><img src="${subsidiary.pagelogo@url}" width="210px" height="40px"/></td>
        <td class="label">Store Name</td>
        <td>${store.name}</td>
      </tr>
      <tr>
      <td></td>
        <td class="row">Date of Service</td>
        <td>${case.startdate}</td>
      </tr>
    </table>

    <!-- General Instructions -->
   <table class="headerTable">
  <tr>
    <td class="label"><b>General Items</b></td>
    <td>
      When arriving to/departing from site the technician must sign into Rapid Global or equivalent ALDI Contractor Management System (CMS).<br/>
      The technician must check into ServiceChannel and then checkout upon completion.<br/>
      Enquire with staff as to performance of system and any specific issues that need attention.<br/>
      Record and notify store staff of any issues that need to be addressed.
    </td>
  </tr>
</table>

    <!-- Checklist -->
    <table class="checklistTable">
      <tr>
        <th>Task</th>
        <th>Door 1<br/>Outer Entry/Exit</th>
        <th>Door 2<br/>Inner Entry</th>
        <th>Door 3<br/>Inner Exit</th>
        <th>Door 4<br/>Outer Exit</th>
      </tr>
      <tr>
        <td>Check condition of brush/rubber seals</td>
        <td></td><td></td><td></td><td></td>
      </tr>
      <tr>
        <td>Check and adjust door guides</td>
        <td></td><td></td><td></td><td></td>
      </tr>
      <tr>
        <td>Check brake distance open/close</td>
        <td></td><td></td><td></td><td></td>
      </tr>
      <tr>
        <td>Check door alignment</td>
        <td></td><td></td><td></td><td></td>
      </tr>
      <tr>
        <td>Check door clearances</td>
        <td></td><td></td><td></td><td></td>
      </tr>
      <!-- Repeat rows as needed -->
    </table>

    <!-- Additional Comments -->
    <h3>Additional Comments</h3>
    <table>
      <tr><td style="height:80px;"></td></tr>
    </table>

    <!-- Signatures -->
    <table class="signatureTable">
      <tr>
        <td class="label">Store Manager Signature</td>
        <td></td>
      </tr>
      <tr>
        <td class="label">Technician Signature</td>
        <td></td>
      </tr>
    </table>

    <!-- Store Stamp & Next Service -->
    <table>
      <tr>
        <td class="label">Store Stamp</td>
        <td style="height:60px;"></td>
      </tr>
      <tr>
        <td class="label">Next Service Due</td>
        <td></td>
      </tr>
    </table>

  </body>
</pdf>
