<html>
<head>
  <style type="text/css">
    body { font-family: Helvetica, sans-serif; font-size: 11px; margin: 40px; }
    .container { width: 100%; }
    .company-info, .client-info { width: 100%; margin-bottom: 20px; }
    .company-info h2 { margin: 0; }
    .invoice-table, .totals-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    .invoice-table th, .invoice-table td, .totals-table td {
      border: 1px solid #ccc; padding: 8px; text-align: left;
    }
    .invoice-table th { background-color: #f0f0f0; }
    .totals-table { margin-top: 10px; }
    .totals-table td:last-child { text-align: right; }
    .note { margin-top: 30px; font-style: italic; }
    .footer { text-align: center; font-size: 10px; margin-top: 40px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="company-info">
      <h2>${companyInformation.companyname}</h2>
      <p>${companyInformation.address1}, ${companyInformation.city}, ${companyInformation.state}</p>
    </div>

    <div class="client-info">
      <p><strong>Invoice:</strong> ${record.tranid}</p>
      <p><strong>Date:</strong> ${record.trandate}</p>
      <p><strong>Due Date:</strong> ${record.duedate}</p>
      <p><strong>Customer:</strong> ${record.entity}</p>
    </div>

    <table class="invoice-table">
      <tr>
        <th>Description</th>
        <th>Qty</th>
        <th>Rate</th>
        <th>Total</th>
      </tr>
      <#list record.item as item>
        <tr>
          <td>${item.description}</td>
          <td>${item.quantity}</td>
          <td>${item.rate}</td>
          <td>${item.amount}</td>
        </tr>
      </#list>
    </table>

    <table class="totals-table">
      <tr><td>Subtotal</td><td>${record.subtotal}</td></tr>
      <tr><td>Tax</td><td>${record.taxtotal}</td></tr>
      <tr><td><strong>Total</strong></td><td><strong>${record.total}</strong></td></tr>
    </table>

    <p class="note">Note: This invoice is valid as per Article 774 of the Commercial Code. Late payments may incur interest.</p>

    <div class="footer">
      Printed by ${companyInformation.companyname} using NetSuite
    </div>
  </div>
</body>
</html>
