<#assign baseURL = "https://5238530-sb2.app.netsuite.com">
<#assign imageList = images.imageList>

<h2>Images (${imageList?size})</h2>

<#if imageList?size == 0>
  <p>No images found.</p>
<#else>

  <table class="img-table" border="1">
    <tr>

    <#list imageList as result>
      <td>
        <#if result.values['file.url']?has_content>

          <img src="${baseURL}${result.values['file.url']}"
               style="width:120px; height:auto;" />

        </#if>
      </td>

      <#-- Break row after every 3 images -->
      <#if (result?index + 1) % 3 == 0>
        </tr><tr>
      </#if>

    </#list>

    </tr>
  </table>

</#if>

