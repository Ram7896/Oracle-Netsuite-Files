<#if images.imageList?has_content>

<h3 style="font-size:14pt; font-weight:bold; margin-bottom:10px;">
    Job Images
</h3>

<table width="100%" style="table-layout:fixed; border-collapse:separate; border-spacing:10px;">

    <#assign col = 0>

    <#list images.imageList as img>

        <#if col == 0>
            <tr>
        </#if>

        <td width="33%" valign="top" align="center">

            <table width="100%" style="border-collapse:collapse;">

                <!-- IMAGE -->
                <tr>
                    <td align="center">
                        <img
                            src="${img.url?replace('&','&amp;')}"
                            width="220"
                            height="160"
                            style="border:1px solid #cccccc;"
                        />
                    </td>
                </tr>

                <!-- DESCRIPTION -->
                <tr>
                    <td style="
                        font-size:9pt;
                        padding-top:5px;
                        text-align:left;
                        word-wrap:break-word;
                        line-height:12px;
                    ">
                        ${img.description!''?html}
                    </td>
                </tr>

            </table>

        </td>

        <#assign col = col + 1>

        <#if col == 3>
            </tr>
            <#assign col = 0>
        </#if>

    </#list>

    <!-- Empty cells for last row -->
    <#if col != 0>
        <#list col..2 as i>
            <td width="33%"></td>
        </#list>
        </tr>
    </#if>

</table>

</#if>
