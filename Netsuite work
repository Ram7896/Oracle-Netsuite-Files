/**
 * @NApiVersion 2.1
 * @NScriptType ClientScript
 */

define([
'N/currentRecord',
'N/url'
],

function(
currentRecord,
url
){

function fieldChanged(context){

if(
context.fieldId===
'custpage_vendor'
){

var rec=
currentRecord.get();

var vendor=
rec.getValue({
fieldId:
'custpage_vendor'
});


window.location=
url.resolveScript({

scriptId:
'customscript_vendor_portal_suitelet',

deploymentId:
'customdeploy_vendor_portal_suitelet',

params:{

custpage_vendor:
vendor

}

});

}

}

return{
fieldChanged:
fieldChanged
};

});
