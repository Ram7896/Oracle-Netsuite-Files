define(['N/record', 'N/log'], (record, log) => {

    const afterSubmit = (context) => {

        log.audit({
            title: 'SCRIPT STARTED',
            details: {
                eventType: context.type,
                recordId: context.newRecord.id
            }
        });

        if (context.type !== context.UserEventType.EDIT) {
            log.debug({
                title: 'EXITING SCRIPT',
                details: 'Not CREATE Event'
            });
            return;
        }

        try {

            const rmaRecord = context.newRecord;

            const rmaId = rmaRecord.id;
            const customerId = String(rmaRecord.getValue('entity'));
            const tranDate = rmaRecord.getValue('trandate');
            const poNumber = rmaRecord.getValue('otherrefnum');
            const returnReason = String(rmaRecord.getValue('custbody17'));
            const location = String(rmaRecord.getValue('location'));

            log.audit({
                title: 'RMA HEADER VALUES',
                details: {
                    rmaId,
                    customerId,
                    tranDate,
                    poNumber,
                    returnReason,
                    location
                }
            });

            const targetCustomers = ['4038', '4039'];

            const customerMatch = targetCustomers.includes(customerId);
            const reasonMatch = returnReason === '22';
            const locationMatch = (location === '68' || location === '26');

            log.audit({
                title: 'VALIDATION RESULT',
                details: {
                    customerMatch,
                    reasonMatch,
                    locationMatch
                }
            });

            if (!(customerMatch && reasonMatch && locationMatch)) {

                log.audit({
                    title: 'CRITERIA NOT MET',
                    details: {
                        customerId,
                        returnReason,
                        location
                    }
                });

                return;
            }

            log.audit({
                title: 'CRITERIA MATCHED',
                details: 'Creating Replacement Sales Order'
            });

            const soRec = record.create({
                type: record.Type.SALES_ORDER,
                isDynamic: true
            });

            log.debug({
                title: 'SO CREATED',
                details: 'Empty Sales Order Record Created'
            });

            soRec.setValue({
                fieldId: 'entity',
                value: customerId
            });

            log.debug({
                title: 'SO CUSTOMER SET',
                details: customerId
            });

            if (location) {
                soRec.setValue({
                    fieldId: 'location',
                    value: location
                });

                log.debug({
                    title: 'SO LOCATION SET',
                    details: location
                });
            }

            if (tranDate) {
                soRec.setValue({
                    fieldId: 'trandate',
                    value: tranDate
                });

                log.debug({
                    title: 'SO TRANDATE SET',
                    details: tranDate
                });
            }

            if (poNumber) {
                soRec.setValue({
                    fieldId: 'otherrefnum',
                    value: poNumber
                });

                log.debug({
                    title: 'SO PO NUMBER SET',
                    details: poNumber
                });
            }

            const lineCount = rmaRecord.getLineCount({
                sublistId: 'item'
            });

            log.audit({
                title: 'RMA ITEM COUNT',
                details: lineCount
            });

            let addedLines = 0;

            for (let i = 0; i < lineCount; i++) {

                const itemId = rmaRecord.getSublistValue({
                    sublistId: 'item',
                    fieldId: 'item',
                    line: i
                });

                const quantity = rmaRecord.getSublistValue({
                    sublistId: 'item',
                    fieldId: 'quantity',
                    line: i
                });

                log.debug({
                    title: `RMA LINE ${i}`,
                    details: {
                        itemId,
                        quantity
                    }
                });

                if (!itemId || !quantity) {

                    log.debug({
                        title: `SKIPPING LINE ${i}`,
                        details: 'Item or Quantity Missing'
                    });

                    continue;
                }

                soRec.selectNewLine({
                    sublistId: 'item'
                });

                soRec.setCurrentSublistValue({
                    sublistId: 'item',
                    fieldId: 'item',
                    value: itemId
                });

                soRec.setCurrentSublistValue({
                    sublistId: 'item',
                    fieldId: 'quantity',
                    value: quantity
                });

                soRec.setCurrentSublistValue({
                    sublistId: 'item',
                    fieldId: 'rate',
                    value: 0
                });

                soRec.commitLine({
                    sublistId: 'item'
                });

                addedLines++;

                log.debug({
                    title: `SO LINE ADDED ${i}`,
                    details: {
                        itemId,
                        quantity
                    }
                });
            }

            log.audit({
                title: 'TOTAL SO LINES ADDED',
                details: addedLines
            });

            if (addedLines === 0) {

                log.error({
                    title: 'NO ITEMS ADDED TO SALES ORDER',
                    details: 'Aborting Save'
                });

                return;
            }

            log.audit({
                title: 'SAVING SALES ORDER',
                details: 'Save Started'
            });

            const salesOrderId = soRec.save({
                enableSourcing: true,
                ignoreMandatoryFields: false
            });

            log.audit({
                title: 'SALES ORDER CREATED',
                details: salesOrderId
            });

            
            record.submitFields({
                type: record.Type.RETURN_AUTHORIZATION,
                id: rmaId,
                values: {
                    orderstatus: 'H',
                    custbody_fmt_tg_rma_op: salesOrderId
                }
            });
            
            log.audit({
                title: 'RMA CLOSED SUCCESSFULLY',
                details: {
                    rmaId: closedRmaId,
                    linkedSalesOrder: salesOrderId
                }
            });

        } catch (error) {

            log.error({
                title: 'ERROR DETAILS',
                details: {
                    name: error.name,
                    message: error.message,
                    stack: error.stack
                }
            });

        }
    };

    return {
