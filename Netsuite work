<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>

  <head>
    <style>
      body {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 10pt;
        font-weight: normal;
      }

      .headerTable {
        width: 100%;
        table-layout: fixed;
      }

      h1 {
        font-size: 18pt;
        text-transform: uppercase;
        text-decoration: underline;
        margin-bottom: 10px;
      }

      table {
        width: 130%;
        border-collapse: collapse;
        margin-bottom: 10px;
      }

      th,
      td {
        width: 25%;
        font-weight: bold;
        padding: 4px;
      }

      th {
        background-color: #EEE;
        text-align: center;
        font-weight: bold;
        border: 0.5px;
      }

      td {
        padding: 4px;
      }

      td.label {
        width: 25%;
        font-weight: bold;
        background-color: #f5f5f5;
      }

      .headerTable td {
        border: none;
        font-size: 10pt;
        border: 0.5px;
        font-weight: normal;
      }

      .checklistTable {
        table-layout: fixed;
      }

      .checklistTable th {
        background-color: #d3d3d3;
      }

      .headerTable.label {
        font-size: 8px;
        background-color: #d3d3d3;
      }

      .signatureTable td {
        height: 35px;
      }

      .logoCell {
        vertical-align: middle;
        text-align: center;
        padding: 0;
        margin: 0;
      }
    </style>
    <macrolist>
      <macro id="ai_footer">
        <table class="footerTable" width="100%">
          <tr>
            <td width="33%"></td>
            <td width="34%" align="center" style="text-align:center; font-size:10pt;">
              Page
              <pagenumber /> of
              <totalpages />
            </td>
            <td width="33%"></td>
          </tr>
        </table>
      </macro>
    </macrolist>
  </head>

  <body header="ai_header" header-height="5%" font-size="10" font-family="Helvetica" footer="ai_footer">
    <!-- Appendix A Section -->
      <#assign baseURL = "https://5238530-sb2.app.netsuite.com">
  <table>
  <tr class="row" style="vertical-align: middle;">
    <td class="logoCell">
      <!-- Image element with updated size -->
      <img src="${baseURL + img.logo?xml}" width="240" height="100" />
    </td>
  </tr>
</table>
    <!-- Header Section -->
    <h2 style="margin-bottom:10px;">1.&nbsp;&nbsp;&nbsp;AUTOMATIC ENTRY DOOR</h2>

    <!-- Header Info with Logo -->
    <table class="headerTable">
      <tr class="row">
        <td class="label">Company</td>
        <td class="label">Technician Name</td>
        <td>${technician.name}</td>
      </tr>
      <tr class="row" style="vertical-align: middle;">
        <!-- Logo spans two rows -->
        <td rowspan="3" class="logoCell"
          style="padding: 0; margin: 0; vertical-align: top; vertical-align: top; text-align: left; display: block;">
          <img src="${subsidiary.pagelogo@url}" width="230px" height="70px"
            style="display: block; vertical-align: top; margin: 0; border: 0; display: block;" />
        </td>
        <td class="label">Store Name</td>
        <td>${case.custevent_nx_case_asset}</td>
      </tr>
      <tr>
        <td class="label">Date of Service</td>
        <td></td>
      </tr>
      <tr>
        <td class="label">Service of Month / Case Number</td>
        <td>${date_str.data} / ${case.casenumber}</td>
      </tr>
    </table>
    <!-- General Instructions -->
    <table class="headerTable">
      <tr>
        <td style="width: 7%;"><b>General Items</b></td>
        <td style="font-size:10px; vertical-align: middle; padding:4px">
          When arriving to/departing from site the technician must sign into Rapid Global or equivalent ALDI Contractor
          Management System (CMS).<br />
          The technician must check into ServiceChannel and then checkout upon completion.<br />
          Enquire with staff as to performance of system and any specific issues that need attention.<br />
          Record and notify store staff of any issues that need to be addressed.
        </td>
      </tr>
      <tr>
        <td><b>PO Number</b></td>
        <td>${case.custevent_nx_case_purchaseorder}</td>
      </tr>
    </table>
    <#-- TASK LIST (one place to modify tasks) -->
      <#assign taskList=[ "Check condition of brush/rubber seals" , "Check and adjust door guides"
        , "Check brake distance open/close" , "Check door alignment" , "Check door clearances"
        , "Check that covers are secured" , "Check door leaves and sidelights and adjust as required"
        , "Check the integrity of the holding point fixings" , "Check all moving parts for signs of wear"
        , "Check electrical components and replace if necessary" , "Test electric locking system"
        , "Check motor and gearbox function and operation" , "Check anti crush operation and ensure correct opening"
        , "Check the failsafe mechanism/inverter system" , "Check microcomputer control unit and adjust if necessary"
        , "Check alignment and tune the photo electric beams and activation sensors"
        , "Test emergency opening under power failure conditions" , "Check for loose or damaged glass"
        , "Tighten all loose nuts, bolts, and electrical terminations"
        , "Check power supply, check battery condition and record voltage" , "Record battery date (photo required)"
        , "Check and secure wiring" , "Clean track and check bottom guide rail" , "Clean track wheels"
        , "Check for finger, head, and body traps as per AS5007" , "Clean area"
        , "Check for vermin gaps under/around doors" , "Ensure service sticker attached with correct dates"
        , "Document any damage to the door" , "Review last battery replacement; replace if older than 2 years" ] />


      <table class="headerTable" style="width:100%; border-collapse:collapse;">

        <!-- Header Row 1 -->
        <tr>
          <th rowspan="2"
            style="text-align: center; vertical-align: middle; font-weight: bold; border: 0.5px solid #000; padding: 60px;">
            Task</th>
          <th colspan="${sub_assets.data?size}" align="center" font-size="10px"
            style="text-align: center; vertical-align: middle; font-weight: bold; border: 0.5px solid #000; padding: 10px;">
            Complete (Y/N)
          </th>
        </tr>

        <!-- Header Row 2 -->
        <tr>
          <#list sub_assets.data as asset>
            <th style="text-align:center; border:0.5px solid #000;">
              <b>${asset.name}</b>
            </th>
          </#list>
        </tr>


        <!-- SINGLE LOOP FOR ALL TASK ROWS -->
        <#list taskList as task>
          <tr>
            <td>${task}</td>

            <#-- loop through assets to match dynamic column count -->
              <#list sub_assets.data as a>
                <td></td>
              </#list>

          </tr>
        </#list>


        <!-- NSW LABEL ROW -->
        <tr>
          <td class="label" style="font-weight:bold;" colspan="${1 + sub_assets.data?size}">
            NSW STORES ONLY
          </td>
        </tr>

        <!-- NSW tasks (same system) -->
        <#assign nswTasks=[ "Restore power and set doors to 'lock' mode"
          , "Check doors open upon manual activation of the green push button" ] />

        <#list nswTasks as t>
          <tr>
            <td>${t}</td>
            <#list sub_assets.data as a>
              <td></td>
            </#list>
          </tr>
        </#list>

      </table>
 <!-- Spacer for extra space -->
      <div style="height:20px;"></div>
      <!-- Additional Comments -->
      <table class="headerTable" width="100%">
        <tr>
          <td class="label" style="font-weight:bold; width:30%;">Additional Comments</td>
        </tr>
        <tr>
          <td style="height:150px; vertical-align:top; font-size:10pt;">
          </td>
        </tr>
      </table>

      <!-- Spacer for extra space -->
      <div style="height:70px;"></div>

      <!-- Signatures -->
      <table class="headerTable" width="100%">
        <tr>
          <td class="label" style="width:30%; height:30%;">Store Manager Signature</td>
          <td style="height:70px;"></td>
        </tr>
        <tr>
          <td class="label" style="width:30%; height:30%">Technician Signature</td>
          <td style="height:70px;"></td>
        </tr>
        <tr>
          <td class="label" style="width:30%; height:30%">Arrival Time</td>
          <td style="height:70px;"></td>
        </tr>
        <tr>
          <td class="label" style="width:30%; height:30%">Departure Time</td>
          <td style="height:70px;"></td>
        </tr>
      </table>

  <!-- Page break before additional comments -->
      <div style="page-break-before: always;"></div>
      <!-- ========================= -->

<#if flagged_names?? && flagged_names.data?has_content>
 <table>
   <tr class="row" style="vertical-align: middle;">
    <td class="logoCell">
      <!-- Image element with updated size -->
      <img src="${baseURL + sliding.logo?xml}" width="240" height="100" />
    </td>
  </tr>
</table>
