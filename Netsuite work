<#if images.imageList?has_content>

<h3 style="font-size:12pt; margin-top:15px;">Job Images</h3>

<table style="width:100%; table-layout:fixed; border-collapse:separate; border-spacing:10px;">

    <#assign col = 0>

    <#list images.imageList as img>

        <#if col == 0>
            <tr>
        </#if>

        <td align="center" valign="top" style="width:33%; padding:5px;">

            <!-- IMAGE -->
            <img 
                src="${img.url?replace('&','&amp;')}" 
                width="200" 
                height="150"
                style="border:1px solid #cccccc;"
            />

            <!-- DESCRIPTION -->
            <div style="
                font-size:9pt;
                margin-top:6px;
                width:200px;
                text-align:left;
                word-wrap:break-word;
                line-height:12px;
            ">
                ${img.description?html}
            </div>

        </td>

        <#assign col = col + 1>

        <#if col == 3>
            </tr>
            <#assign col = 0>
        </#if>

    </#list>

    <!-- EMPTY CELLS -->
    <#if col != 0>
        <#list col..2 as i>
            <td style="width:33%;"></td>
        </#list>
        </tr>
    </#if>

</table>

</#if>
