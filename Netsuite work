    /**
     * Searches system for under-contract projects related to a given parent 
     *     project and gathers an object representing all maintenance costs 
     *     associated with a visit under this project.
     * @memberof aiCostTools
     *
     * @param {InternalId} project_id - Internal id of the parent project whose 
     *     visit costs are to be calculated.
     * @returns {Array.<MaintenanceRate>} - List of maintenance charges with the
     *     number of corresponding assets for each.
     */
    function gatherMaintenanceCosts(project_id) {
      var maint_costs = {};
      var proj_search = search.create({
        type: search.Type.JOB,
        filters: [
          // '6' Under Contract
          ['custentity_nx_project_type', search.Operator.IS, '6'],
          'AND',
          ['custentity_ai_parent_id', search.Operator.IS, project_id],
          'AND',
          ['status', search.Operator.NONEOF, ['1']], // '1' Closed
          'AND',
          ['isinactive', search.Operator.IS, 'F'],
        ],
        columns: [
          'custentity_nxc_maint_charge',
          'custentity_nx_asset',
        ],
      }).run().each( function(result) {
        var cost = result.getValue({name: 'custentity_nxc_maint_charge'});
        var cost_name = result.getText({name: 'custentity_nxc_maint_charge'});
        var asset_id = result.getValue({name: 'custentity_nx_asset'});
        if ( !maint_costs[cost] ) {
          maint_costs[cost] = {
            sub_assets: [asset_id],
            name: cost_name,
            id: cost,
          };
        } else {
           maint_costs[cost].sub_assets.push(asset_id);
        }
        return true;
      });

      var keys = Object.keys(maint_costs);
      maint_costs = keys.map( function(key) { return maint_costs[key]; });

      if ( maint_costs.length == 0 ) {
        maint_costs = null;
      }

      return maint_costs;
    } // end gatherMaintenanceCosts

    /**
     * Callout and Labour rates to be used.
     * @typedef {Object} ServiceRates
     * @property {InternalId} callout - The Callout item record to be used.
     * @property {InternalId} labour - The Labour item record to be used.
     */

    /** 
     * Calculates special labour/callout rates for a given customer and a given 
     *     case priority. 
     * @memberof aiCostTools
     *
     * @param {InternalId} customer_id - The Customer record in question.
     * @param {InternalId} case_priority - The Callout Priority record set on 
     *     the case in question.
     * @returns {ServiceRates} - The labour and callout items to be used as per
     *     the settings on the customer record.
     **/
    function gatherServiceRates(customer_id, case_priority) {
      // Extract priority codes from case_priority
      var priority_callout_map = {'1': 'P1', '2': 'P2', '3': 'P3', '4': 'AH'};
      var callout_code = priority_callout_map[case_priority];
      callout_code = callout_code == undefined ? 'AH' : callout_code;
      var labour_code = case_priority == '4' ? 'AH' : 'STD';

      // Search customer_id's special rates field for matching callout & 
      // labour items
      var special_rates = search.lookupFields({
        type: search.Type.CUSTOMER,
        id: customer_id,
        columns: ['custentity_ai_special_rates'],
      }).custentity_ai_special_rates;
      var callout_item = null;
      var labour_item = null;
      special_rates.forEach( function(rate) {
        if ( rate.text.indexOf('Callout Fee') != -1 && 
            rate.text.indexOf( callout_code ) != -1 ) {
          callout_item = rate.value;
        }
        if ( rate.text.indexOf('Labour') != -1 &&
            rate.text.indexOf( labour_code ) != -1 ) {
          labour_item = rate.value;
        }
      });

      // If no items have been found under the customer, set the default items
      var default_labour_map = { 'STD': '2647', 'AH': '2646' };
      if ( labour_item == null ) {
        labour_item = default_labour_map[labour_code];
      }
      var default_callout_map =
          {'P1': '2643', 'P2': '2644', 'P3': '2645', 'AH': '2642'};
      if ( callout_item == null ) {
        callout_item = default_callout_map[callout_code];
      }

      // Return 1 callout and 1 labour item
      return {callout: callout_item, labour: labour_item};
    } // end gatherServiceRates

    /**
     * An object containing key details about an asset testing.
     * @typedef {Object} AssetTesting
     * @property {InternalId} id - The internal id of the testing record.
     * @property {string} date - The date the testing was created.
     * @property {InternalId} task - The task the testing is related to.
     * @property {InternalId} asset - The asset the testing is related to.
     * @property {string} outcome - The outcome of the testing.
     * @property {string} details - Any additional details added to the testing.
     * @property {string} rating - The rating the asset was given.
     */

    /**
     * Obtains all asset testing records attached to the provided case.
     * @memberof aiCostTools
     *
     * @param {InternalId} case_id - The case who's testings are to be gathered.
     * @param {boolean} [duplicates=false] - Decide whether to clean out
     *     duplicate testings and only return the most recent for each asset.
     * @returns {Array.<AssetTesting>} - An array containing key asset testing 
     *     details.
     */
    function gatherAssetTestings(case_id, duplicates) {
      if ( duplicates == undefined ) duplicates = false;
      var asset_testings = [];
      search.create({
        type: 'customrecord_nxc_asset_testing',
        filters: [
          ['custrecord_at_nxc_case', search.Operator.IS, case_id],
        ],
        columns: [
          {name: 'internalid'},
          {name: 'created', sort: search.Sort.DESC}, // Oldest tests at bottom
          {name: 'custrecord_at_nxc_task'},
          {name: 'custrecord_at_nxc_asset'},
          {name: 'custrecord_at_nxc_outcome'},
          {name: 'custrecord_at_nxc_details'},
          {name: 'custrecord_at_nxc_rating'},
        ]
      }).run().each( function(result) {
        var id = result.getValue({name: 'internalid'});
        var date = result.getValue({name: 'created'});
        var task = result.getValue({name: 'custrecord_at_nxc_task'});
        var outcome = result.getValue({name: 'custrecord_at_nxc_outcome'});
        var details = result.getValue({name: 'custrecord_at_nxc_details'});
        var rating = result.getValue({name: 'custrecord_at_nxc_rating'});
        var asset = result.getValue({name: 'custrecord_at_nxc_asset'});
        asset_testings.push({
          id: id,
          date: date,
          task: task,
          asset: asset,
          outcome: outcome,
          details: details,
          rating: rating,
        });
        return true;
      });

      if ( duplicates ) {
        var new_testings = [];
        asset_testings.forEach( function(test) {
          // Oldest tests are at the bottom, so the first matching test is also
          // the most recent.
          var missing = undefined == new_testings.find( function(el) {
            return el.asset == test.asset;
          });
          if ( missing ) new_testings.push(test); 
        });
        asset_testings = new_testings;
      }

      return asset_testings;
    } // end gatherAssetTestings

    /**
     * Identifies maintenance cases due for completion in the same month as the 
     *     provided case. Checks whether the provided case has tested all the 
     *     same assets, if so collects details about the maintenance cases found
     *     ready for them to be closed out/merged.
     * @memberof aiCostTools
     *
     * @param {CaseDetails} case_details - Key details about the case currently
     *     being processed.
     * @returns {Array.<CaseDetails>} - Array of key details about any cases 
     *     that meet the criteria that would require they be closed. Some
     *     standard CaseDetails parameters are missing as not needed.
     */
    function checkForMaintenanceCasesToMerge(case_details) {
      var cases = [];
      search.create({
        type: search.Type.SUPPORT_CASE,
        filters: [
          ['custevent_nx_customer', search.Operator.IS, case_details.customer],
          'AND',
          ['custevent_nx_case_type', search.Operator.ANYOF, ['1', '6']],
          'AND',
          ['custevent_nx_case_asset', search.Operator.IS, case_details.asset],
          'AND',
          ['status', search.Operator.NONEOF, ['5']],
        ],
        columns: [
          'company.custentity_nxc_sub_assets',
          'startdate',
          'internalid',
          'custevent_nx_case_purchaseorder',
          'company',
        ],
      }).run().each( function(result) {
        // Check if case is older than current one
        var date = result.getValue({name: 'startdate'});
        var date_arr = date.split(' ')[0].split('/');
        var date_str = date_arr[2] + date_arr[1];
        var case_date_arr = case_details.date.split(' ')[0].split('/');
        var case_date_str = case_date_arr[2] + case_date_arr[1];
        if ( date_str <= case_date_str ) {
          // Check if all assets on maintenance case have been tested on current
          // breakdown case
          var sub_assets = result.getValue({
            join: 'company', name: 'custentity_nxc_sub_assets'
          });
          if ( sub_assets ) {
            sub_assets = sub_assets.split(',');
            var missing_test = false;
            sub_assets.forEach( function(asset) {
              var located_test = case_details.tests.find( function(test) {
                return test.asset == asset;
              });
              if ( !located_test ) missing_test = true;
            });
            if ( !missing_test ) {
              // Push case onto list to be merged
              var id = result.getValue({name: 'internalid'});
              var project = result.getValue({name: 'company'});
              var po = result.getValue({
                  name: 'custevent_nx_case_purchaseorder'});
              log.debug({title: 'mergeable case id', details: id});
              cases.push({po: po, id: id, project: project});
            }
          }
        }
        return true;
      });
      return cases;
    } // end checkForMaintenanceCasesToMerge

    /**
     * Adds a user not to the provided activity type record.
     * @memberof aiCostTools
     *
     * @param {InternalId} rec_id - The record the note is to be attached to.
     * @param {string} title - The title for the note.
     * @param {string} note - The message for the note.
     */
    function addUserNoteAct( rec_id, title, note ) {
      var user_note = record.create({ type: record.Type.NOTE });
      user_note.setValue({ fieldId: 'title', value: title });
      user_note.setValue({ fieldId: 'activity', value: rec_id });
      user_note.setValue({ fieldId: 'note', value: note });
      user_note.save();
    } // end addUserNoteAct

