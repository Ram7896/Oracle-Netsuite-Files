var case_joins = search.lookupFields({
    type: record.Type.SUPPORT_CASE,
    id: params.case_id,
    columns: [
        'custevent_case_asset_site_notes'
    ]
});

var siteNotes = case_joins.custevent_case_asset_site_notes || '';
log.debug("Raw Site Notes", siteNotes);

// Remove *
var cleanedNotes = siteNotes.replace(/\*/g, '').trim();
log.debug("Cleaned Notes", cleanedNotes);

// Convert multi-line text into array (line by line)
var siteDetails = cleanedNotes.split(/\r?\n/);

renderer.addCustomDataSource({
    format: render.DataSource.OBJECT,
    alias: 'siteNotes',
    data: {
        list: siteDetails
    }
});
<table class="headerTable" style="width:100%; border-collapse: collapse;">
    <tr>
        <th style="border:1px solid #000; padding:5px;">Details</th>
    </tr>

    <#if siteNotes.list?has_content>
        <#list siteNotes.list as note>
            <tr>
                <td style="border:1px solid #000; padding:5px;">
                    ${note}
                </td>
            </tr>
        </#list>
    </#if>
</table>
