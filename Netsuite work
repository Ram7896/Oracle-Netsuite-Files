<macro id="nlfooter">
<table style="width: 100%; font-size: 9pt; border-top: 1px solid #000; padding-top: 5px;">
    <tr>
        <!-- Left side: Direct Deposit Details -->
        <td style="width: 70%; vertical-align: top;">
            <p style="font-size: 9px; font-weight: bold; margin: 0;">Direct Deposit Details</p>
            <p style="margin: 0; font-size: 9px;">Bank Name: ${record.custbody_bank_name}</p>
            <p style="margin: 0; font-size: 9px;">Account Number: ${record.custbody_account_number}</p>
            <p style="margin: 0; font-size: 9px;">IFSC Code: ${record.custbody_ifsc_code}</p>
        </td>

        <!-- Right side: Invoice No + QR Code -->
        <td rowspan="2" style="width: 30%; text-align: center; vertical-align: middle;">
            <p style="font-size: 9px; font-weight: bold; margin: 0 0 6px 0;">
                Invoice No. ${record.tranid}
            </p>
            <barcode codetype="qrcode" showtext="false" height="120" width="120" 
                value="http://www.example.com/"/>
        </td>
    </tr>

    <!-- Second row for extra notes -->
    <tr>
        <td style="width: 70%; vertical-align: top;">
            <p style="margin: 0; font-size: 8px; color: gray;">
                Payment to be made within 30 days unless otherwise agreed.
            </p>
        </td>
    </tr>
</table>
</macro>

