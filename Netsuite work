/**
 * aiGenerateCaseReport.js
 * @NApiVersion 2.1
 * @NModuleScope Public
 */
define(['N/render', 'N/record', 'N/file', 'N/search'],
function (render, record, file, search) {

  function generateReport(case_id, template_id) {

    var renderer = render.create();

    var case_rec = record.load({
      type: record.Type.SUPPORT_CASE,
      id: case_id
    });

    // ✅ Add Case + Site
    renderer.addRecord({
      templateName: 'case',
      record: case_rec
    });

    renderer.addRecord({
      templateName: 'site',
      record: record.load({
        type: 'customrecord_nx_asset',
        id: case_rec.getValue({ fieldId: 'custevent_nx_case_asset' })
      })
    });

    // ✅ Visits (Tasks)
    var tasks = search.create({
      type: search.Type.TASK,
      filters: [
        ['case.internalid', 'is', case_rec.id],
        'AND',
        ['custevent_nx_task_type', 'is', '1'],
        'AND',
        ['status', 'is', 'COMPLETE']
      ],
      columns: [
        'internalid',
        'title',
        search.createColumn({ name: 'startdate', sort: search.Sort.ASC }),
        'custevent_nxc_arrival_time',
        'assigned',
        'custevent_nxc_departure_time',
        'custevent_nx_actions_taken',
        'custevent_nxc_customer_name',
        'custevent_nxc_customer_signature',
        'custevent_nxc_technician_signature',
        'message'
      ]
    }).run().getRange(0, 1000);

    renderer.addSearchResults({
      templateName: 'visits',
      searchResult: tasks
    });

    // ✅ IMAGES (FIXED)
    var images = [];

    var files_search = search.create({
      type: search.Type.TASK,
      filters: [
        ['case.internalid', 'anyof', case_rec.id],
        'AND',
        ['status', 'anyof', 'COMPLETE']
      ],
      columns: [
        search.createColumn({ name: 'internalid', join: 'file' }),
        search.createColumn({ name: 'url', join: 'file' }),
        search.createColumn({ name: 'name', join: 'file' })
      ]
    }).run().getRange({ start: 0, end: 1000 });

    if (files_search && files_search.length > 0) {

      images = files_search.map(function (r) {

        var fileId = r.getValue({ name: 'internalid', join: 'file' });
        var fileUrl = r.getValue({ name: 'url', join: 'file' });

        // 🔥 Make file public (required for PDF)
        if (fileId) {
          try {
            var fileObj = file.load({ id: fileId });
            fileObj.isOnline = true;
            fileObj.save();
          } catch (e) {
            log.error('File Public Error', e);
          }
        }

        return {
          file: {
            id: fileId,
            url: fileUrl,
            name: r.getValue({ name: 'name', join: 'file' })
          }
        };
      });

      renderer.addCustomDataSource({
        format: render.DataSource.OBJECT,
        alias: 'images',
        data: { imageList: images }
      });
    }

    // ✅ TEMPLATE
    var template_file_id = template_id || '714151';

    renderer.templateContent = file.load({
      id: template_file_id
    }).getContents();

    var report = renderer.renderAsPdf();

    report.name = 'Case Report ' + case_rec.getValue('casenumber') + '.pdf';

    return report;
  }

  return {
    generateReport: generateReport
  };
});



