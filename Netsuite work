/**
 * @NApiVersion 2.1
 * @NScriptType ClientScript
 */
define(['N/currentRecord'], function (currentRecord) {

    function pageInit(context) {
        var rec = context.currentRecord;
        toggleFields(rec);
    }

    function fieldChanged(context) {
        if (context.fieldId === 'custentity_service_agent') {
            var rec = context.currentRecord;
            toggleFields(rec);
        }
    }

    function toggleFields(rec) {
        var serviceAgent = rec.getValue({ fieldId: 'custentity_service_agent' });
        var categoryFieldId = 'custentity_category'; // Replace with actual field id
        var cat3InternalId = 3; // replace with internalId of CAT3 in your Category list

        var pricingFields = [
            'custentity_labour_rate',
            'custentity_callout_fee',
            'custentity_other_fee'
            // add all pricing field IDs
        ];

        if (serviceAgent) { // YES
            // Force Category = CAT3
            rec.setValue({
                fieldId: categoryFieldId,
                value: cat3InternalId
            });

            // Show pricing fields
            pricingFields.forEach(function (fld) {
                var fObj = rec.getField({ fieldId: fld });
                if (fObj) fObj.isDisplay = true;
            });
        } else { // NO
            // Keep Category untouched (assume already CAT3)

            // Hide pricing fields
            pricingFields.forEach(function (fld) {
                var fObj = rec.getField({ fieldId: fld });
                if (fObj) fObj.isDisplay = false;
            });
        }
    }

    return {
        pageInit: pageInit,
        fieldChanged: fieldChanged
    };
});
