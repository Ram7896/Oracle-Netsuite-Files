/**
 * @NApiVersion 2.x
 * @NModuleScope public
 */
define(["N/https","N/search"], function (https,search) {
  function IntegrationConnection(obj_data, credId, corelation_id) {
    try {

      var date = new Date();
      var transactionDate = date.getDate();
      var transactionMonth = date.getMonth()+1;
      var transactionYear = date.getFullYear();
      var transactionTimeHour = date.getHours();
      var transactionTimeMin = date.getMinutes();
      var transactionTimeSec = date.getSeconds();
      var fullDate = transactionDate+":"+transactionMonth+":"+transactionYear+":"+transactionTimeHour+":"+transactionTimeMin+":"+transactionTimeSec;

      corelation_id = corelation_id+"_"+fullDate;
      log.debug("corelation_id",corelation_id);
      log.debug("CredRecId",credId)
      const creds = search.lookupFields({
        type:"customrecord_ada_integration_credentials",
        id: credId,
        columns: ["custrecord_ada_url","custrecord_ada_client_secret","custrecord_ada_client_id"]
      })
      
    log.debug("Obj Data",obj_data);
      var response = https.request({"method": https.Method.POST,        
    "url": creds.custrecord_ada_url,
    "body": JSON.stringify(obj_data),
    "headers":{
          "Content-Type": "application/json",
          "client_id":  creds.custrecord_ada_client_id,
          "client_secret": creds.custrecord_ada_client_secret,
          "x-correlation-id":corelation_id ? corelation_id : "",
          "Accept":"*/*"
        }
});
log.debug("Mulesoft Response",response);
var myresponse_body = response.body; // see https.ClientResponse.body
var myresponse_code = response.code; // see https.ClientResponse.code
var myresponse_headers = response.headers; // see https.Clientresponse.headers

      log.debug("myresponse_body",myresponse_body)
      log.debug("myresponse_code",myresponse_code)
      log.debug("myresponse_headers",myresponse_headers)

      return myresponse_body;
      
    } catch (e) {
      log.debug("ConnectionLibraryError", e);
    }
  }
  return {
    IntegrationConnection: IntegrationConnection,
  };
});
