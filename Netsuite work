/**
 * @NApiVersion 2.1
 * @NScriptType ClientScript
 */

define([], () => {

    function fieldChanged(context) {

        var rec = context.currentRecord;
        var fieldId = context.fieldId;

        var workersFields = [
            'custentity8',
            'custentity9',
            'custentity10',
            'custentity11',
            'custentity12'
        ];

        // Run only when worker compensation fields change
        if (workersFields.indexOf(fieldId) === -1) {
            return;
        }

        var isChecked = false;

        for (var i = 0; i < workersFields.length; i++) {

            if (rec.getValue({
                fieldId: workersFields[i]
            })) {
                isChecked = true;
                break;
            }
        }

        // Replace with actual field IDs
        if (isChecked) {

            rec.setValue({
                fieldId: 'custentity_insurance',
                value: true,
                ignoreFieldChange: true
            });

            rec.setValue({
                fieldId: 'custentity_public_liability',
                value: true,
                ignoreFieldChange: true
            });

            var emailField = rec.getField({
                fieldId: 'custentity_email_insurance_to'
            });

            if (emailField) {
                emailField.isMandatory = true;
            }
        }
    }

    return {
        fieldChanged: fieldChanged
    };

});
