<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
  <head>
    <style>
      table {
        table-layout: fixed;
        font-family: Arial, Helvetica;
      }
      th {
        font-size: 8pt;
        vertical-align: middle;
      }
      h1 {
        text-transform: uppercase;
        font-family: Arial, Helvetica;
        font-size: 12pt;
        text-decoration: underline;
        padding: 0px 0px 20px 0px;
      }
      b {
        font-weight: bold;
        color: #333333;
      }
      p {
        align: left;
      }
      hr {
        width: 100%
        color: #d3d3d3;
        background-color: #d3d3d3;
        height: 1px;
      }
      body {
        font-family: Arial, Helvetica;
        font-size: 10pt;
      }
      table.page_title {
        width: 100%;
        padding: 0;
        margin: 0;
      }
      table.page_title td {
        align: right;
        valign: middle;
        font-size: 30;
        padding: 0;
        margin: 0;
      }
      table.page_title tr {
        padding: 0;
        margn: 0;
      }
      td.title {
        width: 60%;
      }
      td.number {
        font-size: 24;
      }
      td.date {
        font-size: 14;
        align: left;
      }
      table.header {
        padding: 0px;
        font-size: 6pt;
        width: 100%;
      }
      table.footer td {
        font-size: 14pt;
        font-weight: bold;
        valign: middle;
        text-transform: uppercase;
      }
      .case_info {
        background-color: #DDDDDD;
        margin: 5px 0px 5px 0px;
        width: 100%;
      }
      .case_info table {
        width: 100%;
        padding: 5px;
      }
      .visit_info {
        background-color: #EEEEEE;
        margin: 10px 0px 0px 0px;
        width: 100%;
        page-break-inside: auto;
      }
      .visit_info table {
        width: 100%;
        padding: 5px;
      }
      .break_notes {
        margin: 0;
        padding: 5px 7px 0px 7px;
        page-break-inside: auto;
        background-color: #EEEEEE;
        width: 100%;
      }
      .break_notes table {
        width: 100%;
        padding: 5px;
      }
      .cust_sig {
        border: 1px dotted black;
        margin: 5px;
      }
      .cust_sig img {
        width: 100px;
        height: 50px;
        margin: 5px;
      }
      .testings {
        font-size: 8pt;
        cellborder: 1px solid black;
        cellmargin: 0px;
        background-color: #EEEEEE;
        padding: 5px;
        width: 100%;
      }
      .testings th {
        font-weight: bold;
        align: center;
      }
      .testings td {
        align: center;
        valign: middle;
      }
      .parts {
        font-size: 8pt;
        cellborder: 1px solid black;
        cellmargin: 0px;
      }
      .parts th {
        font-weight: bold;
        align: center;
      }
      .parts td {
        align: center;
        valign: middle;
      }
      .img-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }
    .img-table td {
        text-align: center;
        vertical-align: top;
        padding: 8px;
    }
    .desc {
        font-size: 10pt;
        margin-top: 5px;
    }
    img {
        max-width: 130%;
        max-height: 150%;
    }
    </style>
    <macrolist>
      <macro id="ai_header">
        <table class="header">
          <tr>
            <td colspan="2">
                        <img src="https://5238530-sb2.app.netsuite.com/core/media/media.nl?id=519826&amp;c=5238530_SB2&amp;h=2151f31b74aa66896735"  width="250px" height="40px" style="float: left; margin: 0px; padding: 0px"/>
                    </td>
                    <td align="right">
                      <p align="right">
                      <b font-size="8pt">Auto Ingress Pty Ltd</b><br></br>
                      ABN: 53 083 047 241 / ACN: 083 047 241<br></br>
                      Email: accounts@autoingress.com.au<br></br>
                      Web: autoingress.com.au<br></br>
                    <b><i>Free Phone: 1300 138 750</i></b>
                    </p>
                    </td>
                </tr>
                <tr>
            <td>
                      <b>QLD:</b> 17-19 Cronulla Ct, SLACKS CREEK QLD 4127<br></br>
                        PO Box 825, SPRINGWOOD QLD 4127<br></br>
                      Phone (07) 3290 1500 / Fax (07) 3290 1567
                    </td>
                    <td>
                      <b>NSW:</b> Unit 6, 19-26 Durian Pl, WETHERILL PARK NSW 2164<br></br>
                        PO Box 6199, WETHERILL PARK NSW 2164<br></br>
                      Phone (02) 9756 6590 / Fax (02) 9756 5210
                    </td>
                    <td>
                      <b>VIC:</b> 37/189B South Centre Rd, TULLAMARINE VIC 3043<br></br>
                        PO Box 300, TULLAMARINE VIC 3043<br></br>
                      Phone (03) 9330 2220 / Fax (03) 9330 2228
                    </td>
                </tr>
        </table>
        <hr></hr>
        <table class="page_title">
          <tr>
            <td></td>
            <td class="title">${case.custevent_nxc_call_out_priority?replace("Outside of Hours","AH")} Repair Breakdown</td>
          </tr>
          <tr>
            <td class="date">Created Date: ${case.startdate}</td>
            <td class="number">#${case.casenumber}</td>
          </tr>
        </table>
      </macro>
      <macro id="ai_footer">
        <table align="right" class="footer">
          <tr>
            <td>Think of Us Automatically</td>
            <td><img class="small_logo" src="https://5238530-sb2.app.netsuite.com/core/media/media.nl?id=519828&amp;c=5238530_SB2&amp;h=6c28152e877a0af0da32" style="height: 50px; width: 50px"></img></td>
          </tr>
        </table>
      </macro>
    </macrolist>
  </head>
  <body header="ai_header" header-height="19%" footer="ai_footer" footer-height="3%" padding="0.5in 0.5in 0.5in 0.5in" size="A4">

    <div class="case_info">
      <table>
        <tr>
          <td><b>Customer:</b> ${case.custevent_nx_customer}</td>
        </tr>
        <tr>
          <td><b>Site:</b> ${case.custevent_nx_case_asset}</td>
        </tr>
        <tr>
          <td><b>Address:</b> ${site.custrecord_nx_asset_address_text}</td>
        </tr>
        <tr>
          <td><b>Contact:</b> ${case.contact?split(":")[1]} ${case.phone} ${case.email}</td>
        </tr>
        <tr>
          <td><b>Case Details:</b><br />${case.custevent_nx_case_details}</td>
        </tr>
      </table>
    </div>

    <#list visits as visit>

      <div class="visit_info">
        <table>
          <tr>
            <td><b>${visit.startdate} ${visit.assigned}</b> ${visit.custevent_nxc_arrival_time}</td>
            <td><b>Departure Time:</b> ${visit.custevent_nxc_departure_time}</td>
          </tr>
          <tr>
            <td colspan="2"><b>Additional Request Details:</b> ${visit.message}</td>
          </tr>
        </table>
      </div>

      <p class="break_notes"><b>Actions Taken:</b> ${visit.custevent_nx_actions_taken}</p>

      <div class="break_notes">
        <table>
          <tr>
            <td><b>Onsite Contact:</b> ${visit.custevent_nxc_customer_name}</td>
            <td><b>Attending Technician:</b> ${visit.assigned}</td>
          </tr>
          <tr>
            <td class="cust_sig">${visit.custevent_nxc_customer_signature}</td>
            <td class="cust_sig">${visit.custevent_nxc_technician_signature}</td>
          </tr>
        </table>
        <#assign isparts = false>
        <#list parts as part>
          <#if part.custcol_nx_task == visit.title>
            <#assign isparts = true>
          </#if>
        </#list>
        <#if isparts>
          <table class="parts">
            <tr>
              <th>Item</th>
              <th>Description</th>
              <th>Quantity</th>
            </tr>
            <#list parts as part>
              <#if part.custcol_nx_task == visit.title>
                <tr>
                  <td>${part.item}</td>
                  <td>${part.memo}</td>
                  <td>${part.quantity}</td>
                </tr>
              </#if>
            </#list>
          </table>
        </#if>

      </div>

      <#assign istestings = false>
      <#list testings as test>
        <#if test.custrecord_at_nxc_task == visit.title>
          <#assign istestings = true>
        </#if>
      </#list>
      <#if istestings>
          <table class="testings">
            <thead>
              <tr>
                <th width="42%">Asset</th>
                <th width="7%">Result</th>
                <th width="40%">Details</th>
                <th width="11%">Rating</th>
              </tr>
            </thead>
            <#list testings as test>
              <#if test.custrecord_at_nxc_task == visit.title>
                <tr>
                  <td>${(test.custrecord_at_nxc_asset?split(":"))[1]}${(test.custrecord_at_nxc_asset?split(":"))[2]}</td>
                  <td>${test.custrecord_at_nxc_outcome}</td>
                  <td>${test.custrecord_at_nxc_details}</td>
                  <td>${test.custrecord_at_nxc_rating}</td>
                </tr>
              </#if>
            </#list>
          </table>
      </#if>

    </#list>  
    <div>
    <h2>Images</h2>
    <#assign imageList = images?eval>
<table class="img-table" border="1">
    <tr>
        <#list imageList as result>
            <td>
                <#if result.values['file.url']?has_content>
                    <img src="${result.values['file.url']}" alt="${result.values['file.name']}"result_index % 3 == 2>
                </tr><tr>
            </td>
            </#if>
        </#list>
    </tr>
</table>
    </div>
  </body>
</pdf>
