else {

    ifRec.setCurrentSublistValue({
        sublistId: 'item',
        fieldId: 'itemreceive',
        value: true
    });

    ifRec.setCurrentSublistValue({
        sublistId: 'item',
        fieldId: 'quantity',
        value: Number(wmsLines.qty)
    });

    /* ===== INVENTORY DETAIL HANDLING ===== */
    if (wmsLines.serialNumbers && wmsLines.serialNumbers.length > 0) {

        const cleanSerials = wmsLines.serialNumbers
            .map(sanitizeSerial)
            .filter(Boolean);

        if (cleanSerials.length !== Number(wmsLines.qty)) {
            throw new Error(
                `Inventory Detail mismatch. Qty=${wmsLines.qty}, Serials=${cleanSerials.length}`
            );
        }

        const invMap = buildInventoryNumberMap(cleanSerials, itemId);

        const invDetail = ifRec.getCurrentSublistSubrecord({
            sublistId: 'item',
            fieldId: 'inventorydetail'
        });

        /* Clear existing assignments (transform safety) */
        const existing = invDetail.getLineCount({
            sublistId: 'inventoryassignment'
        });

        for (let r = existing - 1; r >= 0; r--) {
            invDetail.removeLine({
                sublistId: 'inventoryassignment',
                line: r
            });
        }

        cleanSerials.forEach(serial => {

            const invId = invMap[serial];
            if (!invId) {
                throw new Error(`Serial ${serial} not found`);
            }

            invDetail.selectNewLine({
                sublistId: 'inventoryassignment'
            });

            invDetail.setCurrentSublistValue({
                sublistId: 'inventoryassignment',
                fieldId: 'issueinventorynumber',
                value: invId
            });

            invDetail.setCurrentSublistValue({
                sublistId: 'inventoryassignment',
                fieldId: 'quantity',
                value: 1
            });

            invDetail.commitLine({
                sublistId: 'inventoryassignment'
            });
        });
    }

    ifRec.commitLine({ sublistId: 'item' });
}
