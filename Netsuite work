          </tr>
        </table>
        <table class="footer" style="width: 100%;">
          <tr>
            <td>&nbsp;</td>
            <td align="right">Page<pagenumber/> of <totalpages/></td>
          </tr>
        </table>
      </macro>

      <macro id="addressWindow">
        <table left="120px" top="170" background-color="white">
          <tr><td><b>Bill To</b></td></tr>
          <tr><td>
            ${record.custbody_nx_customer}<br />
            <#if record.billaddr1 != "">${record.billaddr1}<br /></#if>
            <#if record.billaddr2 != "">${record.billaddr2}<br /></#if>
            <#if record.billaddr3 != "">${record.billaddr3}<br /></#if>
            <#if record.billcity != "">${record.billcity}, ${record.billstate} ${record.billzip}<br /></#if>
            <#if record.billcountry != ""><#if record.billcountry=="AU">Australia<#else>${record.billcountry}</#if></#if>
          </td></tr>
        </table>
    </macro>

    </macrolist>

    <style type="text/css">
        table {
            font-family: NotoSans, sans-serif;
            font-size: 9pt;
            table-layout: fixed;
        }
        th {
            font-weight: bold;
            font-size: 8pt;
            vertical-align: middle;
            padding: 5px 6px 3px;
            background-color: #e3e3e3;
            color: #333333;
        }
        td {
            padding: 4px 6px;
        }
        b {
            font-weight: bold;
            color: #333333;
        }
        table.header td {
            padding: 0px;
            font-size: 10pt;
        }
        table.newHeader {
      padding: 0px;
        }
        table.footer td {
            padding: 0px;
            font-size: 8pt;
        }
        table.itemtable th {
            padding-bottom: 10px;
            padding-top: 10px;
        }
        table.body td {
            padding-top: 2px;
        }
        table.total {
            page-break-inside: avoid;
        }
        table.newHeader {
      font-family: Arial, Helvetica;
            font-size: 6pt;
            width: 100%;
        }
        tr.totalrow {
            background-color: #e3e3e3;
            line-height: 200%;
        }
        td.totalboxtop {
            font-size: 12pt;
            background-color: #e3e3e3;
        }
        td.addressheader {
            font-size: 8pt;
            padding-top: 6px;
            padding-bottom: 2px;
        }
        td.address {
            padding-top: 0px;
        }
        td.totalboxmid {
            font-size: 28pt;
            background-color: #e3e3e3;
            padding-bottom: 10px;
        }
        td.totalboxbot {
            background-color: #e3e3e3;
            font-weight: bold;
        }
        span.title {
            font-size: 22pt;
        }
        span.number {
            font-size: 16pt;
        }
        span.itemname {
            font-weight: bold;
            line-height: 150%;
        }
        hr {
            width: 100%;
            color: #d3d3d3;
            background-color: #d3d3d3;
            height: 1px;
        }
      .dotted {
            border-top: 1px dashed #111111;
            width: 100%;
            color: #ffffff;
            background-color: #ffffff;
            height: 1px;
      }
      p {
        align: left;
      }
      #page1 { background-macro: addressWindow; header-height: 11%; }
      body { header-height: 13%; }
</style>
</head>
<body header="nlheader" footer="nlfooter" footer-height="15%" padding="0.5in 0.5in 0.5in 0.5in" size="A4">

    <table class="header" style="width: 100%;">
      <tr>
        <td align="right" valign="bottom"><span class="title">Tax Invoice #${record.tranid}</span></td>
      </tr>
      <tr>
        <td align="right">${record.trandate}</td>
      </tr>
   </table>

    <table table-layout="fixed" style="width: 100%; margin-top: 10px;">
      <tr>
        <td class="address" width="62%"></td>
        <td background-color="#e3e3e3" width="38%"><b><#if record.custbody_nx_asset != "">Site Details<#else>Shipping Address</#if></b></td>
      </tr>
    <tr>
      <td class="address"></td>
        <td background-color="#e3e3e3" height="60px">
          <#if record.custbody_nx_asset != "">
            ${record.custbody_nx_asset}<br />
            ${record.custbody_nx_asset.custrecord_nx_asset_address_text}
          <#else>
            <#if record.shipaddressee != "">${record.shipaddressee}<br /></#if>
           <#if record.shipaddr1 != "">${record.shipaddr1}<br /></#if>
            <#if record.shipaddr2 != "">${record.shipaddr2}<br /></#if>
            <#if record.shipcity != "">${record.shipcity}, ${record.shipstate} ${record.shipzip}<br /></#if>
            <#if record.shipcountry != ""><#if record.shipcountry=="AU">Australia<#else>${record.shipcountry}</#if></#if>
          </#if>
        </td>
    </tr>
    </table>

  <table class="body" style="width: 100%; margin-top: 20px;">
    <tr>
    <th>${record.salesrep@label}</th>
    <th>Sales Order #</th>
    <th><#if record.custbody_nx_case != ''>Case<#else>Tracking #</#if></th>
    <th>Purchase Order #</th>
  </tr>
  <tr>
    <td>${record.salesrep}</td>
    <td>${record.createdfrom.number}</td>
    <td><#if record.custbody_nx_case != ''>${record.custbody_nx_case.custevent_nx_case_type} ${record.custbody_nx_case.number}<#else>${record.linkedtrackingnumbers}</#if></td>
    <td>${record.otherrefnum}</td>
  </tr>
  </table>

<#if record.item?has_content>

  <table class="itemtable" style="width: 100%; margin-top: 10px;">
    <!-- start items --><#list record.item as item>
    <#if item_index==0>
      <thead>
      <tr>
        <th align="center" colspan="3">${item.quantity@label}</th>
        <th colspan="15">${item.item@label}</th>
        <th align="right" colspan="4">&nbsp;</th>
        <th align="right" colspan="4">${item.rate@label}</th>
        <th align="right" colspan="4">${item.amount@label}</th>
      </tr>
      </thead>
    </#if>

    <tr>
      <td align="center" colspan="3" line-height="150%">${item.quantity}<#if item.item?contains('abour')> ${item.units}</#if></td>
    <td colspan="15"><span class="itemname">${item.item}</span><br />${item.description}</td>
    <td align="right" colspan="4">${item.price}</td>
    <td align="right" colspan="4">${item.rate}</td>
    <td align="right" colspan="4">${item.amount}</td>
  </tr>

  </#list><!-- end items -->
  </table>
  <hr />
</#if>

<table class="total" style="width: 100%; margin-top: 10px;">
  <#if record.shipmethod?has_content>
    <tr>
      <td colspan="4">&nbsp;</td>
      <td align="right" ><b>Shipping</b></td>
    <td align="right" >${record.shippingcost}</td>
    </tr>
  </#if>
  <tr>
    <td colspan="4">&nbsp;</td>
  <td align="right"><b>Sub-Total ex GST</b></td>
  <td align="right">${record.subtotal}</td>
  </tr>
  <tr>
    <td colspan="4">&nbsp;</td>
  <td align="right"><b>GST</b></td>
  <td align="right">${record.taxtotal}</td>
  </tr>
  <tr class="totalrow">
    <td background-color="#ffffff" colspan="4">&nbsp;</td>
  <td align="right"><b>Total inc GST</b></td>
  <td align="right">${record.total}</td>
  </tr>
  <tr class="remainingtotal" ><#assign x = record.total - record.amountremaining >
    <td colspan="4">&nbsp;</td>
  <td align="right" style="font-size:10px;"><b>Amount Applied</b></td>
  <td align="right">${x?string.currency}</td>
  </tr>
  <tr class="remainingtotal" >
    <td colspan="4">&nbsp;</td>
  <td align="right" style="font-size:10px;"><b>Amount Due</b></td>
  <td align="right">${record.amountremaining}</td>
  </tr>
</table>

</body>
</pdf>
