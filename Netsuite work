
/**
 * @NApiVersion 2.1
 * @NScriptType MapReduceScript
 */
define(['N/search', 'N/record', 'N/runtime', 'N/log'],
    function (search, record, runtime, log) {

        function getInputData() {
            const currentScript = runtime.getCurrentScript();
            const savedSearchId = currentScript.getParameter({
                name: "custscript_ada_sales_order_saved_search"
            });

            if (!savedSearchId) {
                log.error({ title: 'Saved search Id not provided in script parameter' });
                return [];
            }

            const loadSavedSearch = search.load({ id: savedSearchId });
            log.debug("Search Count", loadSavedSearch.runPaged().count);
            return loadSavedSearch;
        }

        function map(context) {
            try {
                const searchResult = JSON.parse(context.value);
                context.write({
                    key: searchResult.id,
                    value: searchResult
                });
            } catch (error) {
                log.error("Map Error", error);
            }
        }

        function reduce(context) {
            try {
                const soDetails = context.values;
                const salesOrderId = context.key;

                var invoiceDetailsArray = [];

                for (var i = 0; i < soDetails.length; i++) {
                    var soDetailsData = JSON.parse(soDetails[i]);

                    invoiceDetailsArray.push({
                        createdBy: soDetailsData.values['custbody_created_by'].value,
                        supress_email: soDetailsData.values['custbody_ada_suppress_invoice_email'],
                        item: soDetailsData.values['item'].value,
                        itemType: soDetailsData.values['type.item'].value,
                        memberItem: soDetailsData.values['memberitem.item'].value
                    });
                }

                const invoiceRecord = record.transform({
                    fromType: record.Type.SALES_ORDER,
                    fromId: salesOrderId,
                    toType: record.Type.INVOICE,
                    isDynamic: true
                });

                invoiceRecord.setValue({
                    fieldId: 'custbody_created_by',
                    value: invoiceDetailsArray[0].createdBy
                });

                invoiceRecord.setValue({
                    fieldId: 'approvalstatus',
                    value: 2
                });

                invoiceRecord.setValue({
                    fieldId: 'tobeemailed',
                    value: invoiceDetailsArray[0].supress_email !== 'T',
                    ignoreFieldChange: true
                });

                var invoiceLineCount = invoiceRecord.getLineCount({ sublistId: 'item' });

                for (var invLine = 0; invLine < invoiceLineCount; invLine++) {

                    var itemName = invoiceRecord.getSublistValue({
                        sublistId: 'item',
                        fieldId: 'item',
                        line: invLine
                    });

                    var invItemType = invoiceRecord.getSublistValue({
                        sublistId: 'item',
                        fieldId: 'itemtype',
                        line: invLine
                    });

                    var invItemAmount = invoiceRecord.getSublistValue({
                        sublistId: 'item',
                        fieldId: 'amount',
                        line: invLine
                    });

                    // ❗ FIX APPLIED HERE (Correct Line Index)
                    var invItemLineNo = invLine + 1;

                    if (invItemType === 'Kit') {

                        var foundItem = invoiceDetailsArray.filter(soItem => soItem.item === itemName);

                        if (foundItem.length > 0) {

                            invoiceRecord.selectLine({
                                sublistId: 'item',
                                line: invLine
                            });

                            invoiceRecord.setCurrentSublistValue({
                                sublistId: 'item',
                                fieldId: 'amount',
                                value: 0
                            });

                            invoiceRecord.setCurrentSublistValue({
                                sublistId: 'item',
                                fieldId: 'custcol_ada_kit_amount',
                                value: invItemAmount
                            });

                            invoiceRecord.commitLine({
                                sublistId: 'item'
                            });

                            var newKitItemAmount = (invItemAmount / foundItem.length).toFixed(2);
                            var remainingKitAmount = invItemAmount;

                            for (var kitLine = 0; kitLine < foundItem.length; kitLine++) {

                                invoiceRecord.insertLine({
                                    sublistId: 'item',
                                    line: invItemLineNo++,
                                    ignoreRecalc: true
                                });

                                invoiceRecord.setCurrentSublistValue({
                                    sublistId: 'item',
                                    fieldId: 'item',
                                    value: foundItem[kitLine].memberItem
                                });

                                invoiceRecord.setCurrentSublistValue({
                                    sublistId: 'item',
                                    fieldId: 'quantity',
                                    value: 0
                                });

                                if (kitLine === foundItem.length - 1) {
                                    invoiceRecord.setCurrentSublistValue({
                                        sublistId: 'item',
                                        fieldId: 'amount',
                                        value: remainingKitAmount
                                    });
                                } else {
                                    invoiceRecord.setCurrentSublistValue({
                                        sublistId: 'item',
                                        fieldId: 'amount',
                                        value: newKitItemAmount
                                    });

                                    remainingKitAmount -= newKitItemAmount;
                                }

                                invoiceRecord.setCurrentSublistValue({
                                    sublistId: 'item',
                                    fieldId: 'custcol_ada_hide_on_pdf',
                                    value: true
                                });

                                invoiceRecord.commitLine({
                                    sublistId: 'item'
                                });
                            }

                            // Refresh line count
                            invoiceLineCount = invoiceRecord.getLineCount({ sublistId: 'item' });
                        }
                    }
                }

                const invoiceId = invoiceRecord.save();
                log.debug("Invoice Created", invoiceId);

            } catch (error) {
                log.error("Reduce Error", error);
            }
        }

        function summarize(summary) {
            summary.mapSummary.errors.iterator().each(function (key, error) {
                log.error("Map Error", key + ": " + error);
                return true;
            });
        }

        return {
            getInputData,
            map,
            reduce,
            summarize
        };
    });
