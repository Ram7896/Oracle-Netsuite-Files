/**
 * @NApiVersion 2.1
 * @NScriptType ClientScript
 */
define([], () => {

    function fieldChanged(context) {
        try {
            const rec = context.currentRecord;
            const fieldId = context.fieldId;

            // Example: checkbox -> related text field mapping
            const mapping = {
                custpage_checkbox1: { textField: 'custpage_text1', value: 'Value 1' },
                custpage_checkbox2: { textField: 'custpage_text2', value: 'Value 2' },
                custpage_checkbox3: { textField: 'custpage_text3', value: 'Value 3' },
                custpage_checkbox4: { textField: 'custpage_text4', value: 'Value 4' }
            };

            if (mapping[fieldId]) {
                let checkboxValue = rec.getValue({ fieldId });
                let textFieldId = mapping[fieldId].textField;
                let setValue = checkboxValue ? mapping[fieldId].value : ''; // clear if unchecked

                rec.setValue({
                    fieldId: textFieldId,
                    value: setValue
                });
            }

        } catch (e) {
            console.log('Error in fieldChanged: ', e.message);
        }
    }

    return {
        fieldChanged
    };
});
