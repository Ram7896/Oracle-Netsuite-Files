        /* Gathers geoJSON data from QLD government website. Data outlines boundaries of local government areas.
         * This data is used to check which lga a particular set of coordinates belongs to.
         **/
        function calculateLocalCouncil(long, lat) {
            // Get geoJSON
            var lgaGeoJsonUrl = 'https://data.gov.au/geoserver/qld-local-government-areas-psma-administrative-boundaries/wfs?request=GetFeature&typeName=ckan_16803f0b_6934_41ae_bf82_d16265784c7f&outputFormat=json';
            var geoJSON = https.get({ url: lgaGeoJsonUrl }).body;
            geoJSON = JSON.parse(geoJSON);
            // Test each polygon until council located
            for (var feat_ind = 0; feat_ind < geoJSON.features.length; feat_ind++) {
                if (geoJSON.features[feat_ind].type == "Feature") {
                    var feature = geoJSON.features[feat_ind];
                    for (var poly_ind = 0; poly_ind < feature.geometry.coordinates.length; poly_ind++) {
                        if (inside([long, lat], feature.geometry.coordinates[poly_ind][0])) {
                            return feature.properties.qld_lga__2;
                        }
                    }
                }
            }
            return '';
        }; // End calculateLocalCouncil(long,lat)

        /* Task a polygon of the form [ [1,1], [1,2], [2,2], [2,1] ] and a point of the form [1.5,1.5]
         * and returns true when the point lies within the polygon.
         **/
        function inside(point, vs) {
            var x = point[0], y = point[1];

            var inside = false;
            for (var i = 0, j = vs.length - 1; i < vs.length; j = i++) {
                var xi = vs[i][0], yi = vs[i][1];
                var xj = vs[j][0], yj = vs[j][1];

                var intersect = ((yi > y) != (yj > y))
                    && (x < (xj - xi) * (y - yi) / (yj - yi) + xi);
                if (intersect) inside = !inside;
            }

            return inside;
        }; // End inside(point, vs)

        function loadHeaderFooterData(renderer) {
            var raj_sig_file = file.load({ id: '519825' });
            var logo_a_file = file.load({ id: '519828' });
            var url_start = 'https://5238530.app.netsuite.com';
            addRecords(renderer, [
                { name: 'subsidiary', type: record.Type.SUBSIDIARY, id: runtime.getCurrentUser().subsidiary }
            ]);
            renderer.addCustomDataSource({
                format: render.DataSource.OBJECT,
                alias: 'img_urls',
                data: { 'raj_sig': url_start + raj_sig_file.url, 'logo_a': logo_a_file.url }
            });
        } // End loadHeaderFooterData(renderer)

        function loadCommChecklistData(params, renderer) {
            var checklist_joins = search.lookupFields({
                type: 'customrecord_nxc_commissioning_form',
                id: params.checklist_id,
                columns: ['custrecord_cf_asset', 'custrecord_cf_case', 'custrecord_cf_task']
            });
            var asset_so_id = search.lookupFields({
                type: 'customrecord_nx_asset',
                id: checklist_joins.custrecord_cf_asset[0].value,
                columns: ['custrecord_nxc_sales_order']
            }).custrecord_nxc_sales_order[0].value;
            var records = [
                { name: 'asset', type: 'customrecord_nx_asset', id: checklist_joins.custrecord_cf_asset[0].value },
                { name: 'case', type: record.Type.SUPPORT_CASE, id: checklist_joins.custrecord_cf_case[0].value },
                { name: 'task', type: record.Type.TASK, id: checklist_joins.custrecord_cf_task[0].value },
                { name: 'checklist', type: 'customrecord_nxc_commissioning_form', id: params.checklist_id },
                { name: 'subsidiary', type: record.Type.SUBSIDIARY, id: runtime.getCurrentUser().subsidiary }
            ];
            if (asset_so_id) {
                records.push({ name: 'sales_order', type: record.Type.SALES_ORDER, id: asset_so_id });
            }
            addRecords(renderer, records);
            loadHeaderFooterData(renderer);
        }; // End loadCommChecklistData(params,renderer)
        function loadCommChecklistDataAndCouncil(params, renderer) {
            var asset_loc = search.lookupFields({
                type: 'customrecord_nx_asset',
                id: params.asset_id,
                columns: ['custrecord_nx_asset_longitude', 'custrecord_nx_asset_latitude']
            });
            loadCommChecklistData(params, renderer);
            var local_council = calculateLocalCouncil(
                parseFloat(asset_loc.custrecord_nx_asset_longitude),
                parseFloat(asset_loc.custrecord_nx_asset_latitude)
            );
            renderer.addCustomDataSource({
                format: render.DataSource.OBJECT,
                alias: 'local_council',
                data: { 'name': local_council }
            });
        }; // End loadCommChecklistDataAndCouncil(params,renderer)

        function loadContractorWOData(params, renderer) {
            var case_joins = search.lookupFields({
                type: record.Type.SUPPORT_CASE,
                id: params.case_id,
                columns: ['custevent_nx_case_asset',
                    'startdate',
                    'custevent_nxc_sub_assets',
                    'custevent_nx_case_details',
                    'custevent1',
                    'custevent3',
                    'contact',
                    'company'
                ]
            });
            // Load sub-asset fields
            var asset_results = [];
            var Notes = case_joins.custevent_nx_case_details;
            log.debug("Details:", Notes);
            var case_assets = case_joins.custevent_nxc_sub_assets;
            var proj_assets = case_joins.custevent1;
            var dateStr = [];
            var startDateStr = case_joins.startdate;
            log.debug("Start Date:", startDateStr);

            var dateStr = []; // initialize array
            var monthYear = ""; // declare variable

            if (startDateStr) {
                // Convert NetSuite date string to Date object
                var dateObj = format.parse({
                    value: startDateStr,
                    type: format.Type.DATE
                });

                // Month names
                var months = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];

                monthYear = months[dateObj.getMonth()] + '-' + dateObj.getFullYear();
            }

            log.debug("Month-Year", monthYear);
            dateStr.push(monthYear);

            if (Array.isArray(case_assets)) case_assets = case_assets.map(function (el) { return el.value });
            else if (case_assets.value) case_assets = case_assets.value.split(',');
            if (Array.isArray(proj_assets)) proj_assets = proj_assets.map(function (el) { return el.value });
            else if (proj_assets.value) proj_assets = proj_assets.value.split(',');
            asset_results = asset_results.concat(case_assets);
            log.debug("Case assets:", asset_results);
            asset_results = asset_results.concat(proj_assets);
            log.debug("Project assets:", asset_results);
            var assets = [];
            var flaggedNames = [];
            asset_results.forEach(function (res) {
                log.debug("asset results:", res);
                var results = search.lookupFields({
                    type: 'customrecord_nx_asset',
                    id: res,
                    columns: [
                        'custrecord_ai_asd',
                        'name',
                        'custrecord_nx_asset_serial',
                        'custrecord_nxc_customer_asset_id',
                        'custrecord_nxc_master_code',
                        'custrecord_nxc_manufacture_date',
                        'custrecord_nxc_commissioning_date',
                        'custrecord_na_nxc_location_on_site',
                        'custrecord_nxc_make',
                        'custrecord_nxc_model',
                        'custrecord_nxc_locking',
                        'custrecord_purchase_type',
                        'custrecord_nxc_batt_type',
                        'custrecord_nxc_transmission',
                        'custrecord_product_type',
                        'custrecord_nxc_sec_opt_operator_type',
                        'custrecord_nxc_cowl',
                        'custrecord_nxc_cowl_length',
                        'custrecord_nxc_pelmet',
                        'custrecord_nxc_pelmet_length',
                        'custrecord_nxc_asset_type',
                        'custrecord_nxc_door_height_m',
                        'custrecord_nxc_door_width_m',
                        'custrecord_nxc_door_weight_kg',
                        'custrecord_nxc_glass_thickness',
                        'custrecord_nxc_entry_sensor',
                        'custrecord_nxc_exit_sensor',
                        'custrecord_nxc_open_safety',
                        'custrecord_nxc_close_safety',
                        'custrecord_nxc_entry_switch',
                        'custrecord_nxc_exit_switch',
                        'custrecord_nxc_mode_switch',
                        'custrecord_nxc_add_comm_parts',
                        'custrecord_nx_asset_type',
                        'custrecord_nxc_customer_asset_id',
                        'custrecord_nxc_asset_notes',
                        'custrecord_ai_nonai_model',
                        'custrecord_ai_adnl_model_info'

                    ]
                });
                var names = Object.keys(results);
                names.forEach(function (name) {
                    if (Array.isArray(results[name])) {
                        if (results[name].length == 0) results[name] = '';
                        else if (name != 'custrecord_nxc_add_comm_parts')
                            results[name] = results[name][0].text;
                    }
                    else results[name] = results[name];
                });

                // Modification: transform results.name after colon
                if (results.name) {
                    results.name = getAfterFirstColonBlock(results.name);
                }
                // Get Tag Id number from search field value: results.custrecord_nxc_customer_asset_id
                var tagIdNum = getTagIdNumber(results.custrecord_nxc_customer_asset_id);

                // If Customer Asset Id contains a number -> append ":Tag Id:<number>"
                if (tagIdNum) {
                    results.name = results.name + ":Tag Id:" + tagIdNum;
                }
                // If checkbox is true, store the modified name in separate array
                if (results.custrecord_ai_asd === true || results.custrecord_ai_asd === 'T') {
                    flaggedNames.push(results.name);
                }
                else {
                    assets.push(results);
                }

                log.debug("Asset Details:", results.name);
                log.debug("Automatic Sliding Door(Back Of House) Checkbox names:", flaggedNames);

            });
            var logoFile = file.load({ id: 15265735 });
            log.debug("Log File Url:", logoFile.url);
            renderer.addCustomDataSource({
                format: render.DataSource.OBJECT,
                alias: 'img',
                data: {
                    logo: logoFile.url
                }
            });
            var logoFile = file.load({ id: 15265734 });
            log.debug("Sliding Door Log File Url:", logoFile.url);
            renderer.addCustomDataSource({
                format: render.DataSource.OBJECT,
                alias: 'sliding',
                data: {
                    logo: logoFile.url
                }
            });
            renderer.addCustomDataSource({
                format: render.DataSource.OBJECT,
                alias: 'sub_assets',
                data: { data: assets }
            });
            renderer.addCustomDataSource({
                format: render.DataSource.OBJECT,
                alias: 'date_str',
                data: { data: dateStr }
            });
            renderer.addCustomDataSource({
                format: render.DataSource.OBJECT,
                alias: 'details',
                data: { data: Notes }
            });
            renderer.addCustomDataSource({
                format: render.DataSource.OBJECT,
                alias: 'flagged_names',
                data: { data: flaggedNames }
            });
            // Load related transaction fields
            var order_data = [];
            case_joins.custevent3.forEach(function (res) {
                var results = search.lookupFields({
                    type: search.Type.TRANSACTION,
                    id: res.value,
                    columns: [
                        'tranid',
                        'shipdate',
                        'status',
                        'trackingnumbers',
                        'shipmethod'
                    ]
                });
                var names = Object.keys(results);
                names.forEach(function (name) {
                    if (Array.isArray(results[name])) {
                        if (results[name].length == 0) results[name] = '';
                        else results[name] = results[name][0].text;
                    }
                    else results[name] = results[name];
                });
                order_data.push(results);
            });
            renderer.addCustomDataSource({
                format: render.DataSource.OBJECT,
                alias: 'orders',
                data: { data: order_data }
            });
            // Load primary contact fields
            if (case_joins.contact[0] == null) throw new Error('Error: Please enter a primary contact for your case.');
            var contact_search = lookupContactFields(case_joins.contact[0].value);
            renderer.addCustomDataSource({
                format: render.DataSource.OBJECT,
                alias: 'case_contact',
                data: contact_search
            });
            // Load site contacts fields
            var site_contact_data = search.create({
                type: 'customrecord_nxc_acl',
                filters: [
                    {
                        name: 'custrecord_acl_asset',
                        operator: search.Operator.IS,
                        values: case_joins.custevent_nx_case_asset[0].value
                    },
                    {
                        name: 'isinactive',
                        operator: search.Operator.IS,
                        values: false
                    }
                ],
                columns: [{ name: 'custrecord_acl_contact' }]
            }).run()
                .getRange(0, 1000)
                .map(function (res) { return res.getValue({ name: 'custrecord_acl_contact' }); })
                .map(function (id) { return lookupContactFields(id); });
            renderer.addCustomDataSource({
                format: render.DataSource.OBJECT,
                alias: 'site_contacts',
                data: { data: site_contact_data }
            });
            addRecords(renderer, [
                { name: 'site', type: 'customrecord_nx_asset', id: case_joins.custevent_nx_case_asset[0].value },
                { name: 'case', type: record.Type.SUPPORT_CASE, id: params.case_id },
                { name: 'project', type: record.Type.JOB, id: case_joins.company[0].value }
            ]);
            loadHeaderFooterData(renderer);
        }; // End loadContractorWOData(params,renderer)


        // Helper: returns everything after the first " : " (with spaces), or the original if not found
        function getAfterFirstColonBlock(str) {
            if (!str || typeof str !== 'string') return str;
            var idx = str.indexOf(' : ');
            return idx >= 0 ? str.substring(idx + 3).trim() : str;
        }
        // Helper: extract first number found
        function getTagIdNumber(str) {
            if (!str || typeof str !== 'string') return '';
            var m = str.match(/\d+/);
            return m ? m[0] : '';
        }
        function lookupContactFields(contact_id) {
            return search.lookupFields({
                type: search.Type.CONTACT,
                id: contact_id,
                columns: [
                    'entityid',
                    'email',
                    'phone',
                    'mobilephone'
                ]
            });
        } // End contactSearch(contact_id)

        // params is an array of objects, each of which follow the format
        // { name: [name within template], type: [record type], id: [record internalId] }
        function addRecords(renderer, params) {
            params.forEach(function (param) {
                renderer.addRecord({
                    templateName: param.name,
                    record: record.load({ type: param.type, id: param.id })
                })
            });
        }; // End addRecord(renderer,params)

        function generateAssetDocs(checklist_id) {
            var asset_id = search.lookupFields({
                type: 'customrecord_nxc_commissioning_form',
                id: checklist_id,
                columns: ['custrecord_cf_asset']
            }).custrecord_cf_asset[0].value;
            var asset_address = search.lookupFields({
                type: 'customrecord_nx_asset',
                id: asset_id,
                columns: ['custrecord_nx_asset_address_text']
            }).custrecord_nx_asset_address_text;

            var renderer = render.create();
            //     if ( asset_address.indexOf('QLD') != -1 )
            //       loadCommChecklistDataAndCouncil({ checklist_id: checklist_id, asset_id: asset_id }, renderer);
            //     else loadCommChecklistData({ checklist_id: checklist_id }, renderer);
            loadCommChecklistData({ checklist_id: checklist_id }, renderer);

            var docs = [];

            renderer.templateContent = file.load({ id: '519834' }).getContents();
            docs.push({ file: renderer.renderAsPdf(), doc_type: 'warranty' });

            renderer.templateContent = file.load({ id: '519832' }).getContents();
            docs.push({ file: renderer.renderAsPdf(), doc_type: 'compliance' });

            if (asset_address.indexOf('QLD') != -1) {

                // ✅ 1. Load background PDF (IMPORTANT: use correct PDF file ID)
                var bgFile = file.load({ id: 15567856 }); // <-- YOUR BACKGROUND PDF ID

                // ✅ 2. Add BEFORE rendering
                renderer.addCustomDataSource({
                    format: render.DataSource.OBJECT,
                    alias: "data",
                    data: {
                        bgPdfUrl: bgFile.url
                    }
                });

                // ✅ 3. Load template (XML file)
                renderer.templateContent = file.load({ id: '15567856' }).getContents();

                // ✅ 4. Render
                docs.push({ file: renderer.renderAsPdf(), doc_type: 'form12' });
            }

            return docs;
        }; // End generateAssetDocs(checklist_id)

        function generateChecklistDoc(checklist_id) {
            var renderer = render.create();
            loadCommChecklistData({ checklist_id: checklist_id }, renderer);

            renderer.templateContent = file.load({ id: '519831' }).getContents();
            return { file: renderer.renderAsPdf(), doc_type: 'checklist' };
        }; // End generateChecklistDoc(checklist_id)

        function generateContractorWorkOrder(case_id) {
            var case_type = search.lookupFields({
                type: record.Type.SUPPORT_CASE,
                id: case_id,
                columns: ['custevent_nx_case_type', 'custevent_nx_customer']
            });
            var case_type_id = case_type.custevent_nx_case_type[0].value;
            var customer_id = case_type.custevent_nx_customer[0].value;
            log.debug("Customer Id:", customer_id);

            const allowedCustomerIds = [
                2410, 2415, 2414, 70743, 2408, 2416, 2413, 3069409, 2407
            ];
            var renderer = render.create();

            if (case_type_id == idlib.CASE.TYPE.REPAIR) {
                loadContractorWOData({ case_id: case_id }, renderer);
                renderer.templateContent = file.load({ id: '529376' }).getContents();
            }
            else if (allowedCustomerIds.indexOf(parseInt(customer_id)) !== -1 && (case_type_id == idlib.CASE.TYPE.MAJOR_MAINT || case_type_id == idlib.CASE.TYPE.MINOR_MAINT)) {
                loadContractorWOData({ case_id: case_id }, renderer);
                renderer.templateContent = file.load({ id: '15265733' }).getContents();
            }
            else if (case_type_id == idlib.CASE.TYPE.MAJOR_MAINT || case_type_id == idlib.CASE.TYPE.MINOR_MAINT) {
                loadContractorWOData({ case_id: case_id }, renderer);
                renderer.templateContent = file.load({ id: '534477' }).getContents();
            }
            else if (case_type_id == idlib.CASE.TYPE.COMM || case_type_id == idlib.CASE.TYPE.INST_COMM) {
                loadContractorWOData({ case_id: case_id }, renderer);
                renderer.templateContent = file.load({ id: '529375' }).getContents();
            }

            try {
                var pdf = renderer.renderAsPdf();
            } catch (e) {
                throw new Error('Issue rendering the provided template');
            }
            return { file: renderer.renderAsPdf(), doc_type: 'contractor_wo' };
        } // End generateContractorWorkOrder(case_id)

        return {
            generateAssetDocs: generateAssetDocs,
            generateChecklistDoc: generateChecklistDoc,
            commChecklistComplies: commChecklistComplies,
            generateContractorWO: generateContractorWorkOrder
        };
    })
