/**
 * @NApiVersion 2.1
 * @NScriptType Suitelet
 */

define([
    'N/ui/serverWidget',
    'N/search',
    'N/format',
    'N/log'
],

function (
    serverWidget,
    search,
    format,
    log
) {

    function onRequest(context) {

        try {

            if (context.request.method === 'GET') {

                var request =
                    context.request;

                var selectedVendor =
                    request.parameters.custpage_vendor || '';

                var form =
                    serverWidget.createForm({
                        title: 'Vendor Portal'
                    });

                form.clientScriptModulePath =
                    './CS_Vendor_portal.js';

                //=========================
                // Buttons
                //=========================

                form.addSubmitButton({
                    label: 'Save'
                });

                form.addButton({
                    id: 'custpage_cancel',
                    label: 'Cancel',
                    functionName: 'cancelPage'
                });

                //=========================
                // Name
                //=========================

                form.addField({
                    id: 'custpage_name',
                    type: serverWidget.FieldType.TEXT,
                    label: 'Name'
                });

                //=========================
                // Vendor
                //=========================

                var vendorField =
                    form.addField({
                        id: 'custpage_vendor',
                        type:
                        serverWidget.FieldType.SELECT,
                        label: 'Vendor Name',
                        source: 'vendor'
                    });

                vendorField.defaultValue =
                    selectedVendor;

                vendorField.updateBreakType({
                    breakType:
                    serverWidget.FieldBreakType.STARTCOL
                });

                //=========================
                // Date
                //=========================

                var dateField =
                    form.addField({
                        id: 'custpage_date',
                        type:
                        serverWidget.FieldType.DATE,
                        label: 'Date'
                    });

                dateField.defaultValue =
                    format.format({
                        value:
                        new Date(),

                        type:
                        format.Type.DATE
                    });

                //=========================
                // Vendor Cases
                //=========================

                var caseField =
                    form.addField({
                        id:
                        'custpage_cases',

                        type:
                        serverWidget.FieldType.SELECT,

                        label:
                        'Vendor Cases'
                    });

                caseField.addSelectOption({
                    value: '',
                    text: ''
                });

                if (selectedVendor) {

                    var supportCaseSearch =
                        search.create({

                            type:
                            search.Type.SUPPORT_CASE,

                            filters: [
                                [
                                    'company',
                                    'anyof',
                                    selectedVendor
                                ]
                            ],

                            columns: [
                                'casenumber',
                                'title'
                            ]
                        });

                    supportCaseSearch
                        .run()
                        .each(function (result) {

                            var caseNumber =
                                result.getValue(
                                    'casenumber'
                                ) || '';

                            var title =
                                result.getValue(
                                    'title'
                                ) || '';

                            caseField
                                .addSelectOption({

                                    value:
                                    result.id,

                                    text:
                                    caseNumber +
                                    ' - ' +
                                    title
                                });

                            return true;
                        });
                }

                context.response.writePage(
                    form
                );
            }

        } catch (e) {

            log.error({
                title:
                'SUITELET ERROR',

                details:
                e
            });
        }
    }

    return {
        onRequest: onRequest
    };

});


/**
 * @NApiVersion 2.1
 * @NScriptType ClientScript
 */

define([
    'N/currentRecord',
    'N/url'
],

function (
    currentRecord,
    url
) {

    function fieldChanged(context) {

        try {

            if (
                context.fieldId !==
                'custpage_vendor'
            ) {
                return;
            }

            var rec =
                currentRecord.get();

            var vendor =
                rec.getValue({
                    fieldId:
                    'custpage_vendor'
                });

            var suiteletUrl =
                url.resolveScript({

                    scriptId:
                    'customscript_vendor_portal_suitlet',

                    deploymentId:
                    'customdeploy_vendor_portal_suitelet',

                    params: {

                        custpage_vendor:
                        vendor
                    }
                });

            window.location.href =
                suiteletUrl;

        } catch (e) {

            console.log(e);
        }
    }

    function cancelPage() {

        history.back();
    }

    return {

        fieldChanged:
        fieldChanged,

        cancelPage:
        cancelPage
    };

});
