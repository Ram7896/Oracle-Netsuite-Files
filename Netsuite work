<#if images.imageList?has_content>

<h3 style="font-size:12pt; margin-top:15px;">Job Images</h3>

<#assign NS_BASE_URL = "https://5238530-sb2.app.netsuite.com">
<#assign col = 0>

<table style="width:100%; table-layout:fixed; border-collapse: collapse;">
<tr>

<#list images.imageList as images_final>

  <td style="width:33%; text-align:center; padding:8px;">
    
    <#if images_final.values['file.url']?has_content>
      <img src="${NS_BASE_URL}${images_final.values['file.url']}"
           width="140"
           height="140"
           style="border:1px solid #cccccc;" />
    <#else>
      <p>No Image</p>
    </#if>

  </td>

  <#assign col = col + 1>

  <#if col == 3>
    </tr><tr>
    <#assign col = 0>
  </#if>

</#list>

</tr>
</table>

</#if>
