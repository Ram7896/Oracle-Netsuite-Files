    let layout;
    switch (labelSize) {
      case '2.5x1':
        layout={pw:500,ll:250,lines:[
          {x:10,y:10,text:item},
          {x:10,y:40,text:sampleType},
          {x:10,y:70,text:'{serial}'},
          {x:10,y:100,text:`Mfg:${mfg}`},
          {x:10,y:130,text:`Vol:${vol} Cell Conc:${conc}`},
          {x:10,y:160,text:'Caution: Investigational Use Only'}
        ],logos:[{x:360,y:40,ref:'Celularity3.GRF'},{x:360,y:90,ref:'biohazard.GRF'}]};
        break;
      case '3x2':
        layout={pw:610,ll:400,lines:[
          {x:20,y:20,text:item},
          {x:20,y:60,text:sampleType},
          {x:20,y:100,text:'{serial}'},
          {x:20,y:140,text:`Mfg:${mfg}`},
          {x:20,y:180,text:`Vol:${vol} Cell Conc:${conc}`},
          {x:20,y:220,text:'Storage: ≤ -20°C'},
          {x:20,y:260,text:'Caution: Investigational Use Only'}
        ],logos:[{x:450,y:60,ref:'Celularity3.GRF'},{x:450,y:120,ref:'biohazard.GRF'}]};
        break;
      default:
        layout={pw:400,ll:300,lines:[
          {x:10,y:10,text:item},
          {x:10,y:35,text:sampleType},
          {x:10,y:60,text:'{serial}'},
          {x:10,y:85,text:`Mfg:${mfg}`},
          {x:10,y:110,text:`Vol:${vol} Cell Conc:${conc}`},
          {x:10,y:135,text:'Caution: Investigational Use Only'}
        ],logos:[{x:240,y:35,ref:'Celularity3.GRF'},{x:240,y:85,ref:'biohazard.GRF'}]};
        break;
    }

    let zpl = `${logoCelularity}\n${logoBiohazard}\n`;
    for (let i=0; i<qty; i++) {
      const serial = incFlag ? incrementSerialCustom(startSerial,i) : startSerial;
      zpl += `^XA\n^PW${layout.pw}\n^LL${layout.ll}\n^LH0,0\n^CF0,22\n`;
      for (const l of layout.lines)
        zpl += `^FO${l.x},${l.y}^FD${String(l.text).replace('{serial}',serial)}^FS\n`;
      for (const g of layout.logos)
        zpl += `^FO${g.x},${g.y}^XGR:${g.ref},1,1^FS\n`;
      zpl += '^XZ\n';
    }
    return zpl;
  }

  function showAlert(response, msg) {
    response.write(`<script>alert("${String(msg).replace(/"/g,'\\"')}");history.back();</script>`);
  }

  return { onRequest };
});

