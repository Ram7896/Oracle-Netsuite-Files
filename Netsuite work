// Helper: returns everything after the first " : " (with spaces), or the original if not found
function getAfterFirstColonBlock(str) {
    if (!str || typeof str !== 'string') return str;
    var idx = str.indexOf(' : ');
    return idx >= 0 ? str.substring(idx + 3).trim() : str;
}

// Helper: extract first number found
function getTagIdNumber(str) {
    if (!str || typeof str !== 'string') return '';
    var m = str.match(/\d+/);
    return m ? m[0] : '';
}

var names = Object.keys(results);
names.forEach(function (name) {
    if (Array.isArray(results[name])) {
        if (results[name].length == 0) results[name] = '';
        else if (name != 'custrecord_nxc_add_comm_parts')
            results[name] = results[name][0].text;
    }
    else results[name] = results[name];
});

// >>> Modification: transform results.name after colon
if (results.name) {
    results.name = getAfterFirstColonBlock(results.name);
}

// >>> ADD THIS NEW REQUIRED LOGIC <<<
// Get Tag Id number from search field value: results.custrecord_nxc_customer_asset_id
var tagIdNum = getTagIdNumber(results.custrecord_nxc_customer_asset_id);

// If Customer Asset Id contains a number → append ":Tag Id:<number>"
if (tagIdNum) {
    results.name = results.name + ":Tag Id:" + tagIdNum;
}
// If no number → do nothing (keep results.name normally)

// >>> END OF NEW LOGIC <<<

// Push into assets and log
assets.push(results);
log.debug("Asset Details:", results.name);
log.debug("Customer Asset Id:", results.custrecord_nxc_customer_asset_id);

});

renderer.addCustomDataSource({
    format: render.DataSource.OBJECT,
    alias: 'sub_assets',
    data: { data: assets }
});
