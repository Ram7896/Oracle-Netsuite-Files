else {
    var vbqty = vendorBillarr[i].quantity;
    var irsumQuantity = getIrQuantity(vendorBillarr[i].vbinternalid); // Get sum of linked IR quantities
    var remainingQty = vbqty - irsumQuantity;

    if (remainingQty <= 0) {
        log.debug("Vendor Bill already fully linked. Skipping VB ID: " + vendorBillarr[i].vbinternalid);
        continue;
    }

    for (var j = 0; j < itemReceiptarr.length && remainingQty > 0; j++) {
        var irId = itemReceiptarr[j].internalid;
        var irItem = itemReceiptarr[j].item;
        var irQty = itemReceiptarr[j].quantity;

        if (isAlreadyLinked(vendorBillarr[i].vbinternalid, irId)) {
            var linkedIrQty = getIrQuantity(irId);
            if (linkedIrQty >= irQty) {
                log.debug("IR ID " + irId + " is already fully linked.");
                continue;
            }
        }

        // Now check if the IR item matches VB item
        if (vendorBillarr[i].item == irItem) {
            // Perform linking
            var vb_save = record.submitFields({
                type: record.Type.VENDOR_BILL,
                id: vendorBillarr[i].vbinternalid,
                values: {
                    custbody_ada_created_from: irId
                },
                options: {
                    enableSourcing: false,
                    ignoreMandatoryFields: true
                }
            });

            var ir_save = record.submitFields({
                type: record.Type.ITEM_RECEIPT,
                id: irId,
                values: {
                    custbody_ada_created_from: vendorBillarr[i].vbinternalid
                },
                options: {
                    enableSourcing: false,
                    ignoreMandatoryFields: true
                }
            });

            log.debug("Linked partial: VB ID " + vb_save + " with IR ID " + ir_save);
            remainingQty -= irQty;
        }
    }

    // Enable checkbox on VB after processing
    enableCheck(vendorBillarr[i].vbinternalid);
}
