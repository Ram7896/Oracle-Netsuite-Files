/**
 * @NApiVersion 2.1
 * @NScriptType ClientScript
 */
define([], () => {

    /**
     * Function to handle field change events.
     * Evaluates rules outlined in image_d02f35.jpg
     */
    function fieldChanged(context) {
        const currentRecord = context.currentRecord;
        const fieldId = context.fieldId;

        // Grouping the worker compensation checkboxes for Rule 2
        const wcFields = [
            'custentity8',  // QLD
            'custentity9',  // NSW
            'custentity10', // VIC
            'custentity11', // SA
            'custentity12'  // WA
        ];

        // --- RULE 2: If user checks ANY Workers Compensation checkbox ---
        if (wcFields.includes(fieldId)) {
            const isAnyWcChecked = wcFields.some(id => currentRecord.getValue({ fieldId: id }) === true);

            if (isAnyWcChecked) {
                // Insurance = Checked
                currentRecord.setValue({ fieldId: 'custentity5', value: true, ignoreFieldChange: true });
                // Public Liability = Checked
                currentRecord.setValue({ fieldId: 'custentity7', value: true, ignoreFieldChange: true });
                // Email Insurance To = Mandatory
                const emailField = currentRecord.getField({ fieldId: 'custentity6' });
                if (emailField) emailField.isMandatory = true;
            }
        }

        // --- RULE 1: If Insurance (custentity5) is checked manually ---
        if (fieldId === 'custentity5') {
            const isInsuranceChecked = currentRecord.getValue({ fieldId: 'custentity5' });

            if (isInsuranceChecked) {
                // Public Liability = Checked automatically
                currentRecord.setValue({ fieldId: 'custentity7', value: true, ignoreFieldChange: true });
                // Email Insurance To = Mandatory
                const emailField = currentRecord.getField({ fieldId: 'custentity6' });
                if (emailField) emailField.isMandatory = true;
            } else {
                // Optional: Revert mandatory status if Insurance is unchecked
                const emailField = currentRecord.getField({ fieldId: 'custentity6' });
                if (emailField) emailField.isMandatory = false;
            }
        }
    }

    return {
        fieldChanged: fieldChanged
    };
});
