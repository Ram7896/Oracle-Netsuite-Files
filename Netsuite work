/**
 * @NApiVersion 2.1
 * @NScriptType UserEventScript
 */
define(['N/error', 'N/runtime'], (error, runtime) => {

    const ALLOWED_METHODS = ['26920', '26921'];
    const TARGET_VENDOR = '87625';

    const beforeSubmit = (context) => {

        const execContext = runtime.executionContext;

        if (
            execContext !== runtime.ContextType.USER_INTERFACE &&
            execContext !== runtime.ContextType.CSV_IMPORT
        ) return;

        if (
            context.type !== context.UserEventType.CREATE &&
            context.type !== context.UserEventType.EDIT
        ) return;

        const rec = context.newRecord;

        const vendorId = rec.getValue({ fieldId: 'entity' });
        const shipMethod = rec.getValue({ fieldId: 'shipmethod' });

       log.debug({
                    title: 'PO Validation Details',
                    details: {
                        executionContext: execContext,
                        vendorId: vendorId,
                        shippingMethod: shipMethod
                    }
                });
        if (String(vendorId) !== TARGET_VENDOR) return;

        if (!ALLOWED_METHODS.includes(String(shipMethod))) {

            throw error.create({
                name: 'INVALID_SHIP_METHOD_ERR',
                message: 'Shipping Method must be either 11 Corp Order or 18 EARLY Corp Order.',
                notifyOff: false
            });
        }
    };
    return { beforeSubmit };
});
