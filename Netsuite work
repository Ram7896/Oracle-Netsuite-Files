            }
            else {
                log.debug("Condition: VBs >= IRs triggered");
                // Each VB is linked to its corresponding IR (optional: use first IR or all)
                for (let j = 0; j < vbIds.length; j++) {
                    const vbId = vbIds[j];
                    var vb_save = record.submitFields({
                        type: record.Type.VENDOR_BILL,
                        id: vbId,
                        values: {
                            custbody_ada_linked_record: irIds
                        },
