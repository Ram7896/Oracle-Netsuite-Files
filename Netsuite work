                checklist.getValue({ fieldId: 'custrecord_cf_mains_power_correct' }) == 1,
                checklist.getValue({ fieldId: 'custrecord_cf_secure_no_obstructions' }) == 1,
                checklist.getValue({ fieldId: 'custrecord_cf_sensors_suit' }) == 1,
                checklist.getValue({ fieldId: 'custrecord_cf_danger_protection_sensors' }) == 1,
                checklist.getValue({ fieldId: 'custrecord_cf_any_hazards' }) == 2,
                checklist.getValue({ fieldId: 'custrecord_cf_switch_fitting' }) == 1,
                checklist.getValue({ fieldId: 'custrecord_cf_failsafe_op_charging' }) == 1,
                checklist.getValue({ fieldId: 'custrecord_cf_self_reprogram_aft_pf' }) == 1,
                checklist.getValue({ fieldId: 'custrecord_cf_door_secure' }) == 1,
                checklist.getValue({ fieldId: 'custrecord_cf_slow_speed_boost_adjusted' }) == 1,
                checklist.getValue({ fieldId: 'custrecord_cf_open_close_speed_adjusted' }) == 1,
                checklist.getValue({ fieldId: 'custrecord_cf_safety_reversing_adjusted' }) == 1,
                //checklist.getValue({fieldId:'custrecord_cf_reset_training'}) == 1,
                //checklist.getValue({fieldId:'custrecord_cf_alarm_voltage_free'}) == 1,
                //checklist.getValue({fieldId:'custrecord_cf_pelmet_secure_clean_fitted'}) == 1,
                //checklist.getValue({fieldId:'custrecord_cf_service_alarm_access'}) == 1,
                //checklist.getValue({fieldId:'custrecord_cf_usage_service_awareness'}) == 1,
