/**
 * @NApiVersion 2.x
 * @NScriptType ClientScript
 */
define(['N/currentRecord', 'N/record', 'N/search'], function(currentRecord, record, search) {

    function pageInit(context) {
            var currentRec = currentRecord.get();
            var subsidiaryId = currentRec.getValue({ fieldId: 'subsidiary' });
            alert('subsidiary Id:'+subsidiaryId);
            if (subsidiaryId) {
                // Assuming there's a custom field on Subsidiary that stores the due date
                var dueDate = currentRec.getValue({ fieldId: 'duedate' });
                alert("duedate"+ dueDate);
                if (dueDate) {
                    currentRec.setValue({
                        fieldId: 'custbody_legacy_date', // Replace with your actual Legacy Date field ID
                        value: dueDate
                    });
                }
            }
    }

    return {
        pageInit:pageInit
    };
});
