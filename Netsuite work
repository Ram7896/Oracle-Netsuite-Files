<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
	<head>
		<style>
			table {
				table-layout: fixed;
				font-family: Arial, Helvetica;
			}
			th {
				font-size: 8pt;
				vertical-align: middle;
			}
			h1 {
				text-transform: uppercase;
				font-family: Arial, Helvetica;
				font-size: 12pt;
				text-decoration: underline;
				padding: 0px 0px 20px 0px;
			}
			b {
				font-weight: bold;
				color: #333333;
			}
			p {
				align: left;
			}
			hr {
				width: 100%
				color: #d3d3d3;
				background-color: #d3d3d3;
				height: 1px;
			}
			body {
				font-family: Arial, Helvetica;
				font-size: 10pt;
			}
			table.page_title {
				width: 100%;
				padding: 0;
				margin: 0;
			}
			table.page_title td {
				align: right;
				valign: middle;
				font-size: 30;
				padding: 0;
				margin: 0;
			}
			table.page_title tr {
				padding: 0;
				margn: 0;
			}
			td.title {
				width: 60%;
			}
			td.number {
				font-size: 24;
			}
			td.date {
				font-size: 14;
				align: left;
			}
			table.header {
				padding: 0px;
				font-size: 6pt;
				width: 100%;
			}
			table.footer td {
				font-size: 14pt;
				font-weight: bold;
				valign: middle;
				text-transform: uppercase;
			}

        	table.projHeader {
        	  	font-size: 10pt;
        	  	font-family: Arial,Helvetica;
        	  	width: 100%;
        	  	background-color: #EEE;
        	  	align: center;
        	  	padding: 15px;
        	}

        	span.doorSection {
        	  margin: 0;
        	  padding: 0;
        	  page-break-inside: avoid;
        	  align: center;
        	  width: 100%;
        	}

        	table.doorDetails {
        	  font-size: 10pt;
        	  font-family: Arial,Helvetica;
        	  width: 100%;
        	  align: center;
        	  margin: 10px;
        	  background-color: #F7F7F7;
        	  page-break-inside: avoid;
        	}

        	table.additionalNotes {
        	  font-size: 10pt;
        	  font-family: Arial,Helvetica;
        	  width: 100%;
        	  align: center;
        	  margin: 10px;
        	  page-break-inside: avoid;
        	}

        	td.additionalNotes {
        	  border-bottom: 0.5px solid gray;
        	  height: 12pt;
        	}

        	table.partsUsed {
        	  font-size: 10pt;
        	  font-family: Arial,Helvetica;
        	  table-layout: fixed;
        	  width: 100%;
        	  align: center;
        	  margin: 10px;
        	  page-break-inside: avoid;
        	}

        	th.partsUsed {
        	  border-style: none;
        	  align: center;
        	}

        	td.partsUsed {
        	  border: 0.5px solid gray;
        	  height: 12pt;
        	}

        	table.followUps {
        	  font-size: 10pt;
        	  font-family: Arial,Helvetica;
        	  width: 100%;
        	  align: center;
        	  margin: 10px;
        	  page-break-inside: avoid;
        	}

        	table.signatures {
        	  font-size: 10pt;
        	  font-family: Arial,Helvetica;
        	  width: 100%;
        	  align: center;
        	  margin: 10px;
        	  page-break-inside: avoid;
        	  cellmargin: 10px;
        	  cellborder-bottom: 0.5 solid gray;
        	}

        	span.doorSection {
        	  margin: 0;
        	  padding: 0;
        	  page-break-inside: never;
        	}

        	span.notesSection {
        	  margin: 0;
        	  padding: 0;
        	  page-break-inside: never;
        	  page-break-before: always;
        	}

			/* ----------------------------- */
			/*     FIXED ALIGNMENT (ONLY)    */
			/* ----------------------------- */

			td {
				padding: 3px 2px;
				vertical-align: top;
			}

			table.projHeader td {
				padding: 4px 2px;
			}

			table.projHeader tr {
				line-height: 12pt;
			}

			table.projHeader {
				border-spacing: 0px;
			}

			td[align="right"] { text-align: right; }
			td[align="left"] { text-align: left; }
			td[valign="middle"] { vertical-align: middle; }

		</style>

		<macrolist>
			<macro id="ai_header">
				<table class="header">
					<tr>
						<td colspan="2">
          			  	    <img src="${subsidiary.pagelogo@url}"  width="250px" height="40px" style="float: left; margin: 0px; padding: 0px"/>
          			  	</td>
          			  	<td align="right">
          			  	  <p align="right">
          			  	  <b font-size="8pt">Auto Ingress Pty Ltd</b><br></br>
          			  	  ABN: 53 083 047 241 / ACN: 083 047 241<br></br>
          			  	  Email: accounts@autoingress.com.au<br></br>
          			  	  Web: autoingress.com.au<br></br>
    	  			  	  <b><i>Free Phone: 1300 138 750</i></b>
  		  			  	  </p>
          			  	</td>
          			</tr>
          			<tr>
						<td>
          			  	  <b>QLD:</b> 17-19 Cronulla Ct, SLACKS CREEK QLD 4127<br></br>
          			  	    PO Box 825, SPRINGWOOD QLD 4127<br></br>
          			  	  Phone (07) 3290 1500 / Fax (07) 3290 1567
          			  	</td>
          			  	<td>
          			  	  <b>NSW:</b> Unit 6, 19-26 Durian Pl, WETHERILL PARK NSW 2164<br></br>
          			  	    PO Box 6199, WETHERILL PARK NSW 2164<br></br>
          			  	  Phone (02) 9756 6590 / Fax (02) 9756 5210
          			  	</td>
          			  	<td>
          			  	  <b>VIC:</b> 37/189B South Centre Rd, TULLAMARINE VIC 3043<br></br>
          			  	    PO Box 300, TULLAMARINE VIC 3043<br></br>
          			  	  Phone (03) 9330 2220 / Fax (03) 9330 2228
          			  	</td>
          			</tr>
				</table>
				<hr></hr>
				<table class="page_title">
					<tr>
						<td></td>
						<td class="title">${case.custevent_nxc_call_out_priority?replace("Outside of Hours","AH","r")} Repair Breakdown</td>
					</tr>
					<tr>
						<td class="date">Created Date: ${case.startdate}</td>
						<td class="number">#${case.casenumber}</td>
					</tr>
				</table>
			</macro>

			<macro id="ai_footer">
				<table align="right" class="footer">
					<tr>
						<td>Think of Us Automatically</td>
						<td><img class="small_logo" src="${img_urls.logo_a?html}" style="height: 50px; width: 50px"></img></td>
					</tr>
				</table>
			</macro>
		</macrolist>
	</head>

	<body header="ai_header" header-height="19%" footer="ai_footer" footer-height="3%" padding="0.5in 0.5in 0.5in 0.5in" size="A4">

		<table class="projHeader">
        	<tr class="projHeader" style="padding-bottom: 2px;">
        	  	<td colspan="2"><b>Customer:  </b>${case.custevent_nx_customer?html}</td>
        	</tr>
        	<tr>
        	  	<td><b>Site: </b>${case.custevent_nx_case_asset?html}</td>
        	</tr>
        	<tr class="projHeader" style="padding-bottom: 2px; padding-top: 2px">
				<td colspan="2"><b>Address:  </b>${site.custrecord_nx_asset_address_text?replace("<br />",", ","r")}</td>
        	</tr>

        	<#if case.contact!='' || case.phone!=''>
        	<tr class="projHeader" style="padding-bottom: 2px; padding-top: 2px">
				<td colspan="2">
					<#if case.contact!=''>
						<b>Customer Contact: </b>
						<#if case_contact.entityid != ''>${case_contact.entityid?replace("&","&amp;","r")}</#if>
						<#if case_contact.phone != ''> / ${case_contact.phone}</#if>
						<#if case_contact.mobilephone != ''> / ${case_contact.mobilephone}</#if>
						<#if case_contact.email != ''> ( ${case_contact.email?html} )</#if>
					</#if>
				</td>
        	</tr>
        	</#if>

			<#if site.custrecordcustrecord_nxc_site_notes!=''>
       	  	<tr class="projHeader" style="padding-top: 2px;">
       	  		<td colspan="2"><b>Site Notes:  </b>${site.custrecordcustrecord_nxc_site_notes?replace("&","&amp;","r")}</td>
       	  	</tr>
       	  	</#if>

        	<tr class="projHeader" style="padding-top: 2px;">
        	  	<td colspan="2"><b>Case Details:  </b><br />${case.custevent_nx_case_details}</td>
        	</tr>

			<tr class="projHeader" style="padding-top: 2px;">
        	  	<td colspan="2"><b>Photo Requirement:</b></td>
        	</tr>	

			<tr class="projHeader" style="padding-top: 2px;">
				<td colspan="2">
					- For every commissioned door, provide two photos: inside and outside, clearly showing the modepad, sensors, switches, operator, and floor in the frame.<br/>
					- If any parts or doors are found damaged during a repair request or quote, please submit supporting photos.
				</td>
			</tr>
      	</table>

		<#list sub_assets.data as asset>
			<table class="doorDetails">
        	  <tr>
        	    <td><#if (asset.custrecord_nx_asset_serial)?? && asset.custrecord_nx_asset_serial!=''><b>Serial Number: </b>${asset.custrecord_nx_asset_serial?html}</#if></td>
        	    <td><#if (asset.custrecord_nxc_master_code)?? && asset.custrecord_nxc_master_code!=''><b>Master Code: </b>${(asset.custrecord_nxc_master_code)?html}</#if></td>
        	    <td colspan="2"><#if (asset.custrecord_nxc_manufacture_date)?? && asset.custrecord_nxc_manufacture_date?string!=''><b>Manufacture Date: </b>${asset.custrecord_nxc_manufacture_date}</#if></td>
        	  </tr>

        	  <#if (asset.custrecord_na_nxc_location_on_site)?? && asset.custrecord_na_nxc_location_on_site!=''>
        	    <tr>
        	      <td colspan="4"><b>Location Onsite: </b>${asset.custrecord_na_nxc_location_on_site?html}</td>
        	    </tr>
        	  </#if>

        	  <tr>
        	    <#if (asset.custrecord_nxc_make)?? && asset.custrecord_nxc_make!=''><td colspan="2"><b>Make: </b>${asset.custrecord_nxc_make}</td></#if>
        	    <#if (asset.custrecord_nxc_model)?? && asset.custrecord_nxc_model!=''><td colspan="2"><b>Model: </b>${asset.custrecord_nxc_model}</td></#if>
        	  </tr>

        	  <tr>
        	    <td colspan="2"><#if (asset.custrecord_nxc_locking)?? && asset.custrecord_nxc_locking!=''><b>Locking Type: </b>${asset.custrecord_nxc_locking}</#if></td>
        	    <td colspan="2"><#if (asset.custrecord_nxc_asset_type)?? && asset.custrecord_nxc_asset_type!=''><b>Door Type: </b>${asset.custrecord_nxc_asset_type}</#if></td>
        	  </tr>

              <#if (asset.custrecord_nxc_asset_notes)?? && asset.custrecord_nxc_asset_notes!=''>
              <tr>
                <td colspan="4"><b>Asset Notes: </b>${(asset.custrecord_nxc_asset_notes)?html}</td>
              </tr>
              </#if>

        	</table>
		</#list>

		<#assign numDoors=sub_assets.data?size>
		<#assign numLines=numDoors*6>
  		<#if numDoors gt 4><#assign numLines=18></#if>
  		<#if numDoors lt 2><#assign numLines=8></#if>

  		<span class="notesSection">

  		  <table class="additionalNotes">
  		    <tr class="additionalNotes">
  		      <td class="additionalNotes">Work Notes (please record specific serial numbers for quoting purposes): </td>
  		    </tr>
  		    <#list 1..numLines as i>
  		      <tr class="additionalNotes">
  		        <td class="additionalNotes"></td>
  		      </tr>
  		    </#list>
  		  </table>

  		  <table class="partsUsed">
  		    <tr class="partsUsed">
  		      <th class="partsUsed" width="15%">Serial Number</th>
  		      <th class="partsUsed" width="60%">Parts Used on this Visit (Description)</th>
  		      <th class="partsUsed" width="5%">Qty</th>
  		      <th class="partsUsed" width="20%">Faulty or Damaged</th>
  		    </tr>
  		    <#list 1..(numLines/2) as i>
  		      <tr class="partsUsed">
  		        <td class="partsUsed"> </td>
  		        <td class="partsUsed"> </td>
  		        <td class="partsUsed"> </td>
  		        <td class="partsUsed"> </td>
  		      </tr>
  		    </#list>
  		  </table>

  		  <table class="followUps">
  		    <tr>
  		      <td align="left"><b>Is Job Complete?</b></td>
  		      <td>Yes / No</td>
  		      <td align="left"><b>Follow-Up Required?</b></td>
  		      <td>Quote / Return Visit / Office to Contact Customer</td>
  		    </tr>
  		  </table>

  		  <table class="signatures">
  		    <tr>
  		      <td colspan="2">Arrival Time:</td>
  		      <td colspan="2">Departure Time:</td>
  		    </tr>
  		    <tr>
  		      <td colspan="2">Technician Name:</td>
  		      <td>Signature:</td>
  		      <td>Date:</td>
  		    </tr>
  		    <tr>
  		      <td colspan="2">Customer Name:</td>
  		      <td>Signature:</td>
  		      <td>Date:</td>
  		    </tr>
  		  </table>

  		</span>

	</body>
</pdf>
