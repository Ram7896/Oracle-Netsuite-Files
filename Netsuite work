<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
    <head>
        <link name="NotoSans" type="font" subtype="truetype" src="${nsfont.NotoSans_Regular}"
            src-bold="${nsfont.NotoSans_Bold}" src-italic="${nsfont.NotoSans_Italic}"
            src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />
        <#if .locale=="zh_CN">
            <link name="NotoSansCJKsc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKsc_Regular}"
                src-bold="${nsfont.NotoSansCJKsc_Bold}" bytes="2" />
        <#elseif .locale=="zh_TW">
            <link name="NotoSansCJKtc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKtc_Regular}"
                src-bold="${nsfont.NotoSansCJKtc_Bold}" bytes="2" />
        <#elseif .locale=="ja_JP">
            <link name="NotoSansCJKjp" type="font" subtype="opentype" src="${nsfont.NotoSansCJKjp_Regular}"
                src-bold="${nsfont.NotoSansCJKjp_Bold}" bytes="2" />
        <#elseif .locale=="ko_KR">
            <link name="NotoSansCJKkr" type="font" subtype="opentype" src="${nsfont.NotoSansCJKkr_Regular}"
                src-bold="${nsfont.NotoSansCJKkr_Bold}" bytes="2" />
        <#elseif .locale=="th_TH">
            <link name="NotoSansThai" type="font" subtype="opentype"
                src="${nsfont.NotoSansThai_Regular}" src-bold="${nsfont.NotoSansThai_Bold}" bytes="2" />
        </#if>

        <macrolist>
            <macro id="nlheader">
                <table width="100%">
                    <tr>
                        <td font-size="12pt" width="40%"><b>Linkedge international pte Ltd</b></td>
                        <td width="40%">
                            <span font-size="12pt"><b>ASN LIST</b></span><br /><br />
                            <span font-size="8pt"><b>LINKEDGE(linkedge int pte ltd)</b><br />
                            <b>2002934739(linkedge int pte ltd)</b><br />
                            <b>From ASN date :</b></span>
                        </td>
                    </tr>
                    <tr><td>&nbsp;</td></tr>
                </table>
                <table width="100%">
                    <tr>
                        <td width="40%">
                            <b>Print date :</b> ${.now}<br /><br />
                            <b>Print by :</b> ${record.createdby}<br /><br />
                            <b>Page No :</b> <pagenumber /> of <totalpages />
                        </td>
                        <td width="30%">&nbsp;</td>
                        <td width="30%">
                            <b>ASN No :</b> ${record.tranid}<br />
                            <barcode codetype="code128" showtext="true" value=" " />
                        </td>
                    </tr>
                </table>
            </macro>
        </macrolist>

        <style type="text/css">
            <#if .locale=="zh_CN">body { font-family: NotoSans, NotoSansCJKsc, sans-serif; }
            <#elseif .locale=="zh_TW">body { font-family: NotoSans, NotoSansCJKtc, sans-serif; }
            <#elseif .locale=="ja_JP">body { font-family: NotoSans, NotoSansCJKjp, sans-serif; }
            <#elseif .locale=="ko_KR">body { font-family: NotoSans, NotoSansCJKkr, sans-serif; }
            <#elseif .locale=="th_TH">body { font-family: NotoSans, NotoSansThai, sans-serif; }
            <#else>body { font-family: NotoSans, sans-serif; }</#if>

            table {
                font-size: 9pt;
                table-layout: fixed;
            }

            th {
                font-weight: bold;
                font-size: 8pt;
                vertical-align: middle;
                padding: 5px 6px 3px;
                background-color: #e3e3e3;
                color: #333333;
            }

            td {
                padding: 4px 6px;
            }

            b {
                font-weight: bold;
                color: #333333;
            }

            table.header td, table.footer td {
                padding: 0;
                font-size: 10pt;
            }

            table.itemtable th {
                padding: 10px 6px;
            }

            td.addressheader {
                font-size: 8pt;
                font-weight: bold;
                padding-top: 6px;
                padding-bottom: 2px;
            }

            span.title { font-size: 28pt; }
            span.number { font-size: 16pt; }

            hr {
                border-top: 1px dashed #d3d3d3;
                height: 1px;
                color: #ffffff;
                background-color: #ffffff;
                width: 100%;
            }
        </style>
    </head>

    <body header="nlheader" header-height="20%" padding="0.5in 0.5in 0.5in 0.5in" size="Letter">

        <table style="width: 100%;">
            <#assign loopCount=0>
            <#list purchaseorder as item>
                <#assign loopCount=loopCount + 1>
            </#list>
            <tr>
                <td width="15%"><b>Container No</b></td>
                <td width="20%">: </td>
                <td width="15%">&nbsp;</td>
                <td width="15%">&nbsp;</td>
                <td width="13%">&nbsp;</td>
                <td width="16%">&nbsp;</td>
                <td width="5%">&nbsp;</td>
            </tr>
            <tr>
                <td><b>PO No</b></td>
                <td>: <b><u></u></b></td>
                <td><b>ASN Date</b></td>
                <td>: <b>${record.trandate}</b></td>
                <td><b>Status</b></td>
                <td>: <b>New</b></td>
                <td>&nbsp;</td>
            </tr>
            <tr>
                <td><b>Trans Code</b></td>
                <td>: <b>PO</b></td>
                <td><b>ETA Date</b></td>
                <td>: <b>${record.createdfrom.duedate}</b></td>
                <td><b>Ref No</b></td>
                <td>: <b>${record.createdfrom.tranid}</b></td>
                <td>&nbsp;</td>
            </tr>
            <tr>
                <td><b>Supplier Code</b></td>
                <td>: <b>${record.entity?keep_before(" ")}</b></td>
                <td><b>Created Date</b></td>
                <td>: <b>${record.trandate}</b></td>
                <td><b>Remark1</b></td>
                <td>: <b>${record.memo}</b></td>
                <td><b>MIX</b></td>
            </tr>
            <tr>
                <td><b>Supplier Name</b></td>
                <td>: <b>${record.entity?keep_after(" ")}</b></td>
                <td><b>Total Line(s)</b></td>
                <td>: <b>${loopCount}</b></td>
                <td><b>&nbsp;</b></td>
                <td><b>&nbsp;</b></td>
                <td>&nbsp;</td>
            </tr>
        </table>

        <br />

        <!-- Table for Line Items -->
        <table width="100%" border="1pt">
            <#assign loopCount=0>
            <#list purchaseorder as item>
                <#assign loopCount=loopCount + 1>
                <#if item_index == 0>
                    <tr border-bottom="1pt">
                        <td width="4%" background-color="#999999">NO</td>
                        <td width="18%" background-color="#999999">Product Code</td>
                        <td width="26%" background-color="#999999">Description</td>
                        <td width="18%" background-color="#999999">Barcode</td>
                        <td width="15%" background-color="#999999">Quantity Expected TO Receive</td>
                        <td width="10%" background-color="#999999">UOM Code</td>
                        <td width="9%" background-color="#999999">Expire Date</td>
                    </tr>
                </#if>
                <tr>
                    <td>${loopCount}</td>
                    <td>
                        ${item.item}<br />
                        <barcode codetype="code128" showtext="true" value=" " />
                    </td>
                    <td>${item.description}</td>
                    <td>
                        ${item.custcol_abj_p_gcas}<br />
                        <barcode codetype="code128" showtext="true" value=" " />
                    </td>
                    <td>${item.quantityreceived}</td>
                    <td>${item.units}</td>
                    <td></td>
                </tr>
            </#list>
        </table>
    </body>
</pdf>
