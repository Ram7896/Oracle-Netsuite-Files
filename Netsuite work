/**
 * @NApiVersion 2.1
 * @NScriptType Suitelet
 */
define(['N/ui/serverWidget', 'N/search', 'N/record', 'N/runtime', 'N/llm'], function(ui, search, record, runtime, llm) {

    function onRequest(context) {
        if (context.request.method === 'GET') {
            // Form to enter the requirement
            var form = ui.createForm({title: 'Create Saved Search using LLM'});
            var requirementField = form.addField({
                id: 'custpage_requirement',
                type: ui.FieldType.LONGTEXT,
                label: 'Enter Saved Search Requirement'
            });
            requirementField.layoutType = ui.FieldLayoutType.NORMAL;
            requirementField.updateLayoutType({
                layoutType: ui.FieldLayoutType.OUTSIDEABOVE
            });
            form.addSubmitButton('Create Saved Search');
            context.response.writePage(form);
            
        } else { 
            // POST: Handle form submit
            var requirementText = context.request.parameters.custpage_requirement;

            // Use LLM module to generate a JSON saved search definition
            var prompt = `Given this NetSuite requirement: "${requirementText}", generate a SuiteScript 2.1 JSON object for search.create(). Do NOT explain, just output JSON only.`;
            
            var generatedText = llm.generateText({
                model: 'gpt-4',
                prompt: prompt,
                temperature: 0.2,
                maxTokens: 1500
            });

            var generatedJson;
            try {
                generatedJson = JSON.parse(generatedText.text); // parse the JSON
            } catch (e) {
                throw 'Error parsing LLM response: ' + generatedText.text;
            }

            // Create Saved Search dynamically
            var createdSearch = search.create(generatedJson);
            var searchId = createdSearch.save();

            var form = ui.createForm({title: 'Saved Search Created!'});
            form.addField({
                id: 'custpage_message',
                type: ui.FieldType.INLINEHTML,
                label: ' '
            }).defaultValue = '<div style="color:green;font-weight:bold;">Saved Search Created Successfully! ID: ' + searchId + '</div>';

            context.response.writePage(form);
        }
    }

    return {
        onRequest: onRequest
    };
});
