      <tr><td>Check the integrity of the holding point fixings</td><td></td><td></td><td></td><td></td></tr>
      <tr><td>Check all moving parts for signs of wear</td><td></td><td></td><td></td><td></td></tr>
      <tr><td>Check electrical components and replace if necessary</td><td></td><td></td><td></td><td></td></tr>
      <tr><td>Test electric locking system</td><td></td><td></td><td></td><td></td></tr>
