/**
 * @NApiVersion 2.1
 * @NScriptType Suitelet
 */
define(['N/record', 'N/redirect', 'N/log'], function (record, redirect, log) {
    function onRequest(context) {
        try {
            if (context.request.method === 'GET') {
                var ncrId = context.request.parameters.custscript_igs_ncr_id;
                log.debug('Suitelet Start', 'NCR Id: ' + ncrId);

                try {
                    var ncrCustomRecord = record.load({
                        type: 'customrecord3044',
                        id: ncrId
                    });

                    var vendorId = ncrCustomRecord.getValue({
                        fieldId: 'custrecord_gns_stl_ncrreturnedtovendor'
                    });
                    var itemId = ncrCustomRecord.getValue({
                        fieldId: 'custrecord_gns_stl_partwnc'
                    });
                    var poId = ncrCustomRecord.getValue({
                        fieldId: 'custrecord_gns_stl_poncr'
                    });
                    log.debug("Po Id:", poId);
                    var ncrQuantity = ncrCustomRecord.getValue({
                        fieldId: 'custrecord_quantity'
                    });
                    log.debug("NCR Quantity:", ncrQuantity);

                    var poRecord = record.load({
                        type: record.Type.PURCHASE_ORDER,
                        id: poId
                    });

                    var lineCount = poRecord.getLineCount({ sublistId: 'item' });
                    var found = false;
                    var lineRate, lineTaxCode;

                    for (var i = 0; i < lineCount; i++) {
                        var poItemId = poRecord.getSublistValue({
                            sublistId: 'item',
                            fieldId: 'item',
                            line: i
                        });

                        if (poItemId == itemId) {
                            found = true;
                            lineRate = poRecord.getSublistValue({
                                sublistId: 'item',
                                fieldId: 'rate',
                                line: i
                            });
                            lineTaxCode = poRecord.getSublistValue({
                                sublistId: 'item',
                                fieldId: 'taxcode',
                                line: i
                            });
                            break;
                        }
                    }

                    if (found) {
                        log.debug('Matched PO Line', {
                            itemId: itemId,
                            lineRate: lineRate,
                            taxcode: lineTaxCode,
                            quantity: ncrQuantity
                        });

                        redirect.toRecord({
                            type: record.Type.VENDOR_RETURN_AUTHORIZATION,
                            isEditMode: true,
                            parameters: {
                              fromSuitelet: 'T',
                                ncid: ncrId,
                                entity: vendorId,
                                item: itemId,
                                quantity: ncrQuantity,
                                rate: lineRate,
                                taxcode: lineTaxCode
                            }
                        });
                    } else {
                        log.error('Item Not Found', 'Item ' + itemId + ' not found on PO ' + poId);
                        context.response.write('Item not found on Purchase Order.');
                    }

                } catch (loadErr) {
                    log.error('Record Load Error', loadErr);
                    context.response.write('Error loading NCR record: ' + loadErr.message);
                }
            }
        } catch (outerErr) {
            log.error('Suitelet Error', outerErr);
            context.response.write('Unexpected error in Suitelet: ' + outerErr.message);
        }
    }

    return { onRequest: onRequest };
});
