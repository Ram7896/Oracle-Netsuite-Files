/**
 * @NApiVersion 2.1
 * @NScriptType ClientScript
 */

define([], () => {

    const INSURANCE = 'custentity5';
    const EMAIL_INSURANCE = 'custentity6';
    const PUBLIC_LIABILITY = 'custentity7';

    const WC_FIELDS = [
        'custentity8', // QLD
        'custentity9', // NSW
        'custentity10', // VIC
        'custentity11', // SA
        'custentity12'  // WA
    ];

    function fieldChanged(context) {

        try {

            let rec = context.currentRecord;
            let fieldId = context.fieldId;

            // Rule 1
            if (fieldId === INSURANCE) {

                let insurance = rec.getValue({
                    fieldId: INSURANCE
                });

                if (insurance) {

                    rec.setValue({
                        fieldId: PUBLIC_LIABILITY,
                        value: true,
                        ignoreFieldChange: true
                    });

                    makeMandatory(true);

                } else {

                    if (!isAnyWCChecked(rec)) {
                        makeMandatory(false);
                    }
                }
            }

            // Rule 2
            if (WC_FIELDS.includes(fieldId)) {

                if (isAnyWCChecked(rec)) {

                    rec.setValue({
                        fieldId: INSURANCE,
                        value: true,
                        ignoreFieldChange: true
                    });

                    rec.setValue({
                        fieldId: PUBLIC_LIABILITY,
                        value: true,
                        ignoreFieldChange: true
                    });

                    makeMandatory(true);

                } else {

                    if (!rec.getValue({
                        fieldId: INSURANCE
                    })) {
                        makeMandatory(false);
                    }
                }
            }

        } catch (e) {
            console.log('ERROR', e);
        }
    }

    function isAnyWCChecked(rec) {

        return WC_FIELDS.some(field =>
            rec.getValue({ fieldId: field }) === true
        );
    }

    function makeMandatory(isMandatory) {

        let fld =
            document.getElementById('custentity6_fs_lbl');

        if (fld) {

            if (isMandatory) {

                fld.classList.add('uir-required-icon');

            } else {

                fld.classList.remove('uir-required-icon');
            }
        }
    }

    function saveRecord(context) {

        let rec = context.currentRecord;

        let insurance =
            rec.getValue({
                fieldId: INSURANCE
            });

        let email =
            rec.getValue({
                fieldId: EMAIL_INSURANCE
            });

        if (insurance && !email) {

            alert(
                'Email Insurance To is mandatory.'
            );

            return false;
        }

        return true;
    }

    return {
        fieldChanged,
        saveRecord
    };

});
