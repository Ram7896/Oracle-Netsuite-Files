/**
 * @NApiVersion 2.x
 * @NScriptType UserEventScript
 */
define(['N/ui/serverWidget', 'N/log'], function(serverWidget, log) {

    function beforeLoad(context) {
        if (context.type !== context.UserEventType.VIEW) return;

        var form = context.form;
        var rec = context.newRecord;
        var recordId = rec.id;

        var formNumber = 186; // Your Advanced PDF template ID
        var pdfUrl = '/app/accounting/print/hotprint.nl?regular=T&sethotprinter=T' +
                     '&formnumber=' + formNumber +
                     '&trantype=custinvc' +
                     '&id=' + recordId +
                     '&label=Invoice&printtype=transaction';

        log.debug('PDF URL', pdfUrl);

        // Use inline JS that dynamically creates an <a> tag and triggers download
       form.addButton({
    id: 'custpage_print_pdf_button',
    label: 'Download PDF',
    functionName: "var link = document.createElement('a'); link.href='" + pdfUrl + "'; link.download='Invoice_" + recordId + ".pdf'; document.body.appendChild(link); link.click(); document.body.removeChild(link);"
});


        log.debug('Download Button Added', 'custpage_download_pdf_button');
    }

    return {
        beforeLoad: beforeLoad
    };
});
