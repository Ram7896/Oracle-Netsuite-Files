/**
 * @NApiVersion 2.1
 * @NScriptType ScheduledScript
 */

define(['N/query', 'N/log', 'N/file'], (query, log, file) => {

    const execute = () => {

        const suiteQL = `
            SELECT
                ptll.nexttype        AS dcf_doc_type,
                ptll.nextdoc         AS dcf_doc_id,
                ptll.previousdoc     AS applied_to_doc_id,
                ptll.previoustype    AS previous_doc_type,
                ptll.foreignamount   AS applied_amount,
                t.id                 AS transaction_id,
                t.tranid             AS transaction_number,
                t.type               AS transaction_type,
                t.trandate           AS transaction_date,
                BUILTIN.DF(t.status) AS transaction_status,
                t.currency           AS currency_id,
                t.exchangerate
            FROM previoustransactionlinelink ptll
            LEFT JOIN transaction t
                ON t.id = ptll.previousdoc
            WHERE ptll.nexttype IN ('CustRfnd','Deposit','CustPymt','VendPymt','Journal')
            AND t.type = 'CustInvc'
        `;

        const results = query.runSuiteQL({ query: suiteQL }).asMappedResults();

        log.audit('TOTAL ROWS', results.length);

        if (!results.length) return;

        let csv = '';

        const headers = Object.keys(results[0]).map(h =>
            h.replace(/_/g, ' ').toUpperCase()
        );

        csv += headers.join(',') + '\n';

        results.forEach(row => {
            const line = Object.keys(row).map(k => {
                let v = row[k];
                if (!v) v = '';
                return `"${String(v).replace(/"/g, '""')}"`;
            }).join(',');

            csv += line + '\n';
        });

        const fileObj = file.create({
            name: 'FAST_EXPORT_' + Date.now() + '.csv',
            fileType: file.Type.CSV,
            contents: csv,
            folder: 58032
        });

        const fileId = fileObj.save();

        log.audit('CSV CREATED', fileId);
    };

    return { execute };

});
