/**********************************************
 * Script Name			:	
 * Author               : 
 * Creation date		: 24th March 2025
 * Company	  			: Capgemini India
 * Description          : This script is used to linked Item receipt to vendor bill record and linked Vendor bill to Item receipt record.
 */
/**
 * @NApiVersion 2.1
 * @NScriptType ScheduledScript
 */
define(['N/record', 'N/search', 'N/url', 'N/runtime', 'N/format'], (record, search, url, runtime, format) => {
    const execute = (context) => {
        try {
            var vendorbillSearchObj = search.create({
                type: "vendorbill",
                settings: [{ "name": "consolidationtype", "value": "ACCTTYPE" }],
                filters: [
                    ["type", "anyof", "VendBill"],
                    "AND",
                    ["mainline", "is", "F"],
                    "AND",
                    ["appliedtotransaction.type", "anyof", "PurchOrd"],
                    "AND",
                    ["status", "anyof", "VendBill:A"],
                    "AND",
                    ["appliedtotransaction.status", "anyof", "PurchOrd:D", "PurchOrd:E", "PurchOrd:B", "PurchOrd:G", "PurchOrd:F"],
                    "AND",
                    ["appliedtotransaction.internalid", "anyof", "2093074", "2093302"]
                ],
                columns: [
                    search.createColumn({ name: "trandate", label: "Date" }),
                    search.createColumn({ name: "datecreated", label: "Date Created", sort: search.Sort.ASC }),
                    search.createColumn({ name: "tranid", label: "Bill Invoice no" }),
                    search.createColumn({ name: "invoicenum", label: "Bill Invoice no" }),
                    search.createColumn({ name: "statusref", label: "Bill Status" }),
                    search.createColumn({ name: "item", label: "Item" }),
                    search.createColumn({ name: "internalid", label: "InternalId" }),
                    search.createColumn({ name: "quantity", label: "Quantity" }),
                    search.createColumn({ name: "custcol_ada_po_qty", label: "PO Qty" }),
                    search.createColumn({ name: "amount", label: "Amount" }),
                    search.createColumn({
                        name: "tranid",
                        join: "appliedToTransaction",
                        label: "Purchase Number"
                    })
                ]
            });

            var searchResultCount = vendorbillSearchObj.runPaged().count;
            log.debug("vendorbillSearchObj result count", searchResultCount);
            let start = 0;
            let searchResults;
            const vendorBillResponse = [];

            if (searchResultCount > 0) {
                do {
                    searchResults = vendorbillSearchObj.run().getRange({
                        start: start * 1000,
                        end: (start + 1) * 1000,
                    });

                    searchResults.forEach((res) =>
                        vendorBillResponse.push({
                            billinvoicenumber: res.getValue("tranid"),
                            billtrandate: res.getValue("trandate"),
                            billin: res.getValue("invoicenum"),
                            billstatus: res.getValue("statusref"),
                            item: res.getValue("item"),
                            quantity: res.getValue("quantity"),
                            poquantity: res.getValue("custcol_ada_po_qty"),
                            amount: res.getValue("amount"),
                            vbinternalid: res.getValue("internalid"),
                            datecreated: res.getValue("datecreated"),
                            poDoc: res.getValue({ name: "tranid", join: "appliedToTransaction" })
                        })
                    );
                    start++;
                } while (searchResults.length == 1000);
            }

            var itemreceiptSearchObj = search.create({
                type: "itemreceipt",
                settings: [{ "name": "consolidationtype", "value": "ACCTTYPE" }],
                filters: [
                    ["type", "anyof", "ItemRcpt"],
                    "AND",
                    ["mainline", "is", "F"],
                    "AND",
                    ["appliedtotransaction.type", "anyof", "PurchOrd"],
                    "AND",
                    ["appliedtotransaction.status", "anyof", "PurchOrd:D", "PurchOrd:E", "PurchOrd:B", "PurchOrd:G", "PurchOrd:F"],
                    "AND",
                    ["appliedtotransaction.internalid", "anyof", "2093074", "2093302"]
                ],
                columns: [
                    search.createColumn({ name: "tranid", label: "IR Number" }),
                    search.createColumn({ name: "internalid", label: "IR Internal ID" }),
                    search.createColumn({ name: "item", label: "Item" }),
                    search.createColumn({ name: "quantity", label: "Quantity" }),
                    search.createColumn({ name: "datecreated", label: "Date Created", sort: search.Sort.ASC }),
                    search.createColumn({
                        name: "tranid",
                        join: "appliedToTransaction",
                        label: "Purchase Number"
                    })
                ]
            });

            var searchResultCountIR = itemreceiptSearchObj.runPaged().count;
            log.debug("itemreceiptSearchObj result count", searchResultCountIR);
            let starting = 0;
            let searchResult;
            const itemReceiptResponse = [];

            if (searchResultCountIR > 0) {
                do {
                    searchResult = itemreceiptSearchObj.run().getRange({
                        start: starting * 1000,
                        end: (starting + 1) * 1000,
                    });

                    searchResult.forEach((result) =>
                        itemReceiptResponse.push({
                            itemreceiptnumber: result.getValue("tranid"),
                            internalid: result.getValue("internalid"),
                            item: result.getValue("item"),
                            quantity: result.getValue("quantity"),
                            datecreated: result.getValue("datecreated"),
                            poDoc: result.getValue({ name: "tranid", join: "appliedToTransaction" })
                        })
                    );
                    starting++;
                } while (searchResult.length == 1000);
            }

            log.debug("Vendor Bill Response", vendorBillResponse);
            log.debug("Item Receipt Response", itemReceiptResponse);

            // Create a new array to collect only valid Vendor Bills
            let filteredVendorBills = [];

            // First, filter vendor bills that are eligible
            for (let i = 0; i < vendorBillResponse.length; i++) {
                let canProcess = true;

                for (let j = 0; j < itemReceiptResponse.length; j++) {
                    if (vendorBillResponse[i].poDoc == itemReceiptResponse[j].poDoc) {
                        if (itemReceiptResponse[j].datecreated < vendorBillResponse[i].datecreated) {
                            log.debug("IR created first for PO " + vendorBillResponse[i].poDoc + ". Skipping this Vendor Bill.");
                            canProcess = false;
                            break; // No need to check more
                        }
                    }
                }

                if (canProcess) {
                    filteredVendorBills.push(vendorBillResponse[i]);
                    log.debug("Filtered Vendor Bills:", filteredVendorBills);
                }
            }

            // Now only call itemComparsion on eligible vendor bills
            if (filteredVendorBills.length > 0) {
                itemComparsion(filteredVendorBills, itemReceiptResponse);
            } else {
                log.debug("No eligible Vendor Bills to process after date check.");
            }
        } catch (error) {
            log.debug("Error in Scheduled Script:", error.message);
        }
    };

    function itemComparsion(vendorBillarr, itemReceiptarr) {
        try {
            var vbSumQty = 0;
            var IRSumQty = 0;
            var vbIdArr = [];
            var irIdArr = [];
            log.debug("Function Item Comparison triggered");
            for (var i = 0; i < vendorBillarr.length; i++) {
                for (var j = 0; j < itemReceiptarr.length; j++) {
                    if (!isAlreadyLinked(vendorBillarr[i].vbinternalid, itemReceiptarr[j].internalid)) {

                        if (vendorBillarr[i].item == itemReceiptarr[j].item && vendorBillarr[i].quantity == itemReceiptarr[j].quantity) {
                            log.debug("Linking process started");
                            var vb_save = record.submitFields({
                                type: record.Type.VENDOR_BILL,
                                id: vendorBillarr[i].vbinternalid,
                                values: {
                                    custbody_ada_linked_record: itemReceiptarr[j].internalid
                                },
                                options: {
                                    enableSourcing: false,
                                    ignoreMandatoryFields: true
                                }
                            });
                            if (vb_save) {
                                enableCheck(vendorBillarr[i].vbinternalid);
                            }
                            var ir_save = record.submitFields({
                                type: record.Type.ITEM_RECEIPT,
                                id: itemReceiptarr[j].internalid,
                                values: {
                                    custbody_ada_linked_record: vendorBillarr[i].vbinternalid
                                },
                                options: {
                                    enableSourcing: false,
                                    ignoreMandatoryFields: true
                                }
                            });

                            log.debug("Linking successful: VB ID " + vb_save + " - IR ID " + ir_save);
                            vendorBillarr.splice(i, 1);
                            itemReceiptarr.splice(j, 1);
                            i--;
                            break;

                        }

                        else if (vendorBillarr[i].poDoc == itemReceiptarr[j].poDoc && vendorBillarr[i].item == itemReceiptarr[j].item) {
                            log.debug('else if execute in term partail IRBill', 'else if execute in term partail IRBill->>');
                            if (vendorBillarr.length > itemReceiptarr.length) {
                                vbSumQty += parseInt(vendorBillarr[i].quantity);
                                IRSumQty = parseInt(itemReceiptarr[j].quantity);
                                if (vbIdArr.indexOf(vendorBillarr[i].vbinternalid) == '-1') {
                                    vbIdArr.push(vendorBillarr[i].vbinternalid);
                                }
                                if (irIdArr.indexOf(itemReceiptarr[j].internalid) == '-1') {
                                    irIdArr.push(itemReceiptarr[j].internalid);
                                }
                            }
                            if (itemReceiptarr.length > vendorBillarr.length) {
                                IRSumQty += parseInt(itemReceiptarr[j].quantity);
                                vbSumQty = parseInt(vendorBillarr[i].quantity);
                                if (vbIdArr.indexOf(vendorBillarr[i].vbinternalid) == '-1') {
                                    vbIdArr.push(vendorBillarr[i].vbinternalid);
                                }
                                if (irIdArr.indexOf(itemReceiptarr[j].internalid) == '-1') {
                                    irIdArr.push(itemReceiptarr[j].internalid);
                                }

                            }
                            log.debug("VB Sum Quantity Array:", vendorBillarr);
                            log.debug("VB Sum Quantity length:", vendorBillarr.length);
                            log.debug("IR Sum Quantity:", itemReceiptarr);
                            log.debug("IR Sum Quantity length:", itemReceiptarr.length);
                            log.debug(" vendor bill Item:", vendorBillarr[i].item);
                            log.debug("Item Receipt Item:", itemReceiptarr[j].item);
                            log.debug(" vendor bill Quantity:", vendorBillarr[i].quantity);
                            log.debug("Item Receipt Quantity:", itemReceiptarr[j].quantity);
                            log.debug('vbSumQty->>', 'vbSumQty->>' + vbSumQty);
                            log.debug('IRSumQty->>', 'IRSumQty->>' + IRSumQty);
                            if (vendorBillarr[i].item == itemReceiptarr[j].item && vbSumQty == IRSumQty) {

                                log.debug('all set to link->>', 'all set to link->>');
                                partialIRVbLink(vendorBillarr[i].vbinternalid, itemReceiptarr[j].internalid, vbIdArr, irIdArr)
                                vbSumQty = 0;
                                IRSumQty = 0;
                            }


                        }
                        else {
                            log.debug("item comaprsion else triggered");
                            enableCheck(vendorBillarr[i].vbinternalid);
                            vendorBillarr.splice(i, 1);
                            itemReceiptarr.splice(j, 1);
                            i--;
                            break;

                        }
                    } else {
                        log.debug("Its not linked condition else triggered");
                        enableCheck(vendorBillarr[i].vbinternalid);
                        vendorBillarr.splice(i, 1);
                        itemReceiptarr.splice(j, 1);
                        i--;
                        break;

                    }
                }
            }
        } catch (error) {
            log.debug("Error in itemComparsion:", error.message);
        }
    }
    function partialIRVbLink(vbinternalid, irinternalid, vbIdArr, irIdArr) {
        log.debug('partialIRVbLink->>', 'partialIRVbLink->>>');
        log.debug('vbIdArr->>', 'vbIdArr->>>' + vbIdArr);
        log.debug('irIdArr->>', 'irIdArr->>>' + irIdArr);
        if (irIdArr.length > vbIdArr.length) {
            for (var r = 0; r < irIdArr.length; r++) {
                var vb_save = record.submitFields({
                    type: record.Type.VENDOR_BILL,
                    id: vbinternalid,
                    values: {
                        custbody_ada_linked_record: irIdArr
                    },
                    options: {
                        enableSourcing: false,
                        ignoreMandatoryFields: true
                    }
                });
                if (vb_save) {
                    enableCheck(vbinternalid);
                }
                var ir_save = record.submitFields({
                    type: record.Type.ITEM_RECEIPT,
                    id: irIdArr[r],
                    values: {
                        custbody_ada_linked_record: vbIdArr
                    },
                    options: {
                        enableSourcing: false,
                        ignoreMandatoryFields: true
                    }
                });
            }
        }
        else {
            for (var v = 0; v < vbIdArr.length; v++) {
                var vb_save = record.submitFields({
                    type: record.Type.VENDOR_BILL,
                    id: vbIdArr[v],
                    values: {
                        custbody_ada_linked_record: irIdArr
                    },
                    options: {
                        enableSourcing: false,
                        ignoreMandatoryFields: true
                    }
                });
                if (vb_save) {
                    enableCheck(vbIdArr[v]);
                }
                var ir_save = record.submitFields({
                    type: record.Type.ITEM_RECEIPT,
                    id: irinternalid,
                    values: {
                        custbody_ada_linked_record: vbIdArr
                    },
                    options: {
                        enableSourcing: false,
                        ignoreMandatoryFields: true
                    }
                });
            }

        }

    }
    function enableCheck(vbInternalId) {
        try {
            const vendorBill = search.lookupFields({
                type: record.Type.VENDOR_BILL,
                id: vbInternalId,
                columns: ['custbody_ada_linked_record']
            });
            log.debug("Vendor bill search lookup value:", vendorBill);

            var createdFrom = (vendorBill.custbody_ada_linked_record && vendorBill.custbody_ada_linked_record.length > 0) ? vendorBill.custbody_ada_linked_record[0].value : '';
            log.debug("created from vb value:", createdFrom);

            if (createdFrom) {
                log.debug("Make payment false:");
                record.submitFields({
                    type: record.Type.VENDOR_BILL,
                    id: vbInternalId,
                    values: {
                        custbody_ada_vb_ir: false
                    },
                    options: {
                        enableSourcing: false,
                        ignoreMandatoryFields: true
                    }
                });
                log.debug("record is submitted");
            } else {
                log.debug("Make payment checkbox enabled");
                record.submitFields({
                    type: record.Type.VENDOR_BILL,
                    id: vbInternalId,
                    values: {
                        custbody_ada_vb_ir: true
                    },
                    options: {
                        enableSourcing: false,
                        ignoreMandatoryFields: true
                    }
                });
            }
        } catch (error) {
            log.debug("Error in Enable Check:", error.message);
        }

    }
    function isAlreadyLinked(vendorBillId, itemReceiptId) {
        const vendorBill = search.lookupFields({
            type: record.Type.VENDOR_BILL,
            id: vendorBillId,
            columns: ['custbody_ada_linked_record']
        });
        const itemReceipt = search.lookupFields({
            type: record.Type.ITEM_RECEIPT,
            id: itemReceiptId,
            columns: ['custbody_ada_linked_record']
        });

        const linkedIR = vendorBill.custbody_ada_linked_record && vendorBill.custbody_ada_linked_record.length > 0;
        log.debug("Linked Ir:", linkedIR);
        const linkedVB = itemReceipt.custbody_ada_linked_record && itemReceipt.custbody_ada_linked_record.length > 0;
        log.debug("Linked Vb:", linkedVB);
        log.debug("is already linked", linkedVB || linkedIR);
        return linkedVB || linkedIR;
    }

    return {
        execute: execute
    };
});
