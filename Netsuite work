<#if images.imageList?has_content>

<h3 style="font-size:12pt; margin-top:15px;">Job Images</h3>

<table style="width: 100%; table-layout:fixed; border-collapse:separate; border-spacing:10px;">
  <#assign col = 0>
  <tr>

  <#list images.imageList as img>
    <td align="center" style="width:33%;">
      <img src="${img.url?replace('&','&amp;')}" width="200" height="150" style="border:1px solid #cccccc;"/><br/>
      <p style="font-size:9pt; margin-top:5px;">
        ${img.description?html}
      </p>
    </td>

    <#assign col = col + 1>

    <#if col == 3>
      </tr>
      <tr>
      <#assign col = 0>
    </#if>

  </#list>

  </tr>
</table>

</#if>
