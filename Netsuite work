define(['N/record', 'N/search', 'N/error', 'N/ui/serverWidget'],
    /**
     * @param {record} record
     * @param {search} search
     * @param {error} err
     * @param {serverWidget} serverWidget
     */
    function (record, search, err, serverWidget) {
        /**
         * Function definition to be triggered before record is loaded.
         *
         * @param {Object} context
         * @param {Record} context.newRecord - New record
         * @param {string} context.type - Trigger type
         * @param {Form} context.form - Current form
         * @Since 2015.2
         */
        function beforeLoad(context) {
            var nsForm = context.form;
            //log.debug('type',recType);
            //06/04/2020:Case 1094 Code Start AS
            var nsField = nsForm.getField({
                id: 'memo'
            });

            nsField.isMandatory = true;
            //06/04/2020:Case 1094 Code End AS
        }


        /**
         * Function definition to be triggered before record is loaded.
         *
         * @param {Object} scriptContext
         * @param {Record} scriptContext.newRecord - New record
         * @param {Record} scriptContext.oldRecord - Old record
         * @param {string} scriptContext.type - Trigger type
         * @Since 2015.2
         */
        function beforeSubmit(scriptContext) {
            if (scriptContext.type == scriptContext.UserEventType.DELETE) {
                return;
            }
            var nsRecord = scriptContext.newRecord;
            var lineCostCenter;
            var resultsSearch;
            var lineCount;
            ////06/09/2020:Case 1309 Code End AS
            var nsMemo = nsRecord.getValue({ fieldId: "memo" });
            var testRegex = /kickout/i;
            var findKickout = testRegex.test(nsMemo);
            if (findKickout) {
                //log.debug('kickout',findKickout);
                return;
            }
            //06/09/2020:Case 1309 Code End AS

            //build the search and return into array  	
            var comboSearch = buildComboSearch();

            //Get the line number count of the imported file to loop through 

            var numLines = nsRecord.getLineCount({
                sublistId: 'line'
            });

            // log.debug('lineCount', numLines);

            var adaSubsidiary = nsRecord.getValue({ fieldId: 'subsidiary' });
            //used to return the line number in which the invalid cost center exist in the import
            var currentLine = 1;

            var jeName = nsRecord.getValue({ fieldId: 'memo' });
            log.debug("JE Name:", jeName);
            var checkNumber = nsRecord.getValue({ fieldId: 'createdfrom' });
            if (checkNumber) {
                var checkDetails = search.lookupFields({
                    type: search.Type.CHECK,
                    id: checkNumber,
                    columns: ['memo', 'type']
                });
                var checkMemo = checkDetails.memo;
                log.debug("memo:", checkMemo);
                var recType = checkDetails.type[0].value;
                log.debug("Rec Type:", recType);
            }

            else {
                // execute when check number is empty
                log.debug("Check Number", "Not Found");
            }

            //Loop through and validate each line  
            for (lineCount = 0; lineCount < numLines; lineCount++) {

                currentLine++;

                //get the cost center form the lines           	  
                lineCostCenter = nsRecord.getSublistValue({
                    sublistId: 'line',
                    fieldId: 'department',
                    line: lineCount
                });

                if (nsRecord.type == 'intercompanyjournalentry' || nsRecord.type == 'advintercompanyjournalentry') {
                    //get  line level subsidiary for intercompany journals 
                    adaSubsidiary = nsRecord.getSublistValue({
                        sublistId: 'line',
                        fieldId: 'linesubsidiary',
                        line: lineCount
                    });
                }

                //call function to run the combo search
                resultsSearch = runSubCombSearch(comboSearch, adaSubsidiary, lineCostCenter);

                // log.debug("Remaining governance units: " + scriptObj.getRemainingUsage());
                //If the search results returns a -1 the script will  throw an error
                if (resultsSearch < 0) {

                   

                    log.debug('adaSubsidiary', adaSubsidiary);
                    log.debug('lineCostCenter', lineCostCenter);

                    throw err.create({
                        name: "ADA_INVALID_SUB_CC_COMBO",
                        message: "The subsidiary cost center combo on line " + currentLine + " is invalid",
                        notifyOff: true
                    });
                }
            }
        }

        return {
            beforeLoad: beforeLoad,
            beforeSubmit: beforeSubmit

        };

        /**
         * Function definition to run the combo search
         * 
         * @param {string} adaSubsidiary - the subsidiary
         * @param {string} costCenter - cost center to compare against 
         * 
         */
        function runSubCombSearch(searchArray, adaSub, adaCC) {
            var adaArray = searchArray;
            var subCombo = adaSub + '-' + adaCC;
            //log.debug('subcombo',subCombo);
            var searchResult = adaArray.indexOf(subCombo);
            //log.debug('searchresult', searchResult);
            //returns a -1 if no valid combo is found 
            return searchResult;
        }
        /***
         * 
         * Function builds the array from the custom record 
         * subsidiary cost center combo for quicker searching 
         * of valid combos
         * 
         */
        function buildComboSearch() {
            var subComboList = [];
            var pageSize = 1000;
            var start = 0;
            var results = [];

            var subComboSearch = search.create({
                type: 'customrecord_ada_sub_costcenter_combos',
                columns: [
                    { name: 'custrecord_ada_subsidiary_combo' },
                    { name: 'custrecord_ada_costcenter_combo' }
                ],
                filters: [
                    ['isinactive', 'is', 'F']
                ]
            });

            do {
                results = subComboSearch.run().getRange({ start: start, end: start + pageSize });

                for (var i = 0; i < results.length; i++) {
                    var combo = results[i].getValue({ name: 'custrecord_ada_subsidiary_combo' }) + '-' +
                        results[i].getValue({ name: 'custrecord_ada_costcenter_combo' });
                    subComboList.push(combo);
                }

                start += pageSize;
            } while (results.length === pageSize);

            log.debug('Total combos retrieved:', subComboList.length);
            return subComboList;
        }
    }); View	System	JS_EXCEPTION	5/6/2026	12:33 am		org.mozilla.javascript.EcmaError: TypeError: Cannot read property "0" from undefined (/SuiteScripts/ada_ue_sub_cc_comb.js#97); ID:
