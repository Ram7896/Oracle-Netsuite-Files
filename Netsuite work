else if (
    vendorBillarr[i].poNumber === itemReceiptarr[j].poNumber &&
    vendorBillarr[i].item === itemReceiptarr[j].item
) {
    // Existing logic: IRs that add up to match a VB
    let matchedIRs = [];
    let totalIRQty = 0;

    for (let k = 0; k < itemReceiptarr.length; k++) {
        if (
            itemReceiptarr[k].poNumber === vendorBillarr[i].poNumber &&
            itemReceiptarr[k].item === vendorBillarr[i].item &&
            !isAlreadyLinked(vendorBillarr[i].vbinternalid, itemReceiptarr[k].internalid)
        ) {
            totalIRQty += parseFloat(itemReceiptarr[k].quantity || 0);
            matchedIRs.push(itemReceiptarr[k]);
        }

        if (totalIRQty >= parseFloat(vendorBillarr[i].quantity)) break;
    }

    if (totalIRQty === parseFloat(vendorBillarr[i].quantity)) {
        // Link VBs to multiple IRs
        matchedIRs.forEach(ir => {
            record.submitFields({
                type: record.Type.ITEM_RECEIPT,
                id: ir.internalid,
                values: {
                    custbody_ada_created_from: vendorBillarr[i].vbinternalid
                },
                options: {
                    enableSourcing: false,
                    ignoreMandatoryFields: true
                }
            });
        });

        const irIds = matchedIRs.map(ir => ir.internalid);
        record.submitFields({
            type: record.Type.VENDOR_BILL,
            id: vendorBillarr[i].vbinternalid,
            values: {
                custbody_ada_created_from: irIds
            },
            options: {
                enableSourcing: false,
                ignoreMandatoryFields: true
            }
        });
        enableCheck(vendorBillarr[i].vbinternalid);
    }

    // New logic: Multiple VBs matching a single IR
    let matchedVBs = [];
    let totalVBQty = 0;

    for (let v = 0; v < vendorBillarr.length; v++) {
        if (
            vendorBillarr[v].poNumber === itemReceiptarr[j].poNumber &&
            vendorBillarr[v].item === itemReceiptarr[j].item &&
            !isAlreadyLinked(vendorBillarr[v].vbinternalid, itemReceiptarr[j].internalid)
        ) {
            totalVBQty += parseFloat(vendorBillarr[v].quantity || 0);
            matchedVBs.push(vendorBillarr[v]);
        }

        if (totalVBQty >= parseFloat(itemReceiptarr[j].quantity)) break;
    }

    if (totalVBQty === parseFloat(itemReceiptarr[j].quantity)) {
        log.debug("Multiple VBs matched to one IR");

        // Link IR to each VB
        matchedVBs.forEach(vb => {
            record.submitFields({
                type: record.Type.VENDOR_BILL,
                id: vb.vbinternalid,
                values: {
                    custbody_ada_created_from: itemReceiptarr[j].internalid
                },
                options: {
                    enableSourcing: false,
                    ignoreMandatoryFields: true
                }
            });
            enableCheck(vb.vbinternalid);
        });

        const vbIds = matchedVBs.map(vb => vb.vbinternalid);
        record.submitFields({
            type: record.Type.ITEM_RECEIPT,
            id: itemReceiptarr[j].internalid,
            values: {
                custbody_ada_created_from: vbIds
            },
            options: {
                enableSourcing: false,
                ignoreMandatoryFields: true
            }
        });
    }
}
