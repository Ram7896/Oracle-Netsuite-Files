define([], () => {

```
const INSURANCE = 'custentity5';
const EMAIL = 'custentity6';
const PUBLIC = 'custentity7';

const WC_FIELDS = [
    'custentity8',
    'custentity9',
    'custentity10',
    'custentity11',
    'custentity12'
];

function fieldChanged(context) {

    const rec = context.currentRecord;
    const fieldId = context.fieldId;

    // Only trigger for WC fields
    if (WC_FIELDS.includes(fieldId)) {

        let isChecked = rec.getValue({
            fieldId: fieldId
        });

        if (isChecked) {

            // Auto check Insurance
            rec.setValue({
                fieldId: INSURANCE,
                value: true,
                ignoreFieldChange: true
            });

            // Auto check Public Liability
            rec.setValue({
                fieldId: PUBLIC,
                value: true,
                ignoreFieldChange: true
            });

            // Make Email mandatory
            let emailField =
                rec.getField({
                    fieldId: EMAIL
                });

            if (emailField) {
                emailField.isMandatory = true;
            }
        }
    }
}

function saveRecord(context) {

    const rec =
        context.currentRecord;

    let anyChecked =
        WC_FIELDS.some(f =>
            rec.getValue({
                fieldId: f
            })
        );

    if (
        anyChecked &&
        !rec.getValue({
            fieldId: EMAIL
        })
    ) {

        alert(
            'Email Insurance To is mandatory'
        );

        return false;
    }

    return true;
}

return {
    fieldChanged,
    saveRecord
};
