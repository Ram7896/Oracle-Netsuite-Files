<soapenv:Envelope
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"
    xmlns:platformCore="urn:core_2021_2.platform.webservices.netsuite.com"
    xmlns:platformMsgs="urn:messages_2021_2.platform.webservices.netsuite.com"
    xmlns:tranSales="urn:sales_2021_2.transactions.webservices.netsuite.com">

    <soapenv:Header>
        <platformMsgs:tokenPassport>
            <platformCore:account>{{account}}</platformCore:account>
            <platformCore:consumerKey>{{consumerKey}}</platformCore:consumerKey>
            <platformCore:token>{{tokenId}}</platformCore:token>
            <platformCore:nonce>{{nonce}}</platformCore:nonce>
            <platformCore:timestamp>{{timestamp}}</platformCore:timestamp>
            <platformCore:signature algorithm="HMAC_SHA256">{{signature}}</platformCore:signature>
        </platformMsgs:tokenPassport>
    </soapenv:Header>

    <soapenv:Body>
        <platformMsgs:add>
            <platformMsgs:record xsi:type="tranSales:SalesOrder">
                <!-- Customer Reference -->
                <tranSales:entity internalId="323" xsi:type="platformCore:RecordRef"/>

                <!-- Subsidiary Reference -->
                <tranSales:subsidiary internalId="2" xsi:type="platformCore:RecordRef"/>

                <!-- Transaction Date -->
                <tranSales:tranDate>2025-02-12T00:00:00.000Z</tranSales:tranDate>

                <!-- Custom Field List with Multi-Select -->
                <tranSales:customFieldList>
                    <platformCore:customField xsi:type="platformCore:MultiSelectCustomFieldRef" scriptId="custbody1">
                        <platformCore:value internalId="757"/>
                    </platformCore:customField>
                    <platformCore:customField xsi:type="platformCore:MultiSelectCustomFieldRef" scriptId="custbody1">
                        <platformCore:value internalId="860"/>
                    </platformCore:customField>
                </tranSales:customFieldList>

                <!-- Item List -->
                <tranSales:itemList>
                    <tranSales:item>
                        <tranSales:item internalId="17" xsi:type="platformCore:RecordRef"/>
                        <tranSales:quantity>2</tranSales:quantity>
                        <tranSales:amount>300.00</tranSales:amount>
                    </tranSales:item>
                </tranSales:itemList>
            </platformMsgs:record>
        </platformMsgs:add>
    </soapenv:Body>
</soapenv:Envelope>


<?xml version="1.0" encoding="UTF-8"?>
<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <soapenv:Body>
        <soapenv:Fault>
            <faultcode>soapenv:Server.userException</faultcode>
            <faultstring>An unexpected error occurred.</faultstring>
            <detail>
                <platformFaults:invalidCredentialsFault xmlns:platformFaults="urn:faults_2021_2.platform.webservices.netsuite.com">
                    <platformFaults:code>UNEXPECTED_ERROR</platformFaults:code>
                    <platformFaults:message>An unexpected error occurred.</platformFaults:message>
                </platformFaults:invalidCredentialsFault>
                <ns1:hostname xmlns:ns1="http://xml.apache.org/axis/">partners111</ns1:hostname>
            </detail>
        </soapenv:Fault>
    </soapenv:Body>
</soapenv:Envelope>
