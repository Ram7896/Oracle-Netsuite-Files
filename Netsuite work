/**
 * @NApiVersion 2.1
 * @NScriptType ClientScript
 */
define(['N/url', 'N/currentRecord'], function(url, currentRecord) {

    function fieldChanged(context) {
        if (context.sublistId === 'item' && context.fieldId === 'custcol_open_suitelet_checkbox') {
            var rec = currentRecord.get();
            var line = context.line;

            var checked = rec.getSublistValue({
                sublistId: 'item',
                fieldId: 'custcol_open_suitelet_checkbox',
                line: line
            });

            if (checked) {
                var suiteletUrl = url.resolveScript({
                    scriptId: 'customscript_your_suitelet_scriptid',
                    deploymentId: 'customdeploy_your_suitelet_deploymentid',
                    params: {
                        recordId: rec.id || '',
                        line: line
                    }
                });

                // Open Suitelet in a popup window
                window.open(suiteletUrl, 'SuiteletPopup', 'width=600,height=400,resizable=yes,scrollbars=yes');
            }
        }
    }

    return {
        fieldChanged: fieldChanged
    };
});
