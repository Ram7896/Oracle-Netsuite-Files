/**
 * @NApiVersion 2.1
 * @NScriptType Suitelet
 * @description SuiteScript 1.0 → 2.1 Converter using ChatGPT
 */

define(['N/ui/serverWidget', 'N/https', 'N/log', 'N/runtime'],
(serverWidget, https, log, runtime) => {

const onRequest = (context) => {

    const request = context.request;
    const response = context.response;

    if (request.method === 'GET') {

        const form = createForm('', '');
        response.writePage(form);

    } else {

        const ss10Code = request.parameters.custpage_ss10 || '';

        let convertedCode = '';

        if (ss10Code) {
            convertedCode = convertScript(ss10Code);
        }

        const form = createForm(ss10Code, convertedCode);
        response.writePage(form);

    }
};


/* ---------------- FORM UI ---------------- */

function createForm(inputValue, outputValue) {

    const form = serverWidget.createForm({
        title: 'AI SuiteScript 1.0 → 2.1 Converter'
    });

    const input = form.addField({
        id: 'custpage_ss10',
        type: serverWidget.FieldType.LONGTEXT,
        label: 'Paste SuiteScript 1.0 Code'
    });

    input.updateDisplaySize({
        height: 25,
        width: 100
    });

    input.defaultValue = inputValue || '';


    const output = form.addField({
        id: 'custpage_ss21',
        type: serverWidget.FieldType.LONGTEXT,
        label: 'Converted SuiteScript 2.1'
    });

    output.updateDisplaySize({
        height: 25,
        width: 100
    });

    output.updateDisplayType({
        displayType: serverWidget.FieldDisplayType.INLINE
    });

    output.defaultValue = outputValue || '';

    form.addSubmitButton({
        label: 'Convert Script'
    });

    return form;

}


/* ---------------- OPENAI API CALL ---------------- */

function convertScript(script10) {

    try {

        const apiKey = runtime.getCurrentScript().getParameter({
            name: 'custscript_openai_api_key'
        });

        if (!apiKey) {
            return 'Error: OpenAI API Key not configured.';
        }

        const url = 'https://api.openai.com/v1/chat/completions';

        const payload = {

            model: 'gpt-4o-mini',

            messages: [

                {
                    role: 'system',
                    content: `
You are a NetSuite SuiteScript expert.

Convert SuiteScript 1.0 code to SuiteScript 2.1.

Rules:
- Use ES6 syntax (const, let, arrow functions)
- Use define([...], (...) => {})
- Replace nlapi functions with N/ modules
- Add @NApiVersion 2.1
- Add @NScriptType
- Output only converted code
`
                },

                {
                    role: 'user',
                    content: script10
                }

            ],

            temperature: 0
        };

        const apiResponse = https.post({

            url: url,

            headers: {

                'Content-Type': 'application/json',
                'Authorization': 'Bearer ' + apiKey

            },

            body: JSON.stringify(payload)

        });


        if (apiResponse.code !== 200) {

            log.error('OpenAI Error', apiResponse.body);

            return 'API Error: ' + apiResponse.body;

        }


        const result = JSON.parse(apiResponse.body);

        const output = result.choices[0].message.content;

        return output;


    } catch (e) {

        log.error('Conversion Error', e);

        return 'Error: ' + e.message;

    }

}

return { onRequest };

});
