<!DOCTYPE html>
<html>
<head>
<style>
    .img-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }
    .img-table td {
        text-align: center;
        vertical-align: top;
        padding: 8px;
    }
    .desc {
        font-size: 10pt;
        margin-top: 5px;
    }
    img {
        max-width: 230px;
        max-height: 200px;
    }
</style>
</head>
<body>

<h2>Service Images</h2>

<table class="img-table" border="1">
    <tr>
        <td>
            <#if record.custbody_img1?has_content>
                <img src="${record.custbody_img1}"/>
            </#if>
            <div class="desc">
                After S/N 25060 L2 entry to library
            </div>
        </td>

        <td>
            <#if record.custbody_img2?has_content>
                <img src="${record.custbody_img2}"/>
            </#if>
            <div class="desc">
                S/N 25060 entry L2 push button not working
            </div>
        </td>

        <td>
            <#if record.custbody_img3?has_content>
                <img src="${record.custbody_img3}"/>
            </#if>
            <div class="desc">
                S/N 24921 after replaced end pulley wheel
            </div>
        </td>
    </tr>

    <tr>
        <td>
            <#if record.custbody_img4?has_content>
                <img src="${record.custbody_img4}"/>
            </#if>
            <div class="desc">
                S/N 24921 Basement entry, end pulley wheel cracked
            </div>
        </td>
    </tr>
</table>

</body>
</html>
