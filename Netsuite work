    /**
     * Closes the provided case (and any related tasks) with notes explaining 
     *     why.
     * @memberof aiCostTools
     *
     * @param {InternalId} case_id - The case to be closed.
     * @param {string} note - The note to be added.
     * @param {boolean} [chargeable=false] - An indication of whether or not the
     *     works were chargeable (if the case should generate a sales order).
     */
    function closeCase(case_id, note, chargeable) {
      if ( chargeable == undefined ) chargeable = false;
      // Gather tasks
      search.create({
        type: search.Type.TASK,
        filters: [['case.internalid', 'anyof', case_id]],
        columns: ['internalid'],
      }).run().each( function(result) {
        // Close tasks (with user notes)
        var task_id = result.getValue({name: 'internalid'});
        record.submitFields({
          type: record.Type.TASK,
          id: task_id,
          values: {'status' : 'COMPLETE'}
        });
        addUserNoteAct( task_id, 'Closing Task', note );
        return true;
      }); // end search
      // Close case (with user notes)
      record.submitFields({
        type: record.Type.SUPPORT_CASE,
        id: case_id,
        values: {
          'custevent_ai_works_notchargeable': chargeable,
          'status': '5', // '5'Closed
        },
      });
      addUserNoteAct(case_id, 'Closing Case', note);
    } // end closeCase

    /**
     * An object representing the status of a chargeable item on an order.
     * @typedef {Object} ChargeStatus
     * @property {number} qty - The quantity required on the order.
     * @property {boolean} present - Whether or not the item is present on the
     *     order in question.
     * @property {string} name - The display name of the charge in question.
     */

    /**
     * A map of chargeable item records (by id) and the qty required on the 
     *     given order along with an indication of their presence on the 
     *     current order.
     * @typedef {Object.<InternalId,ChargeStatus>} Charges
     */

    /**
     * An object holding the standard rates and the extra rates for an order.
     * @typedef {Object} Rates
     * @property {Charges} std - The standard charges for the order.
     * @property {Charges} extra - The additional charges for the order (
     *     typically these are added on a separate sales order ).
     * @property {boolean} qtly_merge - Whether or not a qtly has been merged
     *     into the case if the case type is that of a breakdown.
     * @property {boolean} missing_qtly_rates - Whether the qtly maintenance
     *     rates could not be found under the project structure.
     */

    /**
     * Generates a map of required charges to their quantity.
     * @memberof aiCostTools
     *
     * @param {CaseDetails} case_details - Object storing key details about the 
     *     case in question.
     * @param {ServiceRates} customer_rates - Special rates the customer is due.
     * @param {?Array.<CaseDetails>} [cases_to_merge=null] - A list of cases
     *     that are to be merged with the current one.
     * @returns {Rates} - The std and extra rates required by the order.
     */
    function gatherRates(case_details, customer_rates, cases_to_merge) {
      if ( cases_to_merge == undefined ) cases_to_merge = null;
      // Gather maintenance rates (if maintenance case) or service rates if 
      // breakdown type case
      var rates = {};
      var extra_rates = {}; // to be added to their own separate order
      var time_on_site = ait.gatherTimeOnsite(case_details.id);
      var qtly_merge = false;
      var missing_rates = false;

      // '1'Major or '6'Minor Maintenance
      if ( case_details.type == '1' || case_details.type == '6' ) { 
        var raw_rates = gatherMaintenanceCosts( case_details.project );
        log.debug({title: 'raw_rates', details: JSON.stringify(raw_rates)});
        if ( raw_rates == null ) {
          missing_rates = true;
        } else {
          // Filter out rates for doors that have not been tested
          var num_contract_doors = 0;
          raw_rates.forEach( function(el) {
            el.sub_assets = el.sub_assets.filter( function(asset_id) {
              var found_asset = case_details.tests.find( function(test) {
                return test.asset == asset_id && test.outcome != 'No Test';
              });
              return found_asset != undefined;
            });
            if ( el.sub_assets.length == 0 ) {
              delete rates[el.id];
            } else {
              rates[el.id] = {
                qty: el.sub_assets.length,
                name: el.name,
                present: false,
              };
            }
            num_contract_doors += el.sub_assets.length;
          });
          log.debug({title: 'num_contract_doors', details: num_contract_doors});
          log.debug({title: 'rates', details: JSON.stringify(rates)});
          // Add rates for doors that were tested in addition to contract doors
          // '2598' Service Program Rate - $100
          var default_maintenance_rate = '2598'; 
          var num_adn_doors = case_details.tests.length - num_contract_doors;
          log.debug({title: 'num_adn_doors', details: num_adn_doors})
          if ( num_adn_doors > 0 ) {
            extra_rates[default_maintenance_rate] = num_adn_doors;
          }
          log.debug({
            title: 'extra_rates',
            details: JSON.stringify(extra_rates),
          });
          // If maintenance has been upgraded to breakdown other than P3
          var rsnbl_hrs_per_door = 0.5;
          if ( case_details.priority && case_details.priority != '3' ) {
            rates[customer_rates.callout] = {
              qty: 1,
              name: 'Customer Callout Fee',
              present: false,
            };
            rsnbl_hrs_per_door = 0.33;
          }
          // Calculated and add reasonable additional time if needed
          var reasonable_hours = case_details.tests.length * rsnbl_hrs_per_door;
          if ( time_on_site > reasonable_hours ) {
            rates[customer_rates.labour] = {
              qty: time_on_site - reasonable_hours,
              name: 'Customer Labour',
              present: false,
            };
          }
        }

      } else if ( case_details.type == '2' ) { // Repair Breakdown

        rates[customer_rates.callout] = {
          qty: 1,
          name: 'Customer Callout Fee',
          present: false,
        };
        rates[customer_rates.labour] = {
          qty: time_on_site,
          name: 'Customer Labour',
          present: false,
        };
        // Handle maintenance cases to merge
        if ( cases_to_merge && cases_to_merge.length > 0 ) {
          qtly_merge = true;
          cases_to_merge.forEach( function(c) {
            // Add maintenance rates to current case
            var maint_rates = gatherMaintenanceCosts(c.project);
            if ( maint_rates == null ) {
              missing_rates = true;
            } else {
              maint_rates.forEach( function(el) {
                if ( rates[el.id] ) {
                  rates[el.id].qty += el.sub_assets.length;
                } else {
                  rates[el.id] = {
                    qty: el.sub_assets.length,
                    name: el.name,
                    present: false,
                  };
                }
              });
              // Close out maintenance case with notes (and no-charge)
              closeCase(
                  c.id,
                  'System merging this job with case: ' + case_details.number,
                  true
              );
            }
          });
          // Modulate labour qty to account for reasonable maintenance time
          var rsnbl_hrs_per_door = 0.33;
          var reasonable_hours =
              case_details.tests.length * rsnbl_hrs_per_door;
          if ( time_on_site > reasonable_hours ) {
            rates[customer_rates.labour].qty = time_on_site - reasonable_hours;
          }
        }
      }

      // If the labour amount is less than 15mins, remove it from the order
      if ( rates[customer_rates.labour] &&
          rates[customer_rates.labour].qty < 0.25 ) {
        delete rates[customer_rates.labour];
      }

      /*for ( var key in rates ) {
        rates[key] = {qty: rates[key], present: false};
      }*/
      for ( var key in extra_rates ) {
        extra_rates[key] = {
          qty: extra_rates[key],
          name: 'Extra Charge',
          present: false,
        };
      }

      return {
        std: rates,
        extra: extra_rates,
        qtly_merge: qtly_merge,
        missing_qtly_rates: missing_rates,
      };
    }; // end gatherRates

    /**
     * A Netsuite record loaded with the N/record module in dynamic mode.
     * @typedef {Object} DynamicRecord
     */

    /**
     * Given an order already loaded with the 'N/record' module, add lines for
     *     any required rates that are not already present.
     * @memberof aiCostTools
     *
     * @param {DynamicRecord} order - The order to modify.
     * @param {Charges} rates - The required rates to be added and their qty.
     * @param {CaseDetails} case_details - Key details about the case in 
     *     question.
     * @returns {boolean} - True if an item was added or false if no items were
     *     added.
     */
    function addRequiredRates(order, rates, case_details) {
      var added_items = false;
      var rate_ids = Object.keys(rates);
      // If no rates can be found, add an error line to the order so it can
      // still be raised.
      if ( rate_ids.length == 0 ) {
        order.selectNewLine({sublistId: 'item'});
        order.setCurrentSublistValue({
          sublistId: 'item',
          fieldId: 'item',
          value: '2647',
        });
        order.setCurrentSublistValue({
          sublistId: 'item',
          fieldId: 'quantity',
          value: 1,
        });
        order.setCurrentSublistValue({
          sublistId: 'item',
          fieldId: 'description',
          value: 'ERROR - No Required Rates Found',
        });
        order.commitLine({sublistId: 'item'});
        added_items = null;
      } else {
        rate_ids.forEach( function(key) {
          if ( !rates[key].present ) {
            order.selectNewLine({sublistId: 'item'});
            order.setCurrentSublistValue({
              sublistId: 'item',
              fieldId: 'item',
              value: key,
            });
            order.setCurrentSublistValue({
              sublistId: 'item',
              fieldId: 'quantity',
              value: rates[key].qty.toFixed(2),
            });
            order.setCurrentSublistValue({
              sublistId: 'item',
              fieldId: 'department',
              value: case_details.asset_dept,
            });
            // Check warranty and commit line
            checkLineForWarrantyAndCommit(order, case_details);
            added_items = true;
          }
        });
      }
      return added_items;
    }; // end addRequiredRates

