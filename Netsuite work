/**
 * @NApiVersion 2.1
 * @NScriptType Suitelet
 * @description SS1.0 to SS2.1 Converter using Google Gemini API.
 */

define(['N/ui/serverWidget', 'N/https', 'N/log'], 
(serverWidget, https, log) => {

    // Your Google API Key
    const GEMINI_API_KEY = 'AIzaSyBk1W9IufiempJLpbuyXumgyc6qWimzOkw';

    const onRequest = (context) => {
        const { request, response } = context;

        if (request.method === 'GET') {
            const form = createConverterForm('', '');
            response.writePage(form);
        } 
        else if (request.method === 'POST') {
            const script10 = request.parameters.custpage_ss10 || '';
            const convertedScript = convertScript(script10);

            const form = createConverterForm(script10, convertedScript);
            response.writePage(form);
        }
    };

    function createConverterForm(inputVal, outputVal) {
        const form = serverWidget.createForm({
            title: 'SuiteScript 1.0 → 2.1 Gemini Converter'
        });

        const inputField = form.addField({
            id: 'custpage_ss10',
            type: serverWidget.FieldType.LONGTEXT,
            label: 'Paste SuiteScript 1.0 Code'
        });
        inputField.defaultValue = inputVal;
        inputField.updateDisplaySize({ height: 25, width: 80 });

        const outputField = form.addField({
            id: 'custpage_ss21',
            type: serverWidget.FieldType.LONGTEXT,
            label: 'Converted SuiteScript 2.1 Result'
        });
        outputField.defaultValue = outputVal;
        outputField.updateDisplaySize({ height: 25, width: 80 });

        form.addSubmitButton({
            label: inputVal ? 'Convert Again' : 'Convert Script'
        });

        return form;
    }

    function convertScript(script10) {
        try {
            if (!script10) return "Please provide source code.";

            // Gemini API Endpoint
            const url = 'https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=' + GEMINI_API_KEY;

            const payload = {
                contents: [{
                    parts: [{
                        text: "You are a NetSuite expert. Convert this SuiteScript 1.0 code to 2.1 using modern ES6 syntax. Provide ONLY the code, no markdown code blocks:\n\n" + script10
                    }]
                }]
            };

            const apiResponse = https.post({
                url: url,
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });

            const result = JSON.parse(apiResponse.body);

            if (result.error) {
                return "Google API Error: " + result.error.message;
            }

            // Extracting response from Gemini's nested JSON structure
            if (result.candidates && result.candidates[0].content.parts[0].text) {
                return result.candidates[0].content.parts[0].text.trim();
            }

            return "Unexpected Response Format.";

        } catch (e) {
            log.error("Conversion Error", e);
            return "Error: " + e.message;
        }
    }

    return { onRequest };
});
