/**
 * @NApiVersion 2.1
 * @NScriptType Suitelet
 */
define(['N/ui/serverWidget'], (ui) => {

    const onRequest = (context) => {
        if (context.request.method === 'GET') {
            createForm(context, '', '');
        } else {
            const ss1Code = context.request.parameters.custpage_ss1_code || '';
            const convertedCode = convertToSS2(ss1Code);
            createForm(context, ss1Code, convertedCode);
        }
    };

    function createForm(context, ss1Code, ss2Code) {
        const form = ui.createForm({
            title: 'SuiteScript 1.0 → 2.x Converter'
        });

        form.addFieldGroup({
            id: 'custpage_fg',
            label: 'Converter'
        });

        // --- SuiteScript 1.0 Input ---
        const ss1Field = form.addField({
            id: 'custpage_ss1_code',
            type: ui.FieldType.TEXTAREA,
            label: 'SuiteScript 1.0 Code',
            container: 'custpage_fg',
            displaySize: { width: 60, height: 25 }
        });
        ss1Field.defaultValue = ss1Code;

        // --- SuiteScript 2.x Output ---
        const ss2Field = form.addField({
            id: 'custpage_ss2_code',
            type: ui.FieldType.TEXTAREA,
            label: 'Converted SuiteScript 2.x Code',
            container: 'custpage_fg',
            displaySize: { width: 60, height: 25 }
        });
        ss2Field.defaultValue = ss2Code;
        ss2Field.updateDisplayType({
            displayType: ui.FieldDisplayType.INLINE
        });

        form.addSubmitButton({
            label: 'Convert to SuiteScript 2.x'
        });

        context.response.writePage(form);
    }

    function convertToSS2(code) {
        let output = code;

        const rules = [
            { from: /nlapiCreateRecord\(/g, to: 'record.create(' },
            { from: /nlapiLoadRecord\(/g, to: 'record.load(' },
            { from: /nlapiSubmitRecord\(/g, to: 'rec.save(' },
            { from: /setFieldValue/g, to: 'setValue' },
            { from: /getFieldValue/g, to: 'getValue' },
            { from: /nlapiLogExecution\(/g, to: 'log.debug(' },
            { from: /nlapiSearchRecord/g, to: 'search.create' }
        ];

        rules.forEach(rule => {
            output = output.replace(rule.from, rule.to);
        });

        output =
`/**
 * @NApiVersion 2.1
 * @NScriptType UserEventScript
 */
define(['N/record', 'N/log', 'N/search'], (record, log, search) => {

${output}

    return {};
});
`;

        return output;
    }

    return { onRequest };
});
