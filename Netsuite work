function itemComparsion(vendorBillarr, itemReceiptarr) {
    try {
        log.debug("Function Item Comparison triggered");

        for (let i = 0; i < vendorBillarr.length; i++) {
            let vb = vendorBillarr[i];
            let vbTotalQty = parseFloat(vb.quantity) || 0;
            let vbUsedQty = getLinkedQuantity(record.Type.VENDOR_BILL, vb.vbinternalid);
            let vbRemainingQty = vbTotalQty - vbUsedQty;

            log.debug(`VB ${vb.vbinternalid} - Total: ${vbTotalQty}, Linked: ${vbUsedQty}, Remaining: ${vbRemainingQty}`);

            if (vbRemainingQty <= 0) {
                log.debug(`Skipping VB ${vb.vbinternalid}, fully linked.`);
                continue;
            }

            for (let j = 0; j < itemReceiptarr.length && vbRemainingQty > 0; j++) {
                let ir = itemReceiptarr[j];
                let irTotalQty = parseFloat(ir.quantity) || 0;
                let irUsedQty = getLinkedQuantity(record.Type.ITEM_RECEIPT, ir.internalid);
                let irRemainingQty = irTotalQty - irUsedQty;

                log.debug(`IR ${ir.internalid} - Total: ${irTotalQty}, Linked: ${irUsedQty}, Remaining: ${irRemainingQty}`);

                if (irRemainingQty <= 0) {
                    log.debug(`Skipping IR ${ir.internalid}, fully linked.`);
                    continue;
                }

                if (vb.item === ir.item) {
                    let qtyToLink = Math.min(vbRemainingQty, irRemainingQty);

                    if (qtyToLink > 0) {
                        log.debug(`Linking ${qtyToLink} of Item ${vb.item} between VB ${vb.vbinternalid} and IR ${ir.internalid}`);

                        // Perform the linking (this can be updated to a custom record or sublist for tracking partial link quantities)
                        record.submitFields({
                            type: record.Type.VENDOR_BILL,
                            id: vb.vbinternalid,
                            values: {
                                custbody_ada_created_from: ir.internalid
                            },
                            options: { enableSourcing: false, ignoreMandatoryFields: true }
                        });

                        record.submitFields({
                            type: record.Type.ITEM_RECEIPT,
                            id: ir.internalid,
                            values: {
                                custbody_ada_created_from: vb.vbinternalid
                            },
                            options: { enableSourcing: false, ignoreMandatoryFields: true }
                        });

                        // Update remaining quantity
                        vbRemainingQty -= qtyToLink;
                    }
                }
            }

            enableCheck(vb.vbinternalid); // Enable/disable checkbox after loop
        }
    } catch (error) {
        log.debug("Error in itemComparsion:", error.message);
    }
}
