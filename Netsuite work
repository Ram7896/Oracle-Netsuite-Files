<table class="headerTable" style="width:100%; border-collapse:collapse;">

  <!-- MAIN HEADER -->
  <tr>
    <th style="border:0.5px solid #000; padding:10px; text-align:left;">
      Task
    </th>
    <th colspan="${flagged_names.data?size}"
    align="center"
    style="border:0.5px solid #000; padding:10px;">
  Complete (Y / N)
</th>
  </tr>

  <!-- DOOR DETAILS HEADER -->
  <tr>
    <th style="border:0.5px solid #000; padding:10px; text-align:left;">
      Door Details
    </th>
    <#list flagged_names.data as asset>
      <th style="border:0.5px solid #000; text-align:center;">
        <b>${asset}</b>
      </th>
    </#list>
  </tr>

  <!-- TASK ROWS -->
  <#list taskList as task>
    <tr>
      <td style="border:0.5px solid #000; padding:6px;">
        ${task}
      </td>

      <#list flagged_names.data as asset>
        <td style="border:0.5px solid #000; text-align:center;">
          <!-- Y / N -->
        </td>
      </#list>
    </tr>
  </#list>

</table>
 <div style="height:10px;"></div>
